<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="portal_vendor_dashboard" name="Vendor Portal Dashboard">
    <t t-call="portal.portal_layout">
      <div class="vp-wrap">
      <div class="container">

        <!-- ================= ALERTS ================= -->
        <t t-if="success">
            <div class="alert alert-success alert-dismissible fade show vp-alert mt-3" role="alert">
                <i class="fa fa-check-circle me-2"/>
                <t t-if="success == 'profile_saved'">Profile updated successfully.</t>
                <t t-if="success == 'doc_uploaded'">Document uploaded and submitted for review.</t>
                <t t-if="success == 'submitted'">Your vendor application has been submitted for review.</t>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </t>
        <t t-if="error">
            <div class="alert alert-danger alert-dismissible fade show vp-alert mt-3" role="alert">
                <i class="fa fa-exclamation-circle me-2"/><t t-esc="error"/>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </t>

        <t t-if="vendor">

          <!-- ================= HERO ================= -->
          <div class="vp-hero mt-3">
            <div class="vp-hero-main">
              <div class="vp-avatar"><t t-esc="(vendor.name or 'V')[0].upper()"/></div>
              <div>
                <div class="vp-hero-name"><t t-esc="vendor.name"/></div>
                <div class="vp-hero-tags">
                  <span t-attf-class="vp-pill st-#{vendor.vendor_state}">
                    <t t-if="vendor.vendor_state == 'draft'">Draft</t>
                    <t t-elif="vendor.vendor_state == 'submitted'">Submitted</t>
                    <t t-elif="vendor.vendor_state == 'manager_review'">Under Review</t>
                    <t t-elif="vendor.vendor_state == 'active'">Approved Vendor</t>
                    <t t-elif="vendor.vendor_state == 'blocked'">Blocked</t>
                    <t t-else="">Rejected</t>
                  </span>
                  <span t-attf-class="vp-pill cp-#{vendor.compliance_status or 'pending'}">
                    <i class="fa fa-shield me-1"/>
                    <t t-if="vendor.compliance_status == 'ok'">Compliant</t>
                    <t t-elif="vendor.compliance_status == 'pending'">Compliance Pending</t>
                    <t t-else="">Non-Compliant</t>
                  </span>
                </div>
              </div>
            </div>
            <div class="vp-hero-actions">
              <a href="/my/vendor/request/new" class="vp-btn ghost"><i class="fa fa-plus me-1"/> Request Document</a>
              <t t-if="vendor.vendor_state == 'draft'">
                <form action="/my/vendor" method="POST" class="d-inline">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  <input type="hidden" name="action" value="submit_workflow"/>
                  <button type="submit" class="vp-btn solid"><i class="fa fa-paper-plane me-1"/> Submit for Review</button>
                </form>
              </t>
            </div>
          </div>

          <!-- ================= ONBOARDING STEPPER ================= -->
          <t t-if="vendor.vendor_state in ('draft', 'submitted', 'manager_review', 'active')">
            <t t-set="step_idx" t-value="{'draft': 0, 'submitted': 1, 'manager_review': 2, 'active': 3}[vendor.vendor_state]"/>
            <div class="vp-card vp-stepper-card">
              <div class="vp-stepper">
                <div class="vp-step-line"><div class="vp-step-line-fill" t-attf-style="width: #{step_idx * 33.33}%"/></div>
                <t t-foreach="[('Draft','fa-pencil'), ('Submitted','fa-paper-plane'), ('Manager Review','fa-search'), ('Approved','fa-check')]" t-as="st">
                  <div t-attf-class="vp-step #{'done' if st_index &lt; step_idx else 'current' if st_index == step_idx else ''}">
                    <div class="vp-step-dot">
                      <i t-attf-class="fa #{'fa-check' if st_index &lt; step_idx else st[1]}"/>
                    </div>
                    <span class="vp-step-label"><t t-esc="st[0]"/></span>
                  </div>
                </t>
              </div>
            </div>
          </t>
          <t t-elif="vendor.vendor_state == 'blocked'">
            <div class="alert alert-danger vp-alert mt-3">
              <i class="fa fa-ban me-2"/><b>Your vendor account is currently blocked.</b> Please contact the procurement team for assistance.
            </div>
          </t>

          <!-- ================= KPI STRIP ================= -->
          <div class="vp-kpis">
            <div class="vp-kpi">
              <div class="vp-kpi-ic" style="background:#eef2ff;color:#6366f1"><i class="fa fa-shopping-cart"/></div>
              <div><span class="vp-kpi-lbl">Purchase Orders</span><span class="vp-kpi-val" t-esc="total_purchase_count"/></div>
            </div>
            <div class="vp-kpi">
              <div class="vp-kpi-ic" style="background:#eff6ff;color:#3b82f6"><i class="fa fa-file-text-o"/></div>
              <div><span class="vp-kpi-lbl">Invoices</span><span class="vp-kpi-val" t-esc="total_invoice_count"/></div>
            </div>
            <div class="vp-kpi">
              <div class="vp-kpi-ic" style="background:#ecfdf5;color:#16a34a"><i class="fa fa-check"/></div>
              <div><span class="vp-kpi-lbl">Total Paid</span><span class="vp-kpi-val sm" t-esc="formatted_total_paid"/></div>
            </div>
            <div class="vp-kpi">
              <div class="vp-kpi-ic" style="background:#fef2f2;color:#dc2626"><i class="fa fa-hourglass-half"/></div>
              <div><span class="vp-kpi-lbl">Outstanding</span><span class="vp-kpi-val sm" t-esc="formatted_total_outstanding"/></div>
            </div>
          </div>

          <!-- ================= TABS ================= -->
          <ul class="nav vp-tabs" id="vpTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#vp-docs" type="button" role="tab">
                <i class="fa fa-folder-open-o me-1"/> Documents
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vp-rfqs" type="button" role="tab">
                <i class="fa fa-gavel me-1"/> RFQs &amp; Orders
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vp-bills" type="button" role="tab">
                <i class="fa fa-credit-card me-1"/> Billing
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vp-profile" type="button" role="tab">
                <i class="fa fa-user-o me-1"/> Profile
              </button>
            </li>
          </ul>

          <div class="tab-content vp-tab-content">

            <!-- ============ TAB: DOCUMENTS ============ -->
            <div class="tab-pane fade show active" id="vp-docs" role="tabpanel">
              <t t-set="mandatory_types" t-value="vendor.vendor_category_ids.mapped('mandatory_document_line_ids').filtered(lambda l: l.is_mandatory).mapped('document_type_id')"/>
              <t t-set="approved_docs" t-value="documents.filtered(lambda d: d.state == 'approved' and not d.is_expired)"/>
              <t t-set="mand_total" t-value="len(mandatory_types)"/>
              <t t-set="mand_done" t-value="len(approved_docs.mapped('doc_type_id') &amp; mandatory_types)"/>

              <div class="vp-card">
                <div class="vp-card-head">
                  <h5><i class="fa fa-tasks me-2"/>Compliance Progress</h5>
                  <span class="vp-muted">
                    <t t-if="mand_total"><b t-esc="mand_done"/> of <b t-esc="mand_total"/> mandatory documents approved</t>
                    <t t-else=""><b t-esc="len(approved_docs)"/> of <b t-esc="len(documents)"/> documents approved</t>
                  </span>
                </div>
                <div class="vp-progress">
                  <div class="vp-progress-fill"
                       t-attf-style="width: #{int((mand_done / mand_total) * 100) if mand_total else (int((len(approved_docs) / len(documents)) * 100) if documents else 0)}%"/>
                </div>
              </div>

              <div class="vp-doc-grid">
                <t t-foreach="documents" t-as="doc">
                  <t t-set="is_mand" t-value="doc.doc_type_id in mandatory_types"/>
                  <div t-attf-class="vp-doc doc-#{doc.state}">
                    <div class="vp-doc-top">
                      <div class="vp-doc-ic"><i class="fa fa-file-text-o"/></div>
                      <div class="vp-doc-title">
                        <span class="vp-doc-name"><t t-esc="doc.doc_type_id.name"/>
                          <span t-if="is_mand" class="vp-req" title="Mandatory">*</span>
                        </span>
                        <span class="vp-muted sm" t-if="doc.document_number" t-esc="doc.document_number"/>
                        <span class="vp-muted sm" t-else="">No number yet</span>
                      </div>
                      <span t-attf-class="vp-pill sm ds-#{doc.state if doc.attachment or doc.state != 'draft' else 'missing'}">
                        <t t-if="not doc.attachment and doc.state == 'draft'">Required</t>
                        <t t-elif="doc.state == 'draft'">Draft</t>
                        <t t-elif="doc.state == 'submitted'">In Review</t>
                        <t t-elif="doc.state == 'manager_review'">Manager Review</t>
                        <t t-elif="doc.state == 'md_approval'">Final Approval</t>
                        <t t-elif="doc.state == 'approved'">Approved</t>
                        <t t-elif="doc.state == 'rejected'">Rejected</t>
                        <t t-else="">Expired</t>
                      </span>
                    </div>

                    <div class="vp-doc-meta">
                      <t t-if="doc.expiry_date">
                        <t t-set="days_left" t-value="(doc.expiry_date - datetime.date.today()).days"/>
                        <span t-attf-class="vp-chip #{'red' if days_left &lt; 0 else 'orange' if days_left &lt;= 30 else 'green'}">
                          <i class="fa fa-calendar me-1"/>
                          <t t-if="days_left &lt; 0">Expired <t t-esc="abs(days_left)"/>d ago</t>
                          <t t-elif="days_left == 0">Expires today</t>
                          <t t-else="">Expires in <t t-esc="days_left"/>d</t>
                        </span>
                      </t>
                      <span t-else="" class="vp-chip grey"><i class="fa fa-calendar-o me-1"/>No expiry</span>
                    </div>

                    <div class="vp-doc-actions">
                      <t t-if="not doc.attachment or doc.state in ('rejected', 'expired')">
                        <button type="button" class="vp-btn solid sm w-100" data-bs-toggle="modal" t-attf-data-bs-target="#uploadModal#{doc.id}">
                          <i class="fa fa-cloud-upload me-1"/> Upload
                        </button>
                      </t>
                      <t t-else="">
                        <button type="button" class="vp-btn ghost sm" data-bs-toggle="modal" t-attf-data-bs-target="#uploadModal#{doc.id}">
                          <i class="fa fa-refresh"/> Replace
                        </button>
                        <a t-attf-href="/web/content/vendor.document/#{doc.id}/attachment/#{doc.filename}?download=true" class="vp-btn ghost sm" target="_blank">
                          <i class="fa fa-download"/>
                        </a>
                        <a t-if="doc.state != 'approved'" t-attf-href="/my/vendor/documents/delete/#{doc.id}" class="vp-btn danger sm"
                           onclick="return confirm('Remove this file? The checklist item will remain.')">
                          <i class="fa fa-trash"/>
                        </a>
                      </t>
                    </div>
                  </div>
                </t>
              </div>

              <!-- Upload Modals: rendered OUTSIDE the cards.
                   .vp-doc has a hover transform, and a CSS transform on an
                   ancestor turns it into the containing block for
                   position:fixed children - trapping Bootstrap modals
                   inside the card. Keeping modals out here lets them
                   overlay the full page correctly. -->
              <t t-foreach="documents" t-as="doc">
                <div class="modal fade" t-attf-id="uploadModal#{doc.id}" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content vp-modal">
                      <form action="/my/vendor/documents/upload" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="doc_id" t-att-value="doc.id"/>
                        <div class="modal-header">
                          <h5 class="modal-title"><i class="fa fa-cloud-upload me-2"/>Upload <t t-esc="doc.doc_type_id.name"/></h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          <div class="mb-3">
                            <label class="form-label small fw-bold">Document Number <span class="text-danger">*</span></label>
                            <input type="text" name="document_number" class="form-control" required="1" t-att-value="doc.document_number"
                                   style="text-transform: uppercase;"/>
                          </div>
                          <div class="mb-3">
                            <label class="form-label small fw-bold">Select File <span class="text-danger">*</span></label>
                            <input type="file" name="attachment" class="form-control" required="1" accept=".pdf,.png,.jpg,.jpeg"/>
                            <div class="form-text">PDF or image, clear and readable.</div>
                          </div>
                          <t t-if="doc.requires_expiry_for_vendor">
                            <div class="mb-3">
                              <label class="form-label small fw-bold">Expiry Date <span class="text-danger">*</span></label>
                              <input type="date" name="expiry_date" class="form-control" required="1" t-att-value="doc.expiry_date"/>
                            </div>
                          </t>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="vp-btn ghost sm" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="vp-btn solid sm"><i class="fa fa-check me-1"/> Submit for Review</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              </t>

              <div t-if="not documents" class="vp-empty">
                <i class="fa fa-folder-open-o"/>
                <p>No document checklist yet. It appears once a category is assigned to your account.</p>
              </div>
            </div>

            <!-- ============ TAB: RFQs ============ -->
            <div class="tab-pane fade" id="vp-rfqs" role="tabpanel">
              <div class="vp-card">
                <div class="vp-card-head">
                  <h5><i class="fa fa-gavel me-2"/>Your RFQs &amp; Purchase Orders</h5>
                </div>
                <t t-if="rfqs">
                  <div class="table-responsive">
                    <table class="table vp-table mb-0">
                      <thead>
                        <tr><th>Reference</th><th>Date</th><th>Status</th><th>Your Quote</th><th class="text-end">Quoted Total</th><th></th></tr>
                      </thead>
                      <tbody>
                        <t t-foreach="rfqs" t-as="rfq">
                          <t t-set="quote" t-value="rfq.quote_ids.filtered(lambda q: q.vendor_id == vendor)[:1]"/>
                          <t t-set="needs_action" t-value="not rfq.is_rfq_expired and rfq.state in ('draft', 'sent') and (not quote or quote.state == 'draft')"/>
                          <tr t-att-onclick="'window.location=\'/my/vendor/rfq/%s\'' % rfq.id">
                            <td class="fw-bold"><t t-esc="rfq.name"/></td>
                            <td><t t-esc="rfq.date_order" t-options='{"widget": "date"}'/></td>
                            <td>
                              <span t-attf-class="vp-pill sm #{'ds-approved' if rfq.state == 'purchase' else 'ds-submitted'}">
                                <t t-esc="dict(rfq._fields['state'].selection).get(rfq.state)"/>
                              </span>
                            </td>
                            <td>
                              <t t-if="rfq.is_rfq_expired"><span class="vp-pill sm ds-expired">Expired</span></t>
                              <t t-elif="needs_action"><span class="vp-pill sm pulse">Action Needed</span></t>
                              <t t-elif="quote">
                                <span t-attf-class="vp-pill sm #{'ds-approved' if quote.state == 'selected' else 'ds-rejected' if quote.state == 'rejected' else 'ds-submitted'}">
                                  <t t-esc="dict(quote._fields['state'].selection).get(quote.state)"/>
                                </span>
                              </t>
                              <t t-else=""><span class="vp-pill sm ds-missing">No Quote</span></t>
                            </td>
                            <td class="text-end fw-bold">
                              <t t-if="quote"><t t-esc="quote.total_amount" t-options='{"widget": "monetary", "display_currency": rfq.currency_id}'/></t>
                              <t t-else="">—</t>
                            </td>
                            <td class="text-end"><i class="fa fa-chevron-right vp-muted"/></td>
                          </tr>
                        </t>
                      </tbody>
                    </table>
                  </div>
                </t>
                <div t-else="" class="vp-empty"><i class="fa fa-inbox"/><p>No RFQs or orders yet.</p></div>
              </div>
            </div>

            <!-- ============ TAB: BILLING ============ -->
            <div class="tab-pane fade" id="vp-bills" role="tabpanel">
              <div class="vp-card">
                <div class="vp-card-head"><h5><i class="fa fa-credit-card me-2"/>Bills &amp; Payments</h5></div>
                <t t-if="bills">
                  <div class="table-responsive">
                    <table class="table vp-table mb-0">
                      <thead>
                        <tr><th>Bill</th><th>Date</th><th class="text-end">Amount</th><th style="width: 30%;">Payment</th><th></th></tr>
                      </thead>
                      <tbody>
                        <t t-foreach="bills" t-as="bill">
                          <t t-set="paid_amount" t-value="bill.amount_total - bill.amount_residual"/>
                          <t t-set="paid_pct" t-value="int((paid_amount / bill.amount_total) * 100) if bill.amount_total else 0"/>
                          <tr>
                            <td class="fw-bold"><t t-esc="bill.name"/></td>
                            <td><t t-esc="bill.invoice_date" t-options='{"widget": "date"}'/></td>
                            <td class="text-end fw-bold"><t t-esc="bill.amount_total" t-options='{"widget": "monetary", "display_currency": bill.currency_id}'/></td>
                            <td>
                              <div class="d-flex align-items-center gap-2">
                                <div class="vp-progress thin flex-grow-1">
                                  <div t-attf-class="vp-progress-fill #{'ok' if paid_pct >= 100 else 'part' if paid_pct > 0 else 'none'}" t-attf-style="width: #{paid_pct}%"/>
                                </div>
                                <span class="vp-muted sm text-nowrap"><t t-esc="paid_pct"/>%</span>
                              </div>
                              <span class="vp-muted sm">
                                Paid <t t-esc="paid_amount" t-options='{"widget": "monetary", "display_currency": bill.currency_id}'/>
                                <t t-if="bill.amount_residual"> · Due <t t-esc="bill.amount_residual" t-options='{"widget": "monetary", "display_currency": bill.currency_id}'/></t>
                              </span>
                            </td>
                            <td class="text-end">
                              <a t-attf-href="/my/invoices/#{bill.id}?report_type=pdf&amp;download=true" class="vp-btn ghost sm" target="_blank">
                                <i class="fa fa-download"/> PDF
                              </a>
                            </td>
                          </tr>
                        </t>
                      </tbody>
                    </table>
                  </div>
                </t>
                <div t-else="" class="vp-empty"><i class="fa fa-file-o"/><p>No bills found.</p></div>
              </div>
            </div>

            <!-- ============ TAB: PROFILE ============ -->
            <div class="tab-pane fade" id="vp-profile" role="tabpanel">
              <div class="vp-card">
                <div class="vp-card-head"><h5><i class="fa fa-user-o me-2"/>Company Profile</h5>
                  <span class="vp-muted">Keep your details up to date — they appear on POs and bills.</span>
                </div>
                <form action="/my/vendor" method="POST">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  <input type="hidden" name="action" value="save_profile"/>
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="vp-lbl"><t t-if="vendor.is_company">Company Name</t><t t-else="">Full Name</t> <span class="text-danger">*</span></label>
                      <input type="text" name="name" t-att-value="vendor.name" class="form-control" required="1"/>
                    </div>
                    <div class="col-md-6">
                      <label class="vp-lbl">Job Position</label>
                      <input type="text" name="function" t-att-value="vendor.function" class="form-control"/>
                    </div>
                    <div class="col-md-6">
                      <label class="vp-lbl">Email</label>
                      <input type="email" name="email" t-att-value="vendor.email" class="form-control"/>
                    </div>
                    <div class="col-md-6">
                      <label class="vp-lbl">Website</label>
                      <input type="text" name="website" t-att-value="vendor.website" class="form-control" placeholder="https://"/>
                    </div>
                    <div class="col-md-6">
                      <label class="vp-lbl">GSTIN / Tax ID</label>
                      <input type="text" name="vat" t-att-value="vendor.vat" class="form-control"/>
                    </div>
                    <t t-if="'l10n_in_pan' in vendor._fields">
                      <div class="col-md-6">
                        <label class="vp-lbl">PAN</label>
                        <input type="text" name="l10n_in_pan" t-att-value="vendor.l10n_in_pan" class="form-control"/>
                      </div>
                    </t>
                    <div class="col-md-6">
                      <label class="vp-lbl">Phone</label>
                      <input type="text" name="phone" t-att-value="vendor.phone" class="form-control"/>
                    </div>
                    <t t-if="'mobile' in vendor._fields">
                      <div class="col-md-6">
                        <label class="vp-lbl">Mobile</label>
                        <input type="text" name="mobile" t-att-value="vendor.mobile" class="form-control"/>
                      </div>
                    </t>
                    <div class="col-12">
                      <label class="vp-lbl">Street</label>
                      <input type="text" name="street" t-att-value="vendor.street" class="form-control"/>
                    </div>
                    <div class="col-md-4">
                      <label class="vp-lbl">City</label>
                      <input type="text" name="city" t-att-value="vendor.city" class="form-control"/>
                    </div>
                    <div class="col-md-2">
                      <label class="vp-lbl">ZIP</label>
                      <input type="text" name="zip" t-att-value="vendor.zip" class="form-control"/>
                    </div>
                    <div class="col-md-3">
                      <label class="vp-lbl">State</label>
                      <select name="state_id" class="form-select">
                        <option value="">Select State</option>
                        <t t-foreach="request.env['res.country.state'].sudo().search([])" t-as="state_option">
                          <option t-att-value="state_option.id" t-att-selected="vendor.state_id and vendor.state_id.id == state_option.id">
                            <t t-esc="state_option.name"/>
                          </option>
                        </t>
                      </select>
                    </div>
                    <div class="col-md-3">
                      <label class="vp-lbl">Country</label>
                      <select name="country_id" class="form-select">
                        <option value="">Select Country</option>
                        <t t-foreach="request.env['res.country'].sudo().search([])" t-as="country_option">
                          <option t-att-value="country_option.id" t-att-selected="vendor.country_id and vendor.country_id.id == country_option.id">
                            <t t-esc="country_option.name"/>
                          </option>
                        </t>
                      </select>
                    </div>
                  </div>
                  <div class="mt-4 text-end">
                    <button type="submit" class="vp-btn solid"><i class="fa fa-save me-1"/> Save Profile</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </t>

        <t t-else="">
          <div class="alert alert-warning shadow-sm border-0 d-flex align-items-center mt-4">
            <i class="fa fa-exclamation-triangle fa-2x me-3" title="Warning Icon"/>
            <div>
              <h4 class="alert-heading mb-1">Account Notice</h4>
              <p class="mb-0">No vendor record is currently linked to your portal account. Please contact support if you believe this is an error.</p>
            </div>
          </div>
        </t>

      </div>
      </div>
    </t>
  </template>

  <template id="portal_vendor_rfq_edit" name="Edit RFQ Quotation">
    <t t-call="portal.portal_layout">
      <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2>Quotation for <t t-esc="order.name"/></h2>
          <a href="/my/vendor" class="btn btn-outline-secondary">Back to Dashboard</a>
        </div>

        <t t-if="success">
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            Your quotation has been submitted successfully.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        </t>

        <!-- Quote Status Alert -->
        <t t-if="quote and quote.state != 'draft'">
          <div t-attf-class="alert #{'alert-success' if quote.state == 'selected' else 'alert-danger' if quote.state == 'rejected' else 'alert-info'} mb-3">
            <strong>Status:</strong> 
            <t t-if="quote.state == 'submitted'">Your quotation has been submitted and is under review.</t>
            <t t-if="quote.state == 'selected'">Congratulations! Your quotation has been selected.</t>
            <t t-if="quote.state == 'rejected'">Your quotation was not selected.</t>
            <t t-if="quote.state in ['submitted', 'selected', 'rejected'] and not can_edit_quote"><br/><em>This form is now locked and cannot be edited.</em></t>
          </div>
        </t>
        
        <!-- RFQ Revision Warning -->
        <t t-if="quote and quote.state != 'draft' and quote.submitted_revision &lt; order.rfq_revision">
          <div class="alert alert-warning mb-3 border-warning shadow-sm">
            <i class="fa fa-exclamation-triangle me-2" title="Revision Warning"/>
            <strong>This RFQ has been updated after your last submission.</strong> Please review the changes and resubmit your quotation.
          </div>
        </t>
        
        <!-- RFQ Expired Alert -->
        <t t-if="order.is_rfq_expired">
          <div class="alert alert-danger mb-3">
            <strong>RFQ Expired:</strong> This RFQ has expired. You can no longer submit or modify quotations.
          </div>
        </t>

        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body">
            <div class="row mb-3">
              <div class="col-md-6">
                <p><strong>Date:</strong> <t t-esc="order.date_order" t-options='{"widget": "date"}'/></p>
                <!-- FIX: Use current user's partner name, not order.partner_id -->
                <p><strong>Your Company:</strong> <t t-esc="request.env.user.partner_id.name"/></p>
              </div>
              <div class="col-md-6 text-md-end">
                <p><strong>RFQ Status:</strong> <span class="badge bg-info text-uppercase"><t t-esc="order.state"/></span></p>
              </div>
            </div>

            <form action="" method="POST">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <div class="table-responsive">
                <table class="table">
                  <thead>
                    <tr class="text-muted small text-uppercase">
                      <th>Product</th>
                      <th class="text-end">Requested Qty</th>
                      <th class="text-end">Internal Unit Price</th>
                      <th class="text-end">Vendor Price</th>
                      <th class="text-end">Delivery Date</th>
                      <th class="text-end">Bulk Qty</th>
                      <th class="text-end">Bulk Price</th>
                      <th class="text-end">Notes</th>
                    </tr>
                  </thead>
                  <tbody>
                    <t t-if="quote">
                      <t t-foreach="order.order_line" t-as="line">
                        <t t-set="quote_line" t-value="quote.line_ids.filtered(lambda ql: ql.po_line_id == line)"/>
                        <tr>
                          <td class="align-middle">
                            <t t-esc="line.product_id.display_name"/>
                          </td>
                          <td class="text-end align-middle">
                            <span class="fw-bold" t-esc="line.product_qty"/>
                            <span class="small text-muted" t-esc="line.product_uom_id.name"/>
                          </td>
                          <td class="text-end align-middle">
                            <span class="text-muted" t-esc="line.price_unit" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                          </td>
                          <td class="text-end align-middle">
                            <input type="number" step="0.01" t-att-name="'vendor_price_%s' % line.id" 
                                   t-att-value="quote_line and quote_line.vendor_price or 0.0" class="form-control form-control-sm text-end" required="1"
                                   t-att-readonly="not can_edit_quote and 'readonly' or None"/>
                          </td>
                          <td class="text-end align-middle">
                            <input type="date" t-att-name="'delivery_%s' % line.id" 
                                   t-att-value="quote_line and quote_line.delivery_date" class="form-control form-control-sm"
                                   t-att-readonly="not can_edit_quote and 'readonly' or None"/>
                          </td>
                          <td class="text-end align-middle">
                            <input type="number" step="0.01" t-att-name="'bulk_qty_%s' % line.id" 
                                   t-att-value="quote_line and quote_line.bulk_qty or 0.0" class="form-control form-control-sm text-end"
                                   t-att-readonly="not can_edit_quote and 'readonly' or None"/>
                          </td>
                          <td class="text-end align-middle">
                            <input type="number" step="0.01" t-att-name="'bulk_price_%s' % line.id" 
                                   t-att-value="quote_line and quote_line.bulk_price or 0.0" class="form-control form-control-sm text-end"
                                   t-att-readonly="not can_edit_quote and 'readonly' or None"/>
                          </td>
                          <td class="text-end align-middle">
                             <input type="text" t-att-name="'note_%s' % line.id" 
                                    t-att-value="quote_line and quote_line.vendor_notes" class="form-control form-control-sm"
                                    t-att-readonly="not can_edit_quote and 'readonly' or None"/>
                          </td>
                        </tr>
                      </t>
                    </t>
                  </tbody>
                  <tfoot>
                    <tr>
                      <td colspan="6" class="text-end fw-bold">Total Amount</td>
                      <td class="text-end fw-bold">
                        <t t-if="quote">
                          <span t-field="quote.total_amount" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                        </t>
                        <t t-else="">-</t>
                      </td>
                    </tr>
                  </tfoot>
                </table>
              </div>
              
              <div class="mt-3">
                <label class="form-label">General Notes / Terms</label>
                <textarea name="note" class="form-control" rows="3" 
                          t-att-readonly="not can_edit_quote and 'readonly' or None"><t t-if="quote" t-esc="quote.note"/></textarea>
              </div>
              
              <div class="d-flex justify-content-end gap-2">
                <!-- Hide submit if RFQ expired or quote already submitted and NOT revised -->
                <t t-if="can_edit_quote">
                  <button type="submit" class="btn btn-primary">
                    <t t-if="quote and quote.state != 'draft'">Resubmit Quotation</t>
                    <t t-else="">Submit Quotation</t>
                  </button>
                </t>
              </div>
            </form>
          </div>
        </div>
      </div>
    </t>
  </template>

</odoo>
