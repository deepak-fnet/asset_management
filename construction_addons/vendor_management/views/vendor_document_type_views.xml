<odoo>
    <record id="view_vendor_document_type_form" model="ir.ui.view">
        <field name="name">vendor.document.type.form</field>
        <field name="model">vendor.document.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="validation_regex"/>
                        <field name="is_critical"/>
                        <field name="category"/>
                        <field name="validity_days"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">vendor.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
