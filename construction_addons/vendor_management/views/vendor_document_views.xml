<odoo>
    <record id="view_vendor_document_list" model="ir.ui.view">
        <field name="name">vendor.document.list</field>
        <field name="model">vendor.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_expired" decoration-warning="is_expiring_soon" decoration-success="state == 'approved'">
                <field name="vendor_id"/>
                <field name="doc_type_id"/>
                <field name="document_number"/>
                <field name="expiry_date"/>
                <field name="is_expired" column_invisible="True"/>
                <field name="is_expiring_soon" column_invisible="True"/>
                <field name="state" widget="badge" decoration-info="state in ('submitted', 'manager_review', 'md_approval')" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state == 'draft'" decoration-warning="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_document_kanban" model="ir.ui.view">
        <field name="name">vendor.document.kanban</field>
        <field name="model">vendor.document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="vendor_id"/>
                <field name="doc_type_id"/>
                <field name="expiry_date"/>
                <field name="state"/>
                <field name="is_expired"/>
                <field name="is_expiring_soon"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="row">
                                <div class="col-3 text-center">
                                    <i class="fa fa-file-text-o fa-3x text-primary mt-2" title="Document Icon"/>
                                </div>
                                <div class="col-9">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title" style="font-size: 1.1rem;">
                                                <t t-esc="record.doc_type_id.value"/>
                                            </strong>
                                            <div class="text-muted"><t t-esc="record.vendor_id.value"/></div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body mt-2">
                                        <div t-if="record.expiry_date.raw_value" t-attf-class="#{record.is_expired.raw_value ? 'text-danger fw-bold' : (record.is_expiring_soon.raw_value ? 'text-warning fw-bold' : 'text-muted')}">
                                            Expires: <t t-esc="record.expiry_date.value"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom mt-2">
                                        <div class="oe_kanban_bottom_right">
                                            <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'submitted': 'info', 'approved': 'success', 'rejected': 'danger'}}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_vendor_document_form" model="ir.ui.view">
        <field name="name">vendor.document.form</field>
        <field name="model">vendor.document</field>
        <field name="arch" type="xml">
            <form string="Vendor Document">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'" groups="vendor_management.group_vendor_user"/>
                    <button name="action_manager_review" type="object" string="Manager Review" class="btn-primary" invisible="state != 'submitted'" groups="vendor_management.group_vendor_manager"/>
                    <button name="action_md_approval" type="object" string="Send for MD Approval" class="btn-primary" invisible="state != 'manager_review'" groups="vendor_management.group_vendor_manager"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-success" invisible="state != 'md_approval'" groups="vendor_management.group_vendor_md"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="state not in ('submitted', 'manager_review', 'md_approval')" groups="vendor_management.group_vendor_manager,vendor_management.group_vendor_md"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,manager_review,md_approval,approved"/>
                </header>
                <sheet>
                    <div class="vendor_section_card">
                        <div class="vendor_section_title">
                            <i class="fa fa-file-pdf-o" title="Document Details Icon"/> Document Details
                        </div>
                        <group>
                            <group>
                                <field name="vendor_id" options="{'no_create': True}"/>
                                <field name="doc_type_id"/>
                                <field name="document_number" required="state != 'draft'"/>
                            </group>
                            <group>
                                <!-- Feature 4: Conditional expiry date based on category configuration -->
                                <field name="expiry_date" 
                                       invisible="not requires_expiry_for_vendor"
                                       required="requires_expiry_for_vendor"/>
                                <field name="attachment" filename="filename"/>
                                <field name="is_expired" readonly="1"/>
                            </group>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vendor_document_management_form" model="ir.ui.view">
        <field name="name">res.partner.vendor.document.management.form</field>
        <field name="model">res.partner</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <form string="Vendor Document Management">
                <header>
                    <field name="vendor_state" widget="statusbar" statusbar_visible="draft,submitted,manager_review,active"/>
                    
                    <button name="action_submit_for_review" type="object" string="Submit" class="btn-primary" 
                            invisible="vendor_state != 'draft'" groups="vendor_management.group_vendor_user"/>
                    
                    <button name="action_mark_reviewed" type="object" string="Manager Approve" class="btn-success" 
                            invisible="vendor_state != 'submitted'" groups="vendor_management.group_vendor_manager"/>
                    
                    <button name="action_approve_activate" type="object" string="Final Approve" class="btn-success" 
                            invisible="vendor_state != 'manager_review'" groups="vendor_management.group_vendor_md"/>

                    <button name="action_reject" type="object" string="Reject" class="btn-danger" 
                            invisible="vendor_state not in ('submitted', 'manager_review')" groups="vendor_management.group_vendor_user"/>
                    
                    <button name="action_block_vendor" type="object" string="Block Vendor" class="btn-danger" 
                            invisible="vendor_state != 'active'" groups="vendor_management.group_vendor_md"/>
                    
                    <button name="action_unblock_vendor" type="object" string="Unblock Vendor" class="btn-success" 
                            invisible="vendor_state != 'blocked'" groups="vendor_management.group_vendor_md"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Vendor Name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <group string="Compliance Overview">
                                <field name="compliance_status" widget="badge" decoration-success="compliance_status == 'ok'" decoration-warning="compliance_status == 'pending'" decoration-danger="compliance_status == 'expired'"/>
                                <field name="risk_score" widget="progressbar"/>
                            </group>
                        </div>
                        <div class="col-md-6">
                            <group string="Vendor Details">
                                <field name="vendor_category_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="1"/>
                                <field name="email" widget="email" readonly="1"/>
                            </group>
                        </div>
                    </div>
                    <notebook>
                        <page name="documents" string="Required Documents">
                            <div class="o_vendor_doc_header p-2 bg-light border-bottom mb-3">
                                <span class="fw-bold"><i class="fa fa-upload me-2" title="Upload Icon"/> Upload and manage vendor documents below</span>
                            </div>
                            <field name="document_ids" context="{'default_vendor_id': id}">
                                <list editable="bottom" decoration-danger="is_expired" decoration-success="state == 'approved'">
                                    <field name="doc_type_id"/>
                                    <field name="document_number" required="state != 'draft'"/>
                                    <field name="expiry_date" 
                                           invisible="not requires_expiry_for_vendor"
                                           optional="hide"/>
                                    <field name="attachment" widget="binary" filename="filename"/>
                                    <field name="filename" column_invisible="True"/>
                                    <field name="state" widget="badge" decoration-info="state in ('submitted', 'manager_review', 'md_approval')" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state == 'draft'" decoration-warning="state == 'expired'"/>
                                    <field name="is_expired" column_invisible="True"/>
                                    <button name="action_submit" type="object" icon="fa-paper-plane" title="Submit" invisible="state != 'draft'" groups="vendor_management.group_vendor_user"/>
                                    <button name="action_manager_review" type="object" icon="fa-search" title="Manager Review" invisible="state != 'submitted'" groups="vendor_management.group_vendor_manager"/>
                                    <button name="action_md_approval" type="object" icon="fa-send-o" title="MD Approval" invisible="state != 'manager_review'" groups="vendor_management.group_vendor_manager"/>
                                    <button name="action_approve" type="object" icon="fa-check" title="Approve" invisible="state != 'md_approval'" groups="vendor_management.group_vendor_md"/>
                                    <button name="action_reject" type="object" icon="fa-times" title="Reject" invisible="state not in ('submitted', 'manager_review', 'md_approval')" groups="vendor_management.group_vendor_manager,vendor_management.group_vendor_md"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vendor_document_kanban_vendor_centric" model="ir.ui.view">
        <field name="name">res.partner.vendor.document.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false" action="action_open_document_management" type="object">
                <field name="name"/>
                <field name="document_ids"/>
                <field name="compliance_status"/>
                <field name="vendor_category_ids"/>
                <field name="doc_count_total"/>
                <field name="doc_count_approved"/>
                <field name="doc_count_pending"/>
                <field name="doc_count_expired"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card d-flex flex-column">
                            <div class="o_kanban_record_top d-flex align-items-center mb-2">
                                <div class="o_kanban_record_headings flex-grow-1">
                                    <strong class="o_kanban_record_title" style="font-size: 1.15rem;">
                                        <i class="fa fa-university text-primary me-2" title="Vendor"/>
                                        <t t-esc="record.name.value"/>
                                    </strong>
                                    <div class="text-muted small">
                                        <field name="vendor_category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    </div>
                                </div>
                                <field name="compliance_status" widget="label_selection" options="{'classes': {'ok': 'success', 'pending': 'warning'}}"/>
                            </div>
                            
                            <div class="o_kanban_record_body border-top pt-2 mt-auto">
                                <div t-if="record.doc_count_total.raw_value > 0">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted small"><i class="fa fa-check-circle text-success me-1" title="Approved Icon"/> Approved</span>
                                        <span class="fw-bold small"><t t-esc="record.doc_count_approved.value"/></span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted small"><i class="fa fa-clock-o text-warning me-1" title="Pending Icon"/> Pending Review</span>
                                        <span class="fw-bold small"><t t-esc="record.doc_count_pending.value"/></span>
                                    </div>
                                    <div t-if="record.doc_count_expired.raw_value > 0" class="d-flex justify-content-between mb-1">
                                        <span class="text-danger small"><i class="fa fa-exclamation-triangle me-1" title="Expired Icon"/> Expired</span>
                                        <span class="text-danger fw-bold small"><t t-esc="record.doc_count_expired.value"/></span>
                                    </div>
                                </div>
                                <div t-else="" class="text-danger small italic">
                                    <i class="fa fa-exclamation-triangle me-1" title="Warning"/> No documents uploaded
                                </div>
                            </div>
                            
                            <div class="o_kanban_record_bottom mt-2 d-flex justify-content-between align-items-center">
                                <div class="oe_kanban_bottom_left">
                                    <span t-attf-class="badge rounded-pill #{record.doc_count_total.raw_value > 0 ? 'bg-info' : 'bg-secondary text-white'}">
                                        <i class="fa fa-paperclip me-1" title="Files"/>
                                        <t t-esc="record.doc_count_total.value"/> Files
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                     <button class="btn btn-sm btn-link p-0 text-primary">
                                        <i class="fa fa-arrow-right" title="Manage Documents"/> Manage
                                     </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Optional: specific list view for this action to keep it vendor-centric -->
    <record id="view_vendor_document_list_vendor_centric" model="ir.ui.view">
        <field name="name">res.partner.vendor.document.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Vendor Documents Status">
                <field name="name" string="Vendor"/>
                <field name="vendor_category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="compliance_status" widget="badge" decoration-success="compliance_status == 'ok'" decoration-warning="compliance_status == 'pending'" decoration-danger="compliance_status == 'expired'"/>
                <field name="doc_count_approved" string="Approved"/>
                <field name="doc_count_pending" string="Pending"/>
                <field name="doc_count_expired" string="Expired" decoration-danger="doc_count_expired > 0"/>
            </list>
        </field>
    </record>

    <record id="action_vendor_documents" model="ir.actions.act_window">
        <field name="name">Vendor Documents</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_vendor', '=', True)]</field>
        <field name="context">{'default_is_vendor': True}</field>
        <field name="view_ids" eval="[(5, 0, 0), 
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_vendor_document_kanban_vendor_centric')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_vendor_document_list_vendor_centric')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_partner_form_vendor_enterprise')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage your vendor documents
            </p>
        </field>
    </record>

</odoo>
