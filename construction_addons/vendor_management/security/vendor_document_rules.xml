<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Portal User: ONLY own vendor's documents -->
        <record id="rule_portal_vendor_document" model="ir.rule">
            <field name="name">Portal Vendor: Own Documents</field>
            <field name="model_id" ref="vendor_management.model_vendor_document"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('vendor_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Internal Users: All documents -->
        <record id="rule_internal_vendor_document" model="ir.rule">
            <field name="name">Internal Users: All Documents</field>
            <field name="model_id" ref="vendor_management.model_vendor_document"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Vendor Manager: Full Access to All Documents -->
        <record id="vendor_document_manager_full_access_rule" model="ir.rule">
            <field name="name">Vendor Document Manager Full Access</field>
            <field name="model_id" ref="vendor_management.model_vendor_document"/>
            <field name="groups" eval="[(4, ref('vendor_management.group_vendor_manager'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
