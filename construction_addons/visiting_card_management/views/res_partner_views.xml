<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_visiting_card" model="ir.ui.view">
        <field name="name">res.partner.form.visiting.card</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_visiting_cards" type="object" class="oe_stat_button" icon="fa-id-card"
                        invisible="not visiting_card_count">
                    <field name="visiting_card_count" widget="statinfo" string="Visiting Cards"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
