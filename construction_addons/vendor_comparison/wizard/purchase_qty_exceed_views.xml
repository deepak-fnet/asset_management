<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_purchase_qty_exceed_wizard" model="ir.ui.view">
    <field name="name">purchase.qty.exceed.form</field>
    <field name="model">purchase.qty.exceed</field>
    <field name="arch" type="xml">
        <form string="Product Quantity Summary">
            <sheet>
                <div style="text-align: center;">
                    <h3 style="color: #017e84; font-weight: bold;">
                        📋 Product Quantity Summary
                    </h3>
                </div>
                <separator/>
                <group>
                    <field name="message"
                           widget="html"
                           readonly="1"
                           nolabel="1"/>
                </group>
            </sheet>
            <footer>
                <button name="action_confirm"
                        string="Yes Continue"
                        type="object"
                        class="btn-primary"/>
                <button name="action_cancel"
                        string="No Cancel"
                        type="object"
                        class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>

    <!-- Action -->
    <record id="action_purchase_qty_exceed_wizard" model="ir.actions.act_window">
        <field name="name">Quantity Exceeded</field>
        <field name="res_model">purchase.qty.exceed</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>