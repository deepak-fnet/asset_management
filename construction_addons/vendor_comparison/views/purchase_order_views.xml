<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="purchase_order_form_inh_extended">
        <field name="name">purchase.order.form.inh</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="vendor_comparison_id" invisible="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button class="oe_stat_button" type="object" invisible="not vendor_comparison_id"
                        name="action_view_vendor_comparison" icon="fa-balance-scale">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Vendor Comparison</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">vendor_comparison_id or state in ['purchase','partial_po','cancel']
                </attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="readonly">parent.vendor_comparison_id or state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_qty']" position="before">
                <field name="remaining_qty" column_invisible="1" readonly="1"/>

            </xpath>
        </field>

    </record>
</odoo>