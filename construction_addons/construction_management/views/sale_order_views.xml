<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_construction" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.construction</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="validity_date" position="after">
                <field name="retention_percent"/>
                <field name="dlp_months"/>
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_costing" type="object" class="oe_stat_button"
                        icon="fa-calculator" invisible="not costing_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Sale Costing</span>
                    </div>
                </button>
                <button name="action_view_purchase_orders" type="object" class="oe_stat_button"
                        icon="fa-shopping-cart" invisible="not purchase_order_count"
                        groups="purchase.group_purchase_user">
                    <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                </button>
                <button name="action_view_master_project" type="object" class="oe_stat_button"
                        icon="fa-building" invisible="not master_project_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Project</span>
                    </div>
                </button>
                <button name="action_view_flowchart" type="object" class="oe_stat_button"
                        icon="fa-sitemap" invisible="not master_project_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Flow Chart</span>
                    </div>
                </button>
                <button name="action_view_stage_pnl" type="object" class="oe_stat_button"
                        icon="fa-balance-scale" invisible="not master_project_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">P&amp;L by Stage</span>
                    </div>
                </button>
                <button name="action_view_milestone_bills" type="object" class="oe_stat_button"
                        icon="fa-money" invisible="not milestone_bill_count">
                    <field name="milestone_bill_count" widget="statinfo" string="Milestone Bills"/>
                </button>
                <button name="action_view_variation_orders" type="object" class="oe_stat_button"
                        icon="fa-exchange" invisible="not variation_order_count">
                    <field name="variation_order_count" widget="statinfo" string="Variation Orders"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="construction_project_info" string="Project Info" invisible="not master_project_id">
                    <group>
                        <group>
                            <field name="master_project_id" readonly="1"/>
                            <field name="master_project_state" readonly="1"/>
                            <field name="master_project_start_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="advance_received"/>
                            <field name="overall_completion" widget="progressbar"/>
                        </group>
                    </group>
                    <group string="Budget vs Actuals">
                        <group>
                            <field name="budget_amount"/>
                            <field name="purchased_amount"/>
                            <field name="billed_amount"/>
                        </group>
                        <group>
                            <field name="pending_bill_amount"/>
                            <field name="labour_wage_total"/>
                            <field name="profit_amount"/>
                        </group>
                    </group>
                    <field name="subproject_ids" readonly="1">
                        <list>
                            <field name="project_no"/>
                            <field name="name"/>
                            <field name="floors"/>
                            <field name="cm_budget" sum="Total Budget"/>
                            <field name="cm_status"/>
                            <field name="completion_percent" widget="progressbar"/>
                        </list>
                    </field>
                </page>
                <page name="construction_milestone_billing" string="Milestone Billing" invisible="state != 'sale'">
                    <field name="milestone_bill_ids" context="{'default_sale_order_id': id}">
                        <list editable="bottom" decoration-muted="state == 'invoiced'">
                            <field name="sale_order_id" column_invisible="1"/>
                            <field name="name"/>
                            <field name="milestone_type"/>
                            <field name="amount_type"/>
                            <field name="percentage"/>
                            <field name="manual_amount"/>
                            <field name="amount" sum="Total"/>
                            <field name="release_date"/>
                            <field name="state" widget="badge"
                                   decoration-warning="state == 'to_invoice'"
                                   decoration-success="state == 'invoiced'"/>
                            <field name="invoice_id" readonly="1"/>
                            <button name="action_create_invoice" type="object" string="Create Invoice"
                                    class="btn-link" invisible="state == 'invoiced'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
