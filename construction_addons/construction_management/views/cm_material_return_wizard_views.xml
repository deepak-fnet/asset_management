<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cm_material_return_wizard_form" model="ir.ui.view">
        <field name="name">cm.material.return.wizard.form</field>
        <field name="model">cm.material.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Excess Material">
                <field name="stage_id" invisible="1"/>
                <p class="text-muted">
                    Suggested quantity is Issued minus what Measurement has certified as actually
                    used on site - adjust or zero out any line before confirming the return.
                </p>
                <field name="line_ids">
                    <list editable="bottom" create="0">
                        <field name="boq_line_id" column_invisible="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="uom_id" readonly="1"/>
                        <field name="returnable_qty" readonly="1"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_return" type="object" string="Return to Store" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
