<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_construction" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.construction</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="stage_id"/>
            </field>
            <field name="move_ids" position="before">
                <field name="is_material_issue" invisible="1"/>
                <field name="is_material_return" invisible="1"/>
            </field>
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity']" position="after">
                <field name="issue_amount" column_invisible="not (parent.is_material_issue or parent.is_material_return)"
                       readonly="parent.state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
