<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_construction" model="ir.ui.view">
        <field name="name">account.move.form.inherit.construction</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_vendor_bill_id" position="after">
                <field name="project_id" invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
                       options="{'no_create': True}"/>
                <field name="stage_id" invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
                       domain="[('project_id', '=', project_id)] if project_id else []"
                       options="{'no_create': True}"
                       help="Tag this bill to a construction stage so it counts towards that stage's Billed Amount / Payments, even when it wasn't raised from a stage-linked Purchase Order (e.g. billing for stock you already had)."/>
            </field>
        </field>
    </record>
</odoo>
