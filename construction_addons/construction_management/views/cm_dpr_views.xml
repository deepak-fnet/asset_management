<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cm_dpr_form" model="ir.ui.view">
        <field name="name">cm.dpr.form</field>
        <field name="model">cm.dpr</field>
        <field name="arch" type="xml">
            <form string="Daily Progress Report">
                <header>
                    <button name="action_submit" type="object" string="Submit for Verification"
                            class="oe_highlight" invisible="approval_state != 'draft'"/>
                    <button name="action_verify" type="object" string="Verify"
                            class="oe_highlight" invisible="approval_state != 'submitted'"
                            groups="construction_management.group_cm_manager"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="approval_state != 'verified'"
                            groups="construction_management.group_cm_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="approval_state not in ('submitted', 'verified')"
                            groups="construction_management.group_cm_manager"
                            confirm="Reject this DPR? Make sure you have entered the Rejection Reason."/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="approval_state in ('draft', 'approved')"/>
                    <field name="approval_state" widget="statusbar"
                           statusbar_visible="draft,submitted,verified,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="approval_state != 'rejected'">
                        This DPR was rejected. See Rejection Reason below.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="project_id" placeholder="Project"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="stage_id"/>
                            <field name="date"/>
                            <field name="weather"/>
                            <field name="reported_by"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_labour_present" readonly="1"/>
                            <field name="labour_wage_total" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="narrative" placeholder="Work carried out today..."/>
                        <field name="material_consumed"/>
                        <field name="equipment_used"/>
                    </group>
                    <group string="Approval Trail" invisible="approval_state in ('draft', 'submitted')">
                        <group>
                            <field name="verified_by" readonly="1" invisible="not verified_by"/>
                            <field name="verified_date" readonly="1" invisible="not verified_date"/>
                        </group>
                        <group>
                            <field name="approved_by" readonly="1" invisible="not approved_by"/>
                            <field name="approved_date" readonly="1" invisible="not approved_date"/>
                        </group>
                    </group>
                    <group string="Rejection Reason" invisible="approval_state == 'approved'">
                        <field name="rejection_reason" nolabel="1" readonly="approval_state == 'rejected'"
                               placeholder="Required before rejecting."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cm_dpr_list" model="ir.ui.view">
        <field name="name">cm.dpr.list</field>
        <field name="model">cm.dpr</field>
        <field name="arch" type="xml">
            <list string="Daily Progress Reports">
                <field name="date"/>
                <field name="project_id"/>
                <field name="stage_id"/>
                <field name="weather"/>
                <field name="total_labour_present"/>
                <field name="labour_wage_total"/>
                <field name="approval_state" widget="badge"
                       decoration-success="approval_state == 'approved'"
                       decoration-info="approval_state in ('submitted', 'verified')"
                       decoration-danger="approval_state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="action_cm_dpr" model="ir.actions.act_window">
        <field name="name">Daily Progress Reports</field>
        <field name="res_model">cm.dpr</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
