<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_construction" model="ir.module.category">
        <field name="name">Construction Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_construction" model="res.groups.privilege">
        <field name="name">Construction</field>
        <field name="category_id" ref="module_category_construction"/>
    </record>

    <record id="group_cm_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Can create/update stages, BOQ, progress, store ledger and payments, but cannot certify a stage, release payments or close a sub-project.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_construction"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user')),
                                         (4, ref('purchase.group_purchase_user')), (4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_cm_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Full access: certify stages, release/mark payments, close sub-projects and master projects.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_cm_user'))]"/>
    </record>
</odoo>
