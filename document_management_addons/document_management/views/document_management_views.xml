<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_document_management_list" model="ir.ui.view">
        <field name="name">document.management.list</field>
        <field name="model">document.management</field>
        <field name="arch" type="xml">
            <list string="Documents" sample="1">
                <field name="name"/>
                <field name="title"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="rev_label" optional="show"/>
                <field name="document_count" string="Files"/>
                <field name="access_count" string="Users" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'released'"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('submitted', 'under_revision')"/>
            </list>
        </field>
    </record>

    <record id="view_document_management_kanban" model="ir.ui.view">
        <field name="name">document.management.kanban</field>
        <field name="model">document.management</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_documents" sample="1">
                <field name="state"/>
                <field name="is_view"/>
                <field name="is_upload"/>
                <field name="is_locked"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-0 overflow-hidden rounded-3 border-0 shadow-sm">
                            <div t-attf-class="p-1 #{
                                    record.state.raw_value === 'released' ? 'bg-success' :
                                    record.state.raw_value === 'draft' ? 'bg-info' : 'bg-warning'}"/>
                            <div class="p-3">
                                <div class="d-flex align-items-start gap-3 mb-2">
                                    <div class="d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:44px;height:44px;">
                                        <svg viewBox="0 0 100 100" width="40" height="40" role="img" aria-label="Document">
                                            <title>Document</title>
                                            <path fill="#EBA400" d="M10 20 H42 L50 28 H88 A4 4 0 0 1 92 32 V80 A4 4 0 0 1 88 84 H10 A4 4 0 0 1 6 80 V24 A4 4 0 0 1 10 20 Z"/>
                                            <rect fill="#F5F5F5" x="16" y="27" width="56" height="18" rx="2"/>
                                            <path fill="#FFCC00" d="M4 42 H32 L40 34 H92 A4 4 0 0 1 96 38 V86 A4 4 0 0 1 92 90 H8 A4 4 0 0 1 4 86 Z"/>
                                        </svg>
                                    </div>
                                    <div class="flex-grow-1 min-width-0">
                                        <strong class="o_kanban_record_title d-block text-truncate" style="font-size:15px;">
                                            <field name="title"/>
                                        </strong>
                                        <div class="text-muted small">
                                            <field name="name"/> · <field name="rev_label"/>
                                        </div>
                                    </div>
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'draft': 'default', 'submitted': 'warning', 'released': 'success', 'under_revision': 'warning'}}"/>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <field name="owner_id" widget="many2one_avatar_user"/>
                                    <span class="badge rounded-pill text-bg-light border">
                                        <i class="fa fa-file-o me-1" title="Files" role="img" aria-label="Files"/><field name="document_count"/> files
                                    </span>
                                    <span class="badge rounded-pill text-bg-light border">
                                        <i class="fa fa-users me-1" title="Users" role="img" aria-label="Users"/><field name="access_count"/> users
                                    </span>
                                </div>
                                <div class="d-flex gap-2">
                                    <button name="action_view_all_files" type="object"
                                            class="btn btn-sm btn-outline-primary rounded-pill flex-grow-1"
                                            invisible="not is_view or document_count == 0">
                                        <i class="fa fa-eye me-1"/>View
                                    </button>
                                    <button name="action_upload_document" type="object"
                                            class="btn btn-sm btn-outline-secondary rounded-pill flex-grow-1"
                                            invisible="is_locked or not is_upload">
                                        <i class="fa fa-upload me-1"/>Upload
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_document_management_search" model="ir.ui.view">
        <field name="name">document.management.search</field>
        <field name="model">document.management</field>
        <field name="arch" type="xml">
            <search string="Search Documents">
                <field name="name"/>
                <field name="title"/>
                <field name="owner_id"/>
                <filter string="My Documents" name="my_documents" domain="[('owner_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Released" name="filter_released" domain="[('state', '=', 'released')]"/>
                <filter string="Under Revision" name="filter_under_revision" domain="[('state', '=', 'under_revision')]"/>
                <!-- Group By -->
                <group>
                    <filter string="Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_document_management_form" model="ir.ui.view">
        <field name="name">document.management.form</field>
        <field name="model">document.management</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_release" type="object" string="Release"
                            class="oe_highlight" invisible="state != 'submitted'"
                            groups="document_management.group_document_contributor"/>
                    <button name="action_create_revision_request" type="object" string="Create Revision"
                            class="oe_highlight" invisible="state != 'released' or not can_manage_access"
                            groups="document_management.group_document_contributor"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'submitted' or not can_manage_access"
                            groups="document_management.group_document_contributor"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,released"/>
                </header>
                <sheet>
                    <field name="is_view" invisible="1"/>
                    <field name="is_upload" invisible="1"/>
                    <field name="is_download" invisible="1"/>
                    <field name="is_locked" invisible="1"/>
                    <field name="can_manage_access" invisible="1"/>
                    <field name="active_revision_request_id" invisible="1"/>

                    <widget name="web_ribbon" title="Submitted" bg_color="text-bg-warning" invisible="state != 'submitted'"/>
                    <widget name="web_ribbon" title="Released" bg_color="text-bg-success" invisible="state != 'released'"/>
                    <widget name="web_ribbon" title="Under Revision" bg_color="text-bg-warning" invisible="state != 'under_revision'"/>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_document_lines_kanban"
                                icon="fa-folder-open" invisible="not is_view or document_count == 0">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_upload_document"
                                icon="fa-upload" invisible="is_locked or not is_upload">
                            <span>Upload File</span>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_active_revision_request"
                                icon="fa-refresh" invisible="not active_revision_request_id">
                            <span>Pending Revision</span>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_revision_requests"
                                icon="fa-history" invisible="revision_request_count == 0">
                            <field name="revision_request_count" widget="statinfo" string="Revision Requests"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="title"/>
                        <h1>
                            <field name="title" placeholder="e.g. Supplier Quality Agreement"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="owner_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="rev_label" readonly="1"/>
                            <field name="document_count" readonly="1"/>
                            <field name="access_count" readonly="1"/>
                        </group>
                    </group>

                    <field name="description" placeholder="Add a description..."/>

                    <notebook>
                        <page string="Files" name="files">
                            <field name="document_line_ids" readonly="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="file" filename="file_name"/>
                                    <field name="file_name" column_invisible="1"/>
                                    <field name="file_type"/>
                                    <field name="rev_no"/>
                                    <field name="description"/>
                                    <field name="uploaded_by" readonly="1"/>
                                    <field name="upload_date" readonly="1"/>
                                    <field name="is_view" column_invisible="1"/>
                                    <field name="is_download" column_invisible="1"/>
                                    <button name="action_view_document" type="object" icon="fa-eye"
                                            title="View" invisible="not is_view"/>
                                    <button name="action_download" type="object" icon="fa-download"
                                            title="Download" invisible="not is_download"/>
                                </list>
                            </field>
                        </page>
                        <page string="User Access" name="access">
                            <field name="access_ids" readonly="not can_manage_access">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="is_view"/>
                                    <field name="is_upload"/>
                                    <field name="is_download"/>
                                </list>
                            </field>
                        </page>
                        <page string="Revision History" name="revisions">
                            <field name="revision_ids" readonly="1">
                                <list>
                                    <field name="rev_no"/>
                                    <field name="description"/>
                                    <field name="user_id"/>
                                    <field name="date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Revision Requests" name="revision_requests">
                            <field name="revision_request_ids" readonly="1">
                                <list decoration-muted="state in ('rejected', 'cancelled')"
                                      decoration-success="state == 'applied'"
                                      decoration-warning="state in ('draft', 'submitted', 'approved')">
                                    <field name="name"/>
                                    <field name="requested_by"/>
                                    <field name="request_date"/>
                                    <field name="cutoff_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_document_management" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">document.management</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_document_management_search"/>
        <field name="context">{'search_default_my_documents': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first document
            </p>
            <p>
                Upload files, grant user access, submit and keep a full
                revision history - all from one record.
            </p>
        </field>
    </record>

</odoo>
