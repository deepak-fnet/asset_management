<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Applies approved revision requests once their cutoff date
             arrives. Runs daily and must stay active by default: the
             whole point of a cutoff date is that no one has to remember
             to click an "apply" button on the day it arrives. -->
        <record id="ir_cron_apply_due_revisions" model="ir.cron">
            <field name="name">Document Management: Apply Due Revision Requests</field>
            <field name="model_id" ref="model_document_management_revision_request"/>
            <field name="state">code</field>
            <field name="code">model.cron_apply_due_revisions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
