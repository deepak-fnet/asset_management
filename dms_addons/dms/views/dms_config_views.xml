<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dms" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dms</field>
        <field name="model">res.config.settings</field>
        <field name="priority">90</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="DMS" string="DMS" name="dms" groups="dms.group_dms_controller">
                    <block title="DMS Server Connection" name="dms_server">
                        <setting string="Server Credential" help="Files are stored on this server over SFTP.">
                            <div class="row mt8"><label for="dms_server_host" class="col-lg-4 o_light_label"/><field name="dms_server_host" class="col-lg-8"/></div>
                            <div class="row"><label for="dms_server_port" class="col-lg-4 o_light_label"/><field name="dms_server_port" class="col-lg-8"/></div>
                            <div class="row"><label for="dms_server_user" class="col-lg-4 o_light_label"/><field name="dms_server_user" class="col-lg-8"/></div>
                            <div class="row"><label for="dms_server_password" class="col-lg-4 o_light_label"/><field name="dms_server_password" password="True" class="col-lg-8"/></div>
                            <div class="row"><label for="dms_server_path" class="col-lg-4 o_light_label"/><field name="dms_server_path" class="col-lg-8"/></div>
                            <button name="action_dms_test_connection" type="object" string="Test Connection &amp; Sync Folders" icon="fa-plug" class="btn-link mt8"/>
                        </setting>
                    </block>
                    <block title="File protection" name="dms_protect">
                        <setting string="Server copy password" help="Files on the DMS server are kept in a password-protected ZIP (AES-256). Someone who copies them straight from the server needs this password. Changing it rewrites every stored file.">
                            <field name="dms_server_encrypt"/>
                            <div class="row mt8" invisible="not dms_server_encrypt"><label for="dms_server_file_password" class="col-lg-4 o_light_label"/><field name="dms_server_file_password" password="True" class="col-lg-8"/></div>
                        </setting>
                        <setting string="Download password" help="Files downloaded from the DMS get this password. PDF and Word/Excel/PowerPoint open with a password prompt in their usual app; other types come as a password ZIP. Use a different password from the server one.">
                            <field name="dms_download_protect"/>
                            <div class="row mt8" invisible="not dms_download_protect"><label for="dms_download_password" class="col-lg-4 o_light_label"/><field name="dms_download_password" password="True" class="col-lg-8"/></div>
                        </setting>
                    </block>
                    <block title="Ask DMS (meaning search)" name="dms_vector">
                        <setting string="Meaning search service" help="The ERP AI Flask service (ChromaDB) that finds documents by meaning for Ask DMS. Documents are sent there when their text is read; access is always checked in Odoo.">
                            <field name="dms_vector_url"/>
                            <div class="row mt8"><label for="dms_vector_token" class="col-lg-4 o_light_label"/><field name="dms_vector_token" password="True" class="col-lg-8"/></div>
                            <div class="mt8"><button name="action_dms_vector_rebuild" type="object" string="Rebuild meaning search" icon="fa-refresh" class="btn-link"/></div>
                        </setting>
                    </block>
                    <block title="Emails" name="dms_mail">
                        <setting string="Send DMS emails" help="Approval needed, approved, refused, published, access requests and grants, folder deletion, disposal, expiry and a daily unusual-activity mail to the Document Controllers.">
                            <field name="dms_mail_enabled"/>
                        </setting>
                    </block>
                    <block title="Unusual activity alerts" name="dms_alerts">
                        <setting string="Alert thresholds" help="The Document Controller's dashboard flags anyone above these numbers in the last 7 days.">
                            <div class="row mt8"><label for="dms_alert_bulk_downloads" class="col-lg-6 o_light_label"/><field name="dms_alert_bulk_downloads" class="col-lg-3"/></div>
                            <div class="row mt8"><label for="dms_alert_bulk_views" class="col-lg-6 o_light_label"/><field name="dms_alert_bulk_views" class="col-lg-3"/></div>
                        </setting>
                        <setting string="Working hours and delays" help="Views and downloads outside these hours, or on Sunday, are flagged.">
                            <div class="row mt8"><label for="dms_alert_work_from" class="col-lg-6 o_light_label"/><field name="dms_alert_work_from" class="col-lg-3"/></div>
                            <div class="row mt8"><label for="dms_alert_work_to" class="col-lg-6 o_light_label"/><field name="dms_alert_work_to" class="col-lg-3"/></div>
                            <div class="row mt8"><label for="dms_alert_approval_days" class="col-lg-6 o_light_label"/><field name="dms_alert_approval_days" class="col-lg-3"/></div>
                            <div class="row mt8"><label for="dms_alert_checkout_days" class="col-lg-6 o_light_label"/><field name="dms_alert_checkout_days" class="col-lg-3"/></div>
                            <div class="row mt8"><label for="dms_expiry_alert_days" class="col-lg-6 o_light_label"/><field name="dms_expiry_alert_days" class="col-lg-3"/></div>
                        </setting>
                    </block>
                    <block title="AI" name="dms_ai">
                        <setting string="AI checks and search" help="Checks uploads against the rules of their document type, extracts fields, and powers natural-language search.">
                            <field name="dms_ai_enabled"/>
                            <div class="row mt8" invisible="not dms_ai_enabled"><label for="dms_ai_url" class="col-lg-4 o_light_label"/><field name="dms_ai_url" class="col-lg-8"/></div>
                            <div class="row" invisible="not dms_ai_enabled"><label for="dms_ai_model" class="col-lg-4 o_light_label"/><field name="dms_ai_model" class="col-lg-8"/></div>
                            <div class="row" invisible="not dms_ai_enabled"><label for="dms_ai_key" class="col-lg-4 o_light_label"/><field name="dms_ai_key" password="True" class="col-lg-8"/></div>
                        </setting>
                    </block>
                    <block title="Revisions &amp; Appearance" name="dms_rules">
                        <setting string="Cut-off" help="Days a superseded revision stays on screen after the next one is approved.">
                            <field name="dms_cutoff_days"/>
                        </setting>
                        <setting string="Theme" help="Navy, Brown (parchment) or Gold: applies to the whole DMS app.">
                            <field name="dms_theme" widget="radio" options="{'horizontal': true}"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_dms_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'dms', 'bin_size': False}</field>
    </record>
</odoo>
