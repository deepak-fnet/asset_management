<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dms_notify_rule_list" model="ir.ui.view">
        <field name="name">dms.notify.rule.list</field>
        <field name="model">dms.notify.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="category" readonly="1"/>
                <field name="name"/>
                <field name="description" readonly="1"/>
                <field name="audience" readonly="1"/>
                <field name="email" widget="boolean_toggle"/>
                <field name="app" widget="boolean_toggle" string="In-app"/>
                <button name="action_send_sample" type="object" string="Send me a sample" icon="fa-paper-plane-o" class="btn-link"/>
            </list>
        </field>
    </record>
    <record id="view_dms_notify_rule_search" model="ir.ui.view">
        <field name="name">dms.notify.rule.search</field>
        <field name="model">dms.notify.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="no_mail" string="Email off" domain="[('email', '=', False)]"/>
                <filter name="no_app" string="In-app off" domain="[('app', '=', False)]"/>
                <group><filter name="by_cat" string="Category" context="{'group_by': 'category'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_dms_notify_rules" model="ir.actions.act_window">
        <field name="name">Emails &amp; notifications</field>
        <field name="res_model">dms.notify.rule</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_by_cat': 1}</field>
        <field name="help" type="html"><p>Choose, for each DMS event, whether people get an email, an in-app notification, both or nothing.</p></field>
    </record>
    <menuitem id="menu_dms_notify_rules" name="Emails &amp; Notifications" parent="menu_dms_config" action="action_dms_notify_rules" sequence="4"/>
</odoo>
