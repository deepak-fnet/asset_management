<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dms" model="ir.module.category">
        <field name="name">Document Management</field>
        <field name="sequence">40</field>
    </record>
    <record id="res_groups_privilege_dms" model="res.groups.privilege">
        <field name="name">DMS</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_dms"/>
    </record>
    <record id="group_dms_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Authors, reviewers, approvers and staff. Sees only folders and files granted to them.</field>
    </record>
    <record id="group_dms_controller" model="res.groups">
        <field name="name">Document Controller</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dms"/>
        <field name="implied_ids" eval="[(4, ref('group_dms_user'))]"/>
        <field name="comment">Edit on all folders, grants access, force-unlocks, raises disposal requests.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <!-- Ask DMS chats: your own; Document Controllers read everyone's -->
    <record id="rule_ai_session_own" model="ir.rule">
        <field name="name">Ask DMS: own chats</field>
        <field name="model_id" ref="model_dms_ai_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
    </record>
    <record id="rule_ai_message_own" model="ir.rule">
        <field name="name">Ask DMS: own messages</field>
        <field name="model_id" ref="model_dms_ai_message"/>
        <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
    </record>
    <record id="rule_ai_session_ctrl" model="ir.rule">
        <field name="name">Ask DMS: Controllers read all chats</field>
        <field name="model_id" ref="model_dms_ai_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dms_controller'))]"/>
        <field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_ai_message_ctrl" model="ir.rule">
        <field name="name">Ask DMS: Controllers read all messages</field>
        <field name="model_id" ref="model_dms_ai_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dms_controller'))]"/>
        <field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
</odoo>
