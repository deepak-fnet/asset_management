<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rb" model="ir.module.category">
        <field name="name">Network Browser</field>
        <field name="sequence">55</field>
    </record>
    <record id="res_groups_privilege_rb" model="res.groups.privilege">
        <field name="name">Network Browser</field>
        <field name="sequence">55</field>
        <field name="category_id" ref="module_category_rb"/>
    </record>
    <record id="group_rb_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_rb"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Opens internal pages through the server's network.</field>
    </record>
    <record id="group_rb_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_rb"/>
        <field name="implied_ids" eval="[(4, ref('group_rb_user'))]"/>
        <field name="comment">Decides which hosts can be opened and reads everyone's history.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rb_visit_own" model="ir.rule">
        <field name="name">Network Browser: own history</field>
        <field name="model_id" ref="model_rb_visit"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rb_user'))]"/>
    </record>
    <record id="rule_rb_visit_admin" model="ir.rule">
        <field name="name">Network Browser: all history</field>
        <field name="model_id" ref="model_rb_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_rb_admin'))]"/>
    </record>
    <record id="rule_rb_bookmark" model="ir.rule">
        <field name="name">Network Browser: shared and own bookmarks</field>
        <field name="model_id" ref="model_rb_bookmark"/>
        <field name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rb_user'))]"/>
    </record>
    <record id="rule_rb_bookmark_admin" model="ir.rule">
        <field name="name">Network Browser: all bookmarks</field>
        <field name="model_id" ref="model_rb_bookmark"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_rb_admin'))]"/>
    </record>
</odoo>
