<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="host_192_168" model="rb.allowed.host"><field name="name">192.168.*</field><field name="note">Private network</field><field name="sequence">1</field></record>
        <record id="host_10" model="rb.allowed.host"><field name="name">10.*</field><field name="note">Private network</field><field name="sequence">2</field></record>
        <record id="host_local" model="rb.allowed.host"><field name="name">*.local</field><field name="note">Local names</field><field name="sequence">3</field></record>
        <record id="host_localhost" model="rb.allowed.host"><field name="name">localhost</field><field name="note">This server</field><field name="sequence">4</field></record>
        <record id="host_127" model="rb.allowed.host"><field name="name">127.0.0.1</field><field name="note">This server</field><field name="sequence">5</field></record>
    </data>
    <record id="cron_reap" model="ir.cron">
        <field name="name">Network Browser: close idle browsers</field>
        <field name="model_id" ref="model_rb_visit"/>
        <field name="state">code</field>
        <field name="code">model._cron_reap_sessions()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
