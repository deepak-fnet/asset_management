<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_voice_to_text" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.voice.to.text</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Voice to Text" name="voice_to_text"
                     logo="/base/static/description/settings.png">
                    <block title="Speech-to-Text (Parakeet TDT)"
                           name="voice_to_text_block">
                        <setting string="Enable Voice to Text"
                                 help="When disabled, dictation widgets and the test console are hidden.">
                            <field name="stt_enabled"/>
                        </setting>
                        <setting string="STT Service URL"
                                 help="Base URL of the Parakeet TDT microservice."
                                 invisible="not stt_enabled">
                            <field name="stt_url" placeholder="http://localhost:8010"/>
                        </setting>
                        <setting string="Chunk Length (seconds)" invisible="not stt_enabled">
                            <field name="stt_chunk_seconds"/>
                        </setting>
                        <setting string="Timeout (seconds)" invisible="not stt_enabled">
                            <field name="stt_timeout"/>
                        </setting>
                        <setting string="Test Connection" invisible="not stt_enabled">
                            <button name="action_test_stt_connection"
                                    type="object"
                                    string="Test Connection"
                                    class="btn-primary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
