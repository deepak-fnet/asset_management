<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Help Desk -->
    <menuitem id="menu_asset_helpdesk_main"
              name="Help Desk"
              parent="asset_management.menu_asset_root"
              sequence="10"/>

    <!-- Tickets -->
    <menuitem id="menu_asset_helpdesk_tickets"
              name="Tickets"
              parent="menu_asset_helpdesk_main"
              action="action_asset_helpdesk"
              sequence="10"/>

    <!-- Repair Management -->
    <menuitem id="asset_management.menu_repair_management"
              name="Repair Management"
              parent="menu_asset_helpdesk_main"
              action="asset_management.action_repair_management"
              sequence="20"/>

    <!-- Configuration -->
    <menuitem id="menu_asset_helpdesk_configuration"
              name="Configuration"
              parent="asset_management.menu_asset_root"
              sequence="100"/>

    <menuitem id="menu_asset_helpdesk_teams"
              name="Teams"
              parent="menu_asset_helpdesk_configuration"
              action="action_asset_helpdesk_team"
              sequence="10"/>

    <menuitem id="menu_asset_helpdesk_types"
              name="Ticket Types"
              parent="menu_asset_helpdesk_configuration"
              action="action_asset_helpdesk_type"
              sequence="20"/>

    <menuitem id="menu_asset_helpdesk_categories"
              name="Categories"
              parent="menu_asset_helpdesk_configuration"
              action="action_asset_helpdesk_category"
              sequence="30"/>


    <!-- Window Action -->
    <record id="action_product_asset" model="ir.actions.act_window">
        <field name="name">Asset Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_asset', '=', True)]</field>
        <field name="context">{'default_is_asset': 1}</field>
    </record>

    <!-- Menu Item -->
    <menuitem
            id="menu_product_asset"
            name="Asset Products"
            action="action_product_asset"
            parent="menu_asset_helpdesk_configuration"
            sequence="10"/>
</odoo>