<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_asset_helpdesk_form" model="ir.ui.view">
        <field name="name">asset.helpdesk.form</field>
        <field name="model">asset.helpdesk</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <button name="action_create_repair_management" type="object" string="Create Task"
                            class="btn-primary" invisible="repair_id or state != 'open'"/>
                    <button name="action_mail_reply" type="object" string="Reply"
                            invisible="not mail_id or state in ('solved', 'replaced', 'cancelled')"/>
                    <field name="mail_id" invisible="1"/>
                    <button name="action_replace_yes" string="Replace" type="object" class="btn-primary"
                            invisible="state != 'replace_pending' or not can_decide_replace"/>
                    <button name="action_keep_standby" string="Keep Standby Asset" type="object" class="btn-primary"
                            invisible="state != 'replace_pending' or not can_decide_replace or not standby_process_id"
                            confirm="Keep the standby asset permanently? The broken asset will be scrapped."/>
                    <button name="action_replace_no" string="No Replacement" type="object"
                            invisible="state != 'replace_pending' or not can_decide_replace"
                            confirm="The broken asset will be scrapped and the ticket closed. Continue?"/>
                    <field name="can_decide_replace" invisible="1"/>
                    <field name="standby_process_id" invisible="1"/>
                    <!-- A query answered by mail needs no task: close it directly. -->
                    <button name="action_mark_solved" string="Close" type="object"
                            invisible="repair_id or state not in ('open', 'created')"
                            confirm="Close this ticket without a task?"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('solved', 'replaced', 'cancelled')"/>
                    <button name="action_reset_to_open" string="Reset to Open" type="object"
                            invisible="state != 'cancelled'"/>

                    <field name="state" widget="statusbar" statusbar_visible="open,created,solved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_create_repair_management" class="oe_stat_button"
                                invisible="not repair_id" icon="fa-tasks">
                            <span class="o_stat_text">Task</span>
                        </button>
                        <button type="object" name="action_view_mail_lines" class="oe_stat_button"
                                invisible="not mail_id" icon="fa-envelope">
                            <span class="o_stat_text">Mails</span>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="subject" placeholder="Ticket Subject"/>
                        </h1>
                    </div>

                    <group>
                        <!-- Row 1 -->
                        <group>
                            <field name="ticket_number"/>
                            <field name="priority" widget="priority" decoration-info="priority == 'low'"
                                   decoration-primary="priority == 'medium'" decoration-warning="priority == 'high'"
                                   decoration-danger="priority == 'critical'"/>
                        </group>

                        <!-- Row 2 -->
                        <group>
                            <field name="ticket_type_id"/>
                        </group>

                        <!-- No team / person on the ticket: the task (repair)
                             is where the work is assigned. -->

                        <!-- Row 4 -->
                        <group>
                            <field name="category_id"/>
                            <field name="asset_id"
                                   domain="[('is_general_asset', '=', True), ('state', 'in', ['draft', 'submit', 'assigned']), ('in_repair', '=', False)]"/>
                        </group>

                        <group>
                            <field name="repair_id" invisible="1"/>
                            <field name="is_repair_flow" invisible="1"/>
                            <field name="is_general" invisible="1"/>
                        </group>
                    </group>

                    <group string="Requester / Contact Details">
                        <group>
                            <field name="customer_id"/>
                            <field name="requester_employee_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Asset History" invisible="not asset_id">
                        <group>
                            <field name="asset_repair_count"/>
                            <field name="asset_ticket_count"/>
                        </group>
                        <group>
                            <field name="asset_last_maintenance"/>
                            <field name="replacement_asset_id" invisible="not replacement_asset_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conversation" name="conversation" invisible="not mail_id">
                            <field name="mail_thread_html" readonly="1" nolabel="1" class="o_hd_thread"/>
                        </page>
                        <page string="Problem" name="problem">
                            <field name="problem_html" placeholder="What is the problem?"/>
                        </page>
                        <page string="History" name="history">
                            <field name="history_ids" readonly="1">
                                <list string="History" decoration-muted="new_state in ('solved', 'cancelled')">
                                    <field name="change_date"/>
                                    <field name="old_state" widget="badge"/>
                                    <field name="new_state" widget="badge" decoration-info="new_state == 'open'"
                                           decoration-warning="new_state == 'created'"
                                           decoration-success="new_state == 'solved'"
                                           decoration-danger="new_state == 'cancelled'"/>
                                    <field name="changed_by"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_asset_helpdesk_tree" model="ir.ui.view">
        <field name="name">asset.helpdesk.tree</field>
        <field name="model">asset.helpdesk</field>
        <field name="arch" type="xml">
            <list string="Helpdesk Tickets">
                <field name="ticket_number"/>
                <field name="subject"/>
                <field name="ticket_type_id"/>
                <field name="category_id"/>
                <field name="priority" widget="badge"
                       decoration-info="priority == 'low'"
                       decoration-primary="priority == 'medium'"
                       decoration-warning="priority == 'high'"
                       decoration-danger="priority == 'critical'"/>
                <field name="repair_id" string="Task" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'open'"
                       decoration-warning="state == 'created'"
                       decoration-success="state == 'solved'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>


    <!--  Kanban View  -->
    <record id="view_asset_helpdesk_kanban" model="ir.ui.view">
        <field name="name">asset.helpdesk.kanban</field>
        <field name="model">asset.helpdesk</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="state"
                    records_draggable="true" quick_create="false" group_create="true">
                <field name="ticket_number"/>
                <field name="subject"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="category_id"/>
                <field name="team_id"/>
                <field name="assigned_to_id"/>
                <field name="create_date"/>
                <progressbar field="state"
                             colors='{"open": "info", "created": "warning", "solved": "success", "cancelled": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record oh_ticket_card oh_ticket_#{record.state.raw_value}">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="oh_ticket_number">
                                    <i class="fa fa-tag me-1"/>
                                    <strong>
                                        <field name="ticket_number"/>
                                    </strong>
                                </div>
                                <div class="oh_ticket_priority">
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                            <div class="oh_ticket_subject mt-1 mb-2">
                                <field name="subject"/>
                            </div>
                            <div class="oh_ticket_info">
                                <div t-if="record.category_id.value" class="oh_ticket_info_line">
                                    <i class="fa fa-folder-o me-1"/>
                                    <span class="oh_label">Category:</span>
                                    <field name="category_id"/>
                                </div>
                                <div t-if="record.team_id.value" class="oh_ticket_info_line">
                                    <i class="fa fa-users me-1"/>
                                    <span class="oh_label">Team:</span>
                                    <field name="team_id"/>
                                </div>
                                <div class="oh_ticket_info_line">
                                    <i class="fa fa-calendar me-1"/>
                                    <span class="oh_label">Created:</span>
                                    <field name="create_date" widget="date"/>
                                </div>
                                <div class="oh_ticket_info_line">
                                    <i class="fa fa-info-circle me-1"/>
                                    <span class="oh_label">Status:</span>
                                    <span class="oh_status_pill">
                                        <field name="state"/>
                                    </span>
                                </div>
                            </div>
                            <div class="oh_ticket_footer d-flex justify-content-between align-items-center mt-2 pt-2">
                                <span class="oh_drag_hint">
                                    <i class="fa fa-arrows me-1"/>Drag to assign
                                </span>
                                <span t-if="record.assigned_to_id.value" class="d-flex align-items-center">
                                    <img t-att-src="kanban_image('res.users', 'avatar_128', record.assigned_to_id.raw_value)"
                                         class="oh_avatar rounded-circle me-1" alt="Avatar"/>
                                    <field name="assigned_to_id"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>    <!-- Search View -->
    <record id="view_asset_helpdesk_search" model="ir.ui.view">
        <field name="name">asset.helpdesk.search</field>
        <field name="model">asset.helpdesk</field>
        <field name="arch" type="xml">
            <search string="Search Helpdesk Tickets">
                <field name="ticket_number" string="Ticket Number"/>
                <field name="subject" string="Subject"/>
                <field name="team_id"/>
                <field name="assigned_to_id"/>
                <filter string="Open" name="filter_open" domain="[('state', '=', 'open')]"/>
                <filter string="Created" name="filter_created" domain="[('state', '=', 'created')]"/>
                <filter string="Solved" name="filter_solved" domain="[('state', '=', 'solved')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter string="Team" name="group_by_team" context="{'group_by': 'team_id'}"/>-->
<!--                    <filter string="Assigned To" name="group_by_assigned" context="{'group_by': 'assigned_to_id'}"/>-->
<!--                    <filter string="Priority" name="group_by_priority" context="{'group_by': 'priority'}"/>-->
<!--                    <filter string="Ticket Type" name="group_by_type" context="{'group_by': 'ticket_type_id'}"/>-->
<!--                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>-->
<!--                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_asset_helpdesk" model="ir.actions.act_window">
        <field name="name">Help Desk</field>
        <field name="res_model">asset.helpdesk</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_helpdesk_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new helpdesk ticket
            </p>
        </field>
    </record>

</odoo>
