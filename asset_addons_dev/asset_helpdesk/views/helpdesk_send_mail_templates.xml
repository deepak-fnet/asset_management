<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- /helpdesk/send-mail: send a mail to the helpdesk mailbox by hand,
         until the real incoming mail server is set up. -->
    <template id="helpdesk_send_mail_page" name="Helpdesk - Send Mail">
        <t t-call="website.layout">
            <div class="container py-5" style="max-width: 760px;">
                <h2 class="mb-1">Send a mail to Helpdesk</h2>
                <p class="text-muted">Works like emailing the helpdesk mailbox: you get a ticket
                    number and an acknowledgement. To add to an existing ticket, keep
                    <code>[Ticket#number]</code> in the subject.</p>
                <div t-if="result" class="alert alert-success">
                    Received. Ticket <b t-esc="result.ticket_ref"/>
                </div>
                <div t-if="error" class="alert alert-danger" t-esc="error"/>
                <form method="post" action="/helpdesk/send-mail">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label" for="email_from">From</label>
                        <input class="form-control" id="email_from" name="email_from" type="text"
                               t-att-value="post.get('email_from') or default_from" required="1"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="subject">Subject</label>
                        <input class="form-control" id="subject" name="subject" type="text"
                               t-att-value="post.get('subject')" required="1"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="body">Message</label>
                        <textarea class="form-control" id="body" name="body" rows="8"><t t-out="post.get('body') or ''"/></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Send</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
