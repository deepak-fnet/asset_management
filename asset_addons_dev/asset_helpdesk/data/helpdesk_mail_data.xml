<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Ticket number given to every mail: YYYYMMDD + counter,
             e.g. 2026101000001 -->
        <record id="seq_asset_helpdesk_mail" model="ir.sequence">
            <field name="name">Helpdesk Mail Ticket No.</field>
            <field name="code">asset.helpdesk.mail</field>
            <field name="prefix">%(year)s%(month)s%(day)s</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="param_repair_notify_email" model="ir.config_parameter">
            <field name="key">asset_helpdesk.repair_notify_email</field>
            <field name="value">deepak@futurenet.in</field>
        </record>
        <record id="param_helpdesk_mailbox" model="ir.config_parameter">
            <field name="key">asset_helpdesk.mailbox</field>
            <field name="value">deepakraj@futurenet.in</field>
        </record>
        <!-- Incoming mailbox: fill in server / password under
             Settings > Technical > Incoming Mail Servers, then Test & Confirm. -->
        <record id="fetchmail_helpdesk_mailbox" model="fetchmail.server">
            <field name="name">Helpdesk - deepakraj@futurenet.in</field>
            <field name="server_type">imap</field>
            <field name="server">mail.futurenet.in</field>
            <field name="port">993</field>
            <field name="is_ssl" eval="True"/>
            <field name="user">deepakraj@futurenet.in</field>
            <field name="object_id" ref="asset_helpdesk.model_asset_helpdesk_mail"/>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
