<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Telemetry tab on the asset form -->
    <record id="view_asset_form_telemetry" model="ir.ui.view">
        <field name="name">asset.asset.form.telemetry</field>
        <field name="model">asset.asset</field>
        <field name="inherit_id" ref="asset_management.view_asset_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Agent Telemetry" name="agent_telemetry">

                    <div class="alert alert-secondary" role="status">
                        <b>Raw agent payload.</b>
                        Whatever the agent collected, stored verbatim as JSON.
                        Adding a new section on the agent needs no Odoo change —
                        it simply appears here.
                    </div>

                    <group>
                        <group string="Last Report">
                            <field name="agent_telemetry_at" readonly="1"/>
                            <field name="agent_telemetry_size" readonly="1"
                                   string="Payload (bytes)"/>
                            <field name="telemetry_snapshot_count" readonly="1"
                                   string="Snapshots Kept"/>
                        </group>
                        <group string="Actions">
                            <button name="action_view_telemetry_history"
                                    type="object" class="btn-link"
                                    string="View History"
                                    invisible="telemetry_snapshot_count == 0"/>
                            <button name="action_clear_telemetry"
                                    type="object" class="btn-link text-danger"
                                    string="Clear Telemetry"
                                    confirm="Delete stored telemetry and all snapshots for this asset?"
                                    groups="asset_management.group_asset_manager"/>
                        </group>
                    </group>

                    <separator string="Telemetry"/>
                    <field name="agent_telemetry" widget="json_tree" nolabel="1"/>

                    <separator string="Formatted (copy-paste)"/>
                    <field name="agent_telemetry_pretty" readonly="1" nolabel="1"
                           widget="text"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Snapshot history -->
    <record id="view_telemetry_snapshot_list" model="ir.ui.view">
        <field name="name">asset.telemetry.snapshot.list</field>
        <field name="model">asset.telemetry.snapshot</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="captured_at"/>
                <field name="asset_id"/>
                <field name="size_bytes" string="Bytes"/>
                <field name="section_summary" string="Sections"/>
            </list>
        </field>
    </record>

    <record id="view_telemetry_snapshot_form" model="ir.ui.view">
        <field name="name">asset.telemetry.snapshot.form</field>
        <field name="model">asset.telemetry.snapshot</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="1"/>
                            <field name="captured_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="size_bytes" readonly="1"/>
                            <field name="section_summary" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Payload"/>
                    <field name="payload" widget="json_tree" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telemetry_snapshot_search" model="ir.ui.view">
        <field name="name">asset.telemetry.snapshot.search</field>
        <field name="model">asset.telemetry.snapshot</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <filter name="f_today" string="Today"
                        domain="[('captured_at','&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter name="g_asset" string="Asset"-->
<!--                            context="{'group_by':'asset_id'}"/>-->
<!--                    <filter name="g_day" string="Day"-->
<!--                            context="{'group_by':'captured_at:day'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <record id="action_telemetry_snapshot" model="ir.actions.act_window">
        <field name="name">Telemetry Snapshots</field>
        <field name="res_model">asset.telemetry.snapshot</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_telemetry_snapshot_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No telemetry yet</p>
            <p>
                Deploy <code>agent_snippets/telemetry.py</code> to the agent.
                Snapshots appear here once it starts reporting.
            </p>
        </field>
    </record>

    <menuitem id="menu_telemetry_snapshots"
              name="Agent Telemetry"
              parent="asset_management.menu_asset_root"
              action="action_telemetry_snapshot"
              sequence="58"
              groups="asset_management.group_asset_manager"/>

</odoo>
