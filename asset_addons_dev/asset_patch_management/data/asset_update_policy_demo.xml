<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Conservative starter policy. Inactive by default — review the
             targeting and run Preview before enabling. -->
        <record id="policy_standard_security" model="asset.update.policy">
            <field name="name">Standard — Security &amp; Critical Only</field>
            <field name="sequence">10</field>
            <field name="active" eval="False"/>
            <field name="approve_security" eval="True"/>
            <field name="approve_critical" eval="True"/>
            <field name="approve_important" eval="False"/>
            <field name="approve_optional" eval="False"/>
            <field name="delay_days">7</field>
            <field name="use_maintenance_window" eval="True"/>
            <field name="window_weekday">6</field>
            <field name="window_start_hour">2</field>
            <field name="window_end_hour">5</field>
            <field name="asset_type_filter">all</field>
            <field name="max_per_run">25</field>
            <field name="description">Conservative default: security and critical patches only, held 7 days so a bad patch has time to surface publicly, installed Sunday 02:00-05:00. Review targeting and run Preview before activating.</field>
        </record>

    </data>
</odoo>
