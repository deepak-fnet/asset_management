<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- DEFINE ALL ACTIONS FIRST (before they are referenced)        -->
    <!-- ============================================================ -->

    <record id="action_ssh_connection_log" model="ir.actions.act_window">
        <field name="name">Connection Logs</field>
        <field name="res_model">ssh.connection.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_ssh_server" model="ir.actions.act_window">
        <field name="name">SSH Servers</field>
        <field name="res_model">ssh.server</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_ssh_access_request_user" model="ir.actions.act_window">
        <field name="name">My Access Requests</field>
        <field name="res_model">ssh.access.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
    </record>

    <record id="action_ssh_access_request_manager" model="ir.actions.act_window">
        <field name="name">Pending Approvals</field>
        <field name="res_model">ssh.access.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_ssh_access_request_all" model="ir.actions.act_window">
        <field name="name">All Access Requests</field>
        <field name="res_model">ssh.access.request</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- SSH SERVER VIEWS                                             -->
    <!-- ============================================================ -->

    <record id="view_ssh_server_form" model="ir.ui.view">
        <field name="name">ssh.server.form</field>
        <field name="model">ssh.server</field>
        <field name="arch" type="xml">
            <form string="SSH Server">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Server Name"/></h1>
                    </div>
                    <group>
                        <group string="Server Information">
                            <field name="description"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Connection Details (Encrypted)">
                            <field name="ip_input" placeholder="Enter IP Address"
                                   password="True" string="IP Address"/>
                            <field name="port_input" string="Port"/>
                            <field name="ip_masked" string="Stored IP (Masked)" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Credentials" name="credentials">
                            <field name="credential_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="username_input" password="True" string="Username"/>
                                    <field name="password_input" password="True" string="Password"/>
                                    <field name="username_masked" string="Stored User"/>
                                    <field name="access_level"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Access Control" name="access">
                            <group>
                                <field name="allowed_group_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ssh_server_tree" model="ir.ui.view">
        <field name="name">ssh.server.tree</field>
        <field name="model">ssh.server</field>
        <field name="arch" type="xml">
            <list string="SSH Servers">
                <field name="name"/>
                <field name="ip_masked" string="IP Address"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- CONNECTION LOG VIEWS - ENHANCED                              -->
    <!-- ============================================================ -->

    <record id="view_ssh_connection_log_tree" model="ir.ui.view">
        <field name="name">ssh.connection.log.tree</field>
        <field name="model">ssh.connection.log</field>
        <field name="arch" type="xml">
            <list string="Connection Logs" create="false" edit="false"
                  decoration-warning="disconnect_reason == 'server_restart'"
                  decoration-info="disconnect_reason == 'user'">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="server_id"/>
                <field name="connected_at"/>
                <field name="disconnected_at"/>
                <field name="duration_seconds"/>
                <field name="disconnect_reason" optional="show"/>
                <field name="ip_address" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ssh_connection_log_form" model="ir.ui.view">
        <field name="name">ssh.connection.log.form</field>
        <field name="model">ssh.connection.log</field>
        <field name="arch" type="xml">
            <form string="Connection Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Session Information">
                            <field name="request_id"/>
                            <field name="user_id"/>
                            <field name="server_id"/>
                            <field name="session_id"/>
                        </group>
                        <group string="Connection Details">
                            <field name="connected_at"/>
                            <field name="disconnected_at"/>
                            <field name="duration_seconds"/>
                            <field name="disconnect_reason"/>
                        </group>
                    </group>
                    <group string="Client Information">
                        <field name="ip_address"/>
                        <field name="user_agent"/>
                    </group>
                    <notebook>
                        <page string="Raw Log" name="raw_log" groups="ssh_terminal.group_ssh_admin">
                            <field name="command_log" nolabel="1" widget="text"
                                   placeholder="Raw command log data"/>
                        </page>
                        <page string="Log Table" name="log_table" groups="ssh_terminal.group_ssh_manager">
                            <field name="html_command_log"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACCESS REQUEST VIEWS - ENHANCED                              -->
    <!-- ============================================================ -->

    <record id="view_ssh_access_request_form_user" model="ir.ui.view">
        <field name="name">ssh.access.request.form.user</field>
        <field name="model">ssh.access.request</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Access Request">
                <header>
                    <button name="action_submit" string="Submit Request"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_connect" string="Terminal"
                            type="object" class="btn-success"
                            invisible="state != 'approved'"
                            icon="fa-terminal"/>
                    <button name="action_connect_sftp" string="File Manager"
                            type="object" class="btn-primary"
                            invisible="state != 'approved'"
                            icon="fa-folder-open"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_connections" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="connection_count" widget="statinfo" string="Connections"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Request Details">
                            <field name="server_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="credential_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"
                                   domain="[('server_id', '=', server_id)]"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group string="Access Period">
                            <field name="access_start" readonly="state != 'draft'"/>
                            <field name="access_end" readonly="state != 'draft'"/>
                            <field name="duration_hours" readonly="1"/>
                            <field name="last_connection" readonly="1" invisible="not last_connection"/>
                        </group>
                    </group>
                    <group string="Reason for Access">
                        <field name="reason" nolabel="1"
                               placeholder="Explain why you need access..."
                               readonly="state != 'draft'"/>
                    </group>
                    <group string="Approval Information"
                           invisible="state in ('draft', 'submitted')">
                        <field name="approver_id" readonly="1"/>
                        <field name="approval_date" readonly="1"/>
                        <field name="rejection_reason" readonly="1"
                               invisible="state != 'rejected'"/>
                    </group>
                    <notebook>
                        <page string="Connection History" name="connections"
                              invisible="not connection_log_ids">
                            <field name="connection_log_ids" nolabel="1">
                                <list string="Connections" create="false" edit="false">
                                    <field name="connected_at"/>
                                    <field name="disconnected_at"/>
                                    <field name="duration_seconds"/>
                                    <field name="disconnect_reason"/>
                                    <field name="ip_address"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Manager View - Additional approve/reject buttons -->
    <record id="view_ssh_access_request_form_manager" model="ir.ui.view">
        <field name="name">ssh.access.request.form.manager</field>
        <field name="model">ssh.access.request</field>
        <field name="inherit_id" ref="view_ssh_access_request_form_user"/>
        <field name="arch" type="xml">
            <button name="action_submit" position="after">
                <button name="action_approve" string="Approve"
                        type="object" class="btn-success"
                        invisible="state != 'submitted'"/>
                <button name="action_reject" string="Reject"
                        type="object" class="btn-danger"
                        invisible="state != 'submitted'"/>
                <button name="action_revoke" string="Revoke Access"
                        type="object" class="btn-warning"
                        invisible="state != 'approved'"/>
            </button>
        </field>
    </record>

    <record id="view_ssh_access_request_tree" model="ir.ui.view">
        <field name="name">ssh.access.request.tree</field>
        <field name="model">ssh.access.request</field>
        <field name="arch" type="xml">
            <list string="Access Requests" decoration-success="state == 'approved'"
                  decoration-danger="state in ('rejected', 'revoked')"
                  decoration-muted="state == 'expired'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="server_id"/>
                <field name="credential_id"/>
                <field name="access_start"/>
                <field name="access_end"/>
                <field name="connection_count" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="approver_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ssh_access_request_search" model="ir.ui.view">
        <field name="name">ssh.access.request.search</field>
        <field name="model">ssh.access.request</field>
        <field name="arch" type="xml">
            <search string="Access Requests">
                <field name="name"/>
                <field name="user_id"/>
                <field name="server_id"/>
                <filter name="my_requests" string="My Requests"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="pending" string="Pending Approval"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_server" string="Server" context="{'group_by': 'server_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- KANBAN VIEW - Access Requests Dashboard                      -->
    <!-- ============================================================ -->

    <record id="view_ssh_access_request_kanban" model="ir.ui.view">
        <field name="name">ssh.access.request.kanban</field>
        <field name="model">ssh.access.request</field>
        <field name="arch" type="xml">
            <kanban class="ssh_kanban_view" default_order="create_date desc" sample="1">
                <field name="name"/>
                <field name="server_id"/>
                <field name="state"/>
                <field name="access_start"/>
                <field name="access_end"/>
                <field name="access_remaining"/>
                <field name="is_connectable"/>
                <field name="connection_count"/>
                <field name="credential_id"/>
                <field name="user_id"/>
                <field name="approver_id"/>
                <templates>
                    <t t-name="card">
                        <div class="ssh_kanban_card">
                            <!-- Top section with status border -->
                            <div t-attf-class="ssh-card-top ssh-card-top-#{record.state.raw_value}">
                                <div class="ssh-card-server-name">
                                    <i class="fa fa-server" title="Server"/>
                                    <field name="server_id"/>
                                </div>
                                <div class="ssh-card-ref">
                                    <field name="name"/>
                                </div>
                                <div t-attf-class="ssh-card-badge ssh-badge-#{record.state.raw_value}">
                                    <field name="state"/>
                                </div>
                            </div>

                            <!-- Details section -->
                            <div class="ssh-card-details">
                                <div class="ssh-card-detail-row">
                                    <span class="ssh-card-detail-label">
                                        <i class="fa fa-user"/>
                                        Requested by
                                    </span>
                                    <span class="ssh-card-detail-value">
                                        <field name="user_id"/>
                                    </span>
                                </div>
                                <div class="ssh-card-detail-row">
                                    <span class="ssh-card-detail-label">
                                        <i class="fa fa-key"/>
                                        Access Level
                                    </span>
                                    <span class="ssh-card-detail-value">
                                        <field name="credential_id"/>
                                    </span>
                                </div>
                                <div class="ssh-card-detail-row">
                                    <span class="ssh-card-detail-label">
                                        <i class="fa fa-clock-o"/>
                                        Window
                                    </span>
                                    <span class="ssh-card-detail-value" style="font-size:11px">
                                        <field name="access_start" widget="date"/>
                                        →
                                        <field name="access_end" widget="date"/>
                                    </span>
                                </div>
                                <div class="ssh-card-detail-row">
                                    <span class="ssh-card-detail-label">
                                        <i class="fa fa-plug"/>
                                        Connections
                                    </span>
                                    <span class="ssh-card-detail-value">
                                        <field name="connection_count"/>
                                    </span>
                                </div>
                                <t t-if="record.state.raw_value == 'approved' and record.access_remaining.raw_value">
                                    <div class="ssh-card-remaining">
                                        <i class="fa fa-hourglass-half" title="Time left"/>
                                        <field name="access_remaining"/>
                                    </div>
                                </t>
                            </div>

                            <!-- Action buttons -->
                            <div class="ssh-card-actions">
                                <t t-if="record.state.raw_value == 'approved' and record.is_connectable.raw_value">
                                    <button name="action_connect" type="object"
                                            class="ssh-card-btn ssh-card-btn-terminal">
                                        <i class="fa fa-terminal"/> Terminal
                                    </button>
                                    <button name="action_connect_sftp" type="object"
                                            class="ssh-card-btn ssh-card-btn-files">
                                        <i class="fa fa-folder-open"/> Files
                                    </button>
                                </t>
                                <t t-if="record.state.raw_value == 'draft'">
                                    <button name="action_submit" type="object"
                                            class="ssh-card-btn ssh-card-btn-submit">
                                        <i class="fa fa-paper-plane"/> Submit Request
                                    </button>
                                </t>
                                <t t-if="record.state.raw_value == 'approved' and !record.is_connectable.raw_value">
                                    <div class="ssh-card-btn ssh-card-btn-disabled">
                                        <i class="fa fa-clock-o"/> Outside Access Window
                                    </div>
                                </t>
                                <t t-if="record.state.raw_value == 'submitted'">
                                    <div class="ssh-card-btn ssh-card-btn-disabled">
                                        <i class="fa fa-hourglass"/> Awaiting Approval
                                    </div>
                                </t>
                                <t t-if="['rejected', 'expired', 'revoked'].includes(record.state.raw_value)">
                                    <div class="ssh-card-btn ssh-card-btn-disabled">
                                        <i class="fa fa-ban"/> Access Unavailable
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- REJECT WIZARD                                                -->
    <!-- ============================================================ -->

    <record id="view_ssh_reject_wizard_form" model="ir.ui.view">
        <field name="name">ssh.reject.wizard.form</field>
        <field name="model">ssh.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Enter reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- MENU ITEMS                                                   -->
    <!-- ============================================================ -->

    <menuitem id="menu_ssh_terminal_root" name="SSH Terminal" sequence="100"
              groups="ssh_terminal.group_ssh_user"/>

    <menuitem id="menu_ssh_my_requests" name="My Access Requests"
              parent="menu_ssh_terminal_root"
              action="action_ssh_access_request_user"
              sequence="10"/>

    <menuitem id="menu_ssh_pending_approvals" name="Pending Approvals"
              parent="menu_ssh_terminal_root"
              action="action_ssh_access_request_manager"
              groups="ssh_terminal.group_ssh_manager"
              sequence="20"/>

    <menuitem id="menu_ssh_admin" name="Administration"
              parent="menu_ssh_terminal_root"
              groups="ssh_terminal.group_ssh_admin"
              sequence="50"/>

    <menuitem id="menu_ssh_servers" name="Servers"
              parent="menu_ssh_admin"
              action="action_ssh_server"
              sequence="10"/>

    <menuitem id="menu_ssh_all_requests" name="All Requests"
              parent="menu_ssh_admin"
              action="action_ssh_access_request_all"
              sequence="20"/>

    <menuitem id="menu_ssh_connection_logs" name="Connection Logs"
              parent="menu_ssh_admin"
              action="action_ssh_connection_log"
              sequence="30"/>

</odoo>