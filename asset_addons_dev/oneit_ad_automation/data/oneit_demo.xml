        <!-- ================================================================
             TEAMS

             Finance and Engineering also list the admin user as both Team
             Lead and BU Head, so a single logged-in admin can walk both
             approval stages without switching users.
             ================================================================ -->

        <record id="demo_team_finance" model="oneit.team">
            <field name="name">Finance</field>
            <field name="code">FIN</field>
            <field name="description">Finance and accounts</field>
            <field name="ad_group_ids" eval="[(6, 0, [
                ref('demo_adg_fin_ou'),
                ref('demo_adg_fin_citrix_erp'),
                ref('demo_adg_fin_citrix_bi'),
                ref('demo_adg_fin_fs_accounts'),
                ref('demo_adg_fin_fs_payroll')])]"/>
            <field name="team_lead_ids" eval="[(6, 0, [
                ref('base.user_admin'), ref('demo_user_tl_finance')])]"/>
            <field name="bu_head_ids" eval="[(6, 0, [
                ref('base.user_admin'), ref('demo_user_bu_1')])]"/>
        </record>

        <record id="demo_team_engineering" model="oneit.team">
            <field name="name">Engineering</field>
            <field name="code">ENG</field>
            <field name="description">Product engineering</field>
            <field name="ad_group_ids" eval="[(6, 0, [
                ref('demo_adg_eng_ou'),
                ref('demo_adg_eng_citrix_dev'),
                ref('demo_adg_eng_fs_source'),
                ref('demo_adg_eng_fs_builds')])]"/>
            <field name="team_lead_ids" eval="[(6, 0, [
                ref('base.user_admin'), ref('demo_user_tl_eng')])]"/>
            <field name="bu_head_ids" eval="[(6, 0, [
                ref('base.user_admin'), ref('demo_user_bu_1')])]"/>
        </record>

