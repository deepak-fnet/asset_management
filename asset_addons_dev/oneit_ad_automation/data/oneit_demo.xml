                ref('demo_adg_sls_citrix_crm'),
                ref('demo_adg_sls_fs_proposals')])]"/>
            <field name="team_lead_ids" eval="[(6, 0, [ref('demo_user_tl_finance')])]"/>
            <field name="bu_head_ids" eval="[(6, 0, [ref('demo_user_bu_1')])]"/>
