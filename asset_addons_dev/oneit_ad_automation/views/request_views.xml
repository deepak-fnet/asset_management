<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_oneit_request_tree" model="ir.ui.view">
        <field name="name">oneit.request.list</field>
        <field name="model">oneit.request</field>
        <field name="arch" type="xml">
            <list string="Requests"
                  decoration-muted="state == 'rejected'"
                  decoration-success="state == 'done'"
                  decoration-warning="state in ('pending', 'tl_approved')">
                <field name="name"/>
                <field name="request_type"/>
                <field name="employee_ref"/>
                <field name="employee_name"/>
                <field name="team_id"/>
                <field name="submitted_by_id" optional="show"/>
                <field name="submitted_on" optional="hide"/>
                <field name="last_working_day" optional="hide"/>
                <field name="scheduled_delete_date" optional="hide"/>
                <field name="approval_stage_label" string="Waiting On" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_oneit_request_form" model="ir.ui.view">
        <field name="name">oneit.request.form</field>
        <field name="model">oneit.request</field>
        <field name="arch" type="xml">
            <form string="AD Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight"
                            invisible="not can_approve"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="not can_approve"
                            confirm="Reject this request? This cannot be undone without resetting it to draft."/>
                    <button name="action_run_now" type="object"
                            string="Run AD Action Now"
                            groups="oneit_ad_automation.group_oneit_it_admin"
                            invisible="state not in ['approved', 'ready_to_delete'] or request_type == 'onboarding'"
                            confirm="Run the Active Directory action for this request immediately, without waiting for the scheduled job?"/>
                    <button name="action_revert" type="object" string="Revert"
                            groups="oneit_ad_automation.group_oneit_it_admin"
                            invisible="request_type != 'offboarding' or state not in ['pending', 'tl_approved', 'approved', 'ready_to_delete']"
                            confirm="Revert this offboarding?"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft" invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,tl_approved,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="can_approve" invisible="1"/>
                    <group>
                        <group string="Request">
                            <field name="request_type"
                                   readonly="state != 'draft'"/>
                            <field name="team_id"
                                   readonly="state not in ['draft']"/>
                            <field name="current_team_id"
                                   invisible="request_type != 'team_update'" readonly="state != 'draft'"/>
                            <field name="skip_team_lead"
                                   readonly="state != 'draft'"/>
                            <field name="approval_stage_label"
                                   invisible="not approval_stage_label"/>
                        </group>
                        <group string="Employee">
                            <field name="employee_ref"
                                   readonly="state != 'draft'"/>
                            <field name="employee_name"
                                   readonly="state != 'draft'"/>
                            <field name="employee_email" widget="email"
                                   readonly="state != 'draft'"/>
                            <field name="employee_phone"
                                   invisible="request_type == 'team_update'"
                                   readonly="state != 'draft'"/>
                            <field name="date_of_joining"
                                   invisible="request_type != 'onboarding'" readonly="state != 'draft'"/>
                            <field name="last_working_day"
                                   invisible="request_type != 'offboarding'" readonly="state not in ['draft', 'pending']" required="request_type == 'offboarding'"/>
                            <field name="scheduled_delete_date"
                                   invisible="request_type != 'offboarding'"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert"
                         invisible="state != 'pending' or not can_approve">
                        You are the <strong>Team Lead</strong> approver. Trim the
                        AD Access list below to exactly what this employee should
                        get - including one AD Folder group - then click Approve.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'tl_approved' or not can_approve">
                        You are the <strong>BU Head</strong> approver. Approving
                        will apply the change in Active Directory.
                    </div>

                    <group string="Rejection Reason"
                           invisible="not can_approve">
                        <field name="rejection_reason" nolabel="1"
                               placeholder="Optional - shown to the requester if you reject."/>
                    </group>

                    <notebook>
                        <page string="AD Access" name="access"
                              invisible="request_type == 'offboarding'">
                            <field name="available_ad_group_ids" invisible="1"/>
                            <field name="can_edit_ad_access" invisible="1"/>
                            <field name="ad_group_ids" widget="many2many"
                                   domain="[('id', 'in', available_ad_group_ids)]"
                                   readonly="state not in ['draft', 'pending'] or not can_edit_ad_access">
                                <list>
                                    <field name="name"/>
                                    <field name="group_type"/>
                                    <field name="distinguished_name"/>
                                </list>
                            </field>
                            <group>
                                <field name="ad_folder_group_id"/>
                            </group>
                        </page>
                        <page string="Approvals" name="approvals">
                            <field name="approval_ids" readonly="1">
                                <list decoration-success="state == 'approved'"
                                      decoration-danger="state == 'rejected'"
                                      decoration-muted="state == 'skipped'">
                                    <field name="approver_role"/>
                                    <field name="approver_id"/>
                                    <field name="state"/>
                                    <field name="acted_on"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Execution" name="execution">
                            <group>
                                <group>
                                    <field name="submitted_by_id"/>
                                    <field name="submitted_on"/>
                                </group>
                                <group>
                                    <field name="ad_user_dn"/>
                                    <field name="disabled_on"
                                           invisible="not disabled_on"/>
                                    <field name="executed_on"/>
                                </group>
                            </group>
                            <group string="Rejection Reason"
                                   invisible="state != 'rejected'">
                                <field name="rejection_reason" nolabel="1" readonly="1"/>
                            </group>
                            <group string="Log">
                                <field name="execution_log" nolabel="1" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_oneit_request_search" model="ir.ui.view">
        <field name="name">oneit.request.search</field>
        <field name="model">oneit.request</field>
        <field name="arch" type="xml">
            <search string="Requests">
                <field name="name"/>
                <field name="employee_ref"/>
                <field name="employee_name"/>
                <field name="team_id"/>
                <field name="submitted_by_id"/>
                <filter name="filter_onboarding" string="Onboarding"
                        domain="[('request_type', '=', 'onboarding')]"/>
                <filter name="filter_team_update" string="Team Update"
                        domain="[('request_type', '=', 'team_update')]"/>
                <filter name="filter_offboarding" string="Offboarding"
                        domain="[('request_type', '=', 'offboarding')]"/>
                <separator/>
                <filter name="filter_to_approve" string="Awaiting My Approval"
                        domain="[('can_approve', '=', True)]"/>
                <filter name="filter_open" string="In Progress"
                        domain="[('state', 'in', ('pending', 'tl_approved', 'approved', 'ready_to_delete'))]"/>
                <filter name="filter_done" string="Done"
                        domain="[('state', '=', 'done')]"/>
                <filter name="filter_rejected" string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="filter_my_requests" string="My Requests"
                        domain="[('submitted_by_id', '=', uid)]"/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter name="group_by_type" string="Request Type"-->
<!--                            context="{'group_by': 'request_type'}"/>-->
<!--                    <filter name="group_by_state" string="Status"-->
<!--                            context="{'group_by': 'state'}"/>-->
<!--                    <filter name="group_by_team" string="Team"-->
<!--                            context="{'group_by': 'team_id'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <!-- All requests -->
    <record id="action_oneit_request" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">oneit.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Raise your first request</p>
            <p>Onboarding creates an AD user. Team Update moves an existing user's
               access. Offboarding disables and later deletes the account.</p>
        </field>
    </record>

    <!-- Onboarding -->
    <record id="action_oneit_request_onboarding" model="ir.actions.act_window">
        <field name="name">Onboarding</field>
        <field name="res_model">oneit.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('request_type', '=', 'onboarding')]</field>
        <field name="context">{'default_request_type': 'onboarding'}</field>
    </record>

    <!-- Team update / reassign -->
    <record id="action_oneit_request_team_update" model="ir.actions.act_window">
        <field name="name">Existing User Access</field>
        <field name="res_model">oneit.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('request_type', '=', 'team_update')]</field>
        <field name="context">{'default_request_type': 'team_update'}</field>
    </record>

    <!-- Offboarding -->
    <record id="action_oneit_request_offboarding" model="ir.actions.act_window">
        <field name="name">Offboarding</field>
        <field name="res_model">oneit.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('request_type', '=', 'offboarding')]</field>
        <field name="context">{'default_request_type': 'offboarding'}</field>
    </record>

    <!-- My approval queue: the equivalent of the Django Pending Requests page -->
    <record id="action_oneit_request_my_approvals" model="ir.actions.act_window">
        <field name="name">My Approvals</field>
        <field name="res_model">oneit.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('can_approve', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting on you</p>
            <p>Requests appear here when they reach a stage you are an approver for.</p>
        </field>
    </record>

</odoo>
