<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_oneit_ad_group_tree" model="ir.ui.view">
        <field name="name">oneit.ad.group.list</field>
        <field name="model">oneit.ad.group</field>
        <field name="arch" type="xml">
            <list string="AD Groups">
                <field name="name"/>
                <field name="group_type"/>
                <field name="distinguished_name"/>
                <field name="description" optional="hide"/>
                <field name="team_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_oneit_ad_group_form" model="ir.ui.view">
        <field name="name">oneit.ad.group.form</field>
        <field name="model">oneit.ad.group</field>
        <field name="arch" type="xml">
            <form string="AD Group">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. FIN-Citrix-Apps"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="group_type"/>
                            <field name="description"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="distinguished_name"
                                   placeholder="OU=Finance,OU=Users,DC=example,DC=local"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="group_type != 'ad_folder'">
                        An <strong>AD Folder</strong> is the OU the user object itself is
                        created in or moved to. Each team must have exactly one.
                    </div>
                    <group string="Used By">
                        <field name="team_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_oneit_ad_group_search" model="ir.ui.view">
        <field name="name">oneit.ad.group.search</field>
        <field name="model">oneit.ad.group</field>
        <field name="arch" type="xml">
            <search string="AD Groups">
                <field name="name"/>
                <field name="distinguished_name"/>
                <field name="team_ids"/>
                <filter name="filter_ad_folder" string="AD Folder"
                        domain="[('group_type', '=', 'ad_folder')]"/>
                <filter name="filter_citrix" string="Citrix"
                        domain="[('group_type', '=', 'citrix')]"/>
                <filter name="filter_file_server" string="File Server"
                        domain="[('group_type', '=', 'file_server')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter name="group_by_type" string="Type"-->
<!--                            context="{'group_by': 'group_type'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <record id="action_oneit_ad_group" model="ir.actions.act_window">
        <field name="name">AD Groups</field>
        <field name="res_model">oneit.ad.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first AD group</p>
            <p>Register the OUs and security groups that make up your teams'
               access footprint: one <b>AD Folder</b> per team plus its
               <b>Citrix</b> and <b>File Server</b> groups.</p>
        </field>
    </record>

</odoo>
