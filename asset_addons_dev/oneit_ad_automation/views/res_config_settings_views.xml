<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Odoo 17 rebuilt the settings page around semantic tags. The old
        markup - xpath onto //div[hasclass('settings')] then hand-rolled
        o_setting_box / o_setting_left_pane / o_setting_right_pane divs -
        no longer has an anchor to attach to, because those wrapper divs
        are generated by the <setting> tag itself now.

        New structure:
            <app>     one per module, becomes a left-hand entry
              <block> a titled section within it
                <setting> one row; renders its own label, help text and
                          the checkbox/field layout
    -->
    <record id="view_oneit_res_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.oneit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="OneIT AD Automation"
                     string="OneIT AD Automation"
                     name="oneit_ad_automation"
                     groups="oneit_ad_automation.group_oneit_it_admin">

                    <block title="Mode">
                        <setting help="No LDAP calls are made. AD operations are written to the server log and reported as successful, so the approval workflow can be tested end to end.">
                            <field name="oneit_ad_simulate"/>
                        </setting>
                    </block>

                    <block title="Active Directory Connection">
                        <setting string="LDAP Server URI"
                                 help="Host and port of the domain controller. Use ldaps:// on 636 for an encrypted connection.">
                            <field name="oneit_ad_server_uri"
                                   placeholder="ldaps://10.4.10.10:636"/>
                        </setting>
                        <setting help="Must match the scheme above: ticked for ldaps://, unticked for ldap://.">
                            <field name="oneit_ad_use_ssl"/>
                        </setting>
                        <setting string="Bind DN"
                                 help="Full distinguished name of the service account Odoo authenticates as.">
                            <field name="oneit_ad_bind_dn"
                                   placeholder="CN=svc-odoo,OU=Service,DC=example,DC=local"/>
                        </setting>
                        <setting string="Bind Password">
                            <field name="oneit_ad_bind_password" password="True"/>
                        </setting>
                        <setting string="Base DN"
                                 help="Root of the list the module searches under.">
                            <field name="oneit_ad_base_dn"
                                   placeholder="DC=example,DC=local"/>
                        </setting>
                        <setting string="AD Domain"
                                 help="Used to build the userPrincipalName, e.g. jsmith@example.local.">
                            <field name="oneit_ad_domain"
                                   placeholder="example.local"/>
                        </setting>
                        <setting string="Connection Test"
                                 help="Binds to the server with the credentials above. Reports success without contacting AD while simulation mode is on.">
                            <button name="action_oneit_test_ad_connection"
                                    type="object" string="Test Connection"
                                    class="btn-link" icon="fa-plug"/>
                        </setting>
                    </block>

                    <block title="Workflow">
                        <setting string="Default New-User Password"
                                 help="Stamped on every account this module creates. Must satisfy the domain password policy.">
                            <field name="oneit_ad_default_password"/>
                        </setting>
                        <setting string="Deletion Delay (days)"
                                 help="How long an offboarded account stays disabled before it is deleted. Deletion is irreversible.">
                            <field name="oneit_ad_retention_days"/>
                        </setting>
                        <setting string="Max Onboarding Per Day"
                                 help="Guard against a bad import creating hundreds of accounts.">
                            <field name="oneit_ad_max_daily_onboarding"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

<record id="action_oneit_config_settings" model="ir.actions.act_window">
    <field name="name">Settings</field>
    <field name="res_model">res.config.settings</field>
    <field name="view_mode">form</field>
    <field name="context">{'module': 'oneit_ad_automation'}</field>
</record>
</odoo>