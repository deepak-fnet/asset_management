<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Replaces asset_management's cron_check_warranty_expiry(), which
             filters on warranty_status == 'expiring' - a value that does not
             exist in that selection, so it has never matched anything.
             Disable that one under Settings > Technical > Scheduled Actions. -->
        <record id="cron_warranty_expiry" model="ir.cron">
            <field name="name">Warranty: expiry alerts</field>
            <field name="model_id" ref="asset_management.model_asset_asset"/>
            <field name="state">code</field>
            <field name="code">model.cron_warranty_expiry_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_license_expiry" model="ir.cron">
            <field name="name">License: expiry alerts</field>
            <field name="model_id" ref="model_asset_license"/>
            <field name="state">code</field>
            <field name="code">model.cron_license_expiry_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
