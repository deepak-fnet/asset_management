<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<record id="view_last_grn_wizard_form" model="ir.ui.view">
    <field name="name">last.grn.wizard.form</field>
    <field name="model">last.grn.wizard</field>
    <field name="arch" type="xml">
        <form string="Last 3 GRN Details">
            <sheet>
                <group>
                    <field name="product_id" readonly="1"/>
                </group>

                <field name="html_data" nolabel="1" readonly="1"/>
            </sheet>

            <footer>
                <button string="Close" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
</odoo>