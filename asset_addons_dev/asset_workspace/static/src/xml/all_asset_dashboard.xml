<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="asset_workspace.AllAssetDashboard">
    <div class="o_all_asset_dashboard">

        <!-- Hero -->
        <div class="oaad-hero">
            <div class="oaad-hero-l">
                <span class="oaad-hi"><t t-esc="greeting"/> 👋</span>
                <h1>All Asset Dashboard</h1>
                <span class="oaad-sub">Register health, distribution and risk across your assets</span>
            </div>
            <t t-if="!state.loading">
                <div class="oaad-hero-n oaad-clickable" t-on-click="openAllAssets" title="Open every asset">
                    <b data-count="0" t-att-data-count="state.kpis.total_assets || 0" t-esc="state.kpis.total_assets || 0"/>
                    <span>assets in register</span>
                    <em>worth <strong t-esc="money(state.kpis.worth)"/></em>
                </div>
                <div t-att-class="'oaad-hero-q ' + qualityTone">
                    <div class="oaad-ring" t-att-style="'--p:' + quality">
                        <b><t t-esc="quality"/><small>%</small></b>
                    </div>
                    <div class="oaad-hero-qt">
                        <span>Data quality</span>
                        <a t-if="nextFix" href="#" t-on-click.prevent="() => this.openRisk(nextFix.key)">
                            Fix next: <strong t-esc="nextFix.label"/> (<t t-esc="nextFix.count"/>) <i class="fa fa-arrow-right"/>
                        </a>
                        <em t-else="">Register is complete 🎉</em>
                    </div>
                </div>
            </t>
            <button class="oaad-refresh" t-on-click="onRefresh" title="Refresh">
                <i t-att-class="'fa fa-refresh' + (state.loading ? ' fa-spin' : '')"/>
            </button>
        </div>

        <!-- Filters -->
        <div class="oaad-filters">
            <i class="fa fa-sliders oaad-filters-ico"/>
            <div class="oaad-filter">
                <label>Department</label>
                <div class="oaad-m2o">
                    <input type="text" class="o_input" t-att-list="'oaad_dl_department_id'" placeholder="Any"
                           t-att-value="state.filterText.department_id"
                           t-on-change="(ev) => this.onFilterText('department_id', ev)"/>
                    <i t-if="state.filterText.department_id" class="fa fa-times oaad-m2o-clear" t-on-click="() => this.clearFilterText('department_id')"/>
                    <datalist t-att-id="'oaad_dl_department_id'">
                        <t t-foreach="state.filterOptions.departments" t-as="opt" t-key="opt.id"><option t-att-value="opt.name"/></t>
                    </datalist>
                </div>
            </div>
            <div class="oaad-filter" t-if="state.filterOptions.plants.length">
                <label>Plant</label>
                <div class="oaad-m2o">
                    <input type="text" class="o_input" t-att-list="'oaad_dl_plant_id'" placeholder="Any"
                           t-att-value="state.filterText.plant_id"
                           t-on-change="(ev) => this.onFilterText('plant_id', ev)"/>
                    <i t-if="state.filterText.plant_id" class="fa fa-times oaad-m2o-clear" t-on-click="() => this.clearFilterText('plant_id')"/>
                    <datalist t-att-id="'oaad_dl_plant_id'">
                        <t t-foreach="state.filterOptions.plants" t-as="opt" t-key="opt.id"><option t-att-value="opt.name"/></t>
                    </datalist>
                </div>
            </div>
            <div class="oaad-filter">
                <label>Location</label>
                <div class="oaad-m2o">
                    <input type="text" class="o_input" t-att-list="'oaad_dl_location_id'" placeholder="Any"
                           t-att-value="state.filterText.location_id"
                           t-on-change="(ev) => this.onFilterText('location_id', ev)"/>
                    <i t-if="state.filterText.location_id" class="fa fa-times oaad-m2o-clear" t-on-click="() => this.clearFilterText('location_id')"/>
                    <datalist t-att-id="'oaad_dl_location_id'">
                        <t t-foreach="state.filterOptions.locations" t-as="opt" t-key="opt.id"><option t-att-value="opt.name"/></t>
                    </datalist>
                </div>
            </div>
            <div class="oaad-filter">
                <label>Status</label>
                <select t-on-change="(ev) => this.onFilterChange('state', ev)">
                    <option value="">All</option>
                    <t t-foreach="state.filterOptions.states" t-as="s" t-key="s.value">
                        <option t-att-value="s.value" t-esc="s.label" t-att-selected="state.filters.state == s.value"/>
                    </t>
                </select>
            </div>
            <div class="oaad-filter">
                <label title="Purchase / acquisition date from">Acquired from</label>
                <input type="date" t-att-value="state.filters.date_from" t-on-change="(ev) => this.onFilterChange('date_from', ev)"/>
            </div>
            <div class="oaad-filter">
                <label title="Purchase / acquisition date to">to</label>
                <input type="date" t-att-value="state.filters.date_to" t-on-change="(ev) => this.onFilterChange('date_to', ev)"/>
            </div>
            <div class="oaad-filter-actions">
                <button class="btn btn-primary" t-on-click="onApply"><i class="fa fa-check"/> Apply</button>
                <button class="btn btn-link" t-on-click="onClear">Clear</button>
            </div>
        </div>

        <div t-if="state.loading" class="oaad-loading">
            <div class="oaad-skel"/><div class="oaad-skel"/><div class="oaad-skel"/>
        </div>

        <t t-else="">
            <!-- Status bar -->
            <div class="oaad-statebar" t-if="stateSegments.length">
                <div class="oaad-statebar-track">
                    <t t-foreach="stateSegments" t-as="seg" t-key="seg.label">
                        <i t-att-style="'flex:' + seg.count + ';background:' + seg.colour"
                           t-att-title="seg.label + ': ' + seg.count"/>
                    </t>
                </div>
                <div class="oaad-statebar-legend">
                    <t t-foreach="stateSegments" t-as="seg" t-key="seg.label">
                        <span><i t-att-style="'background:' + seg.colour"/><t t-esc="seg.label"/> <b t-esc="seg.count"/>
                            <small><t t-esc="pctOf(seg.count, state.kpis.total_assets)"/>%</small></span>
                    </t>
                </div>
            </div>

            <!-- KPI chips -->
            <div class="oaad-kpis">
                <div class="oaad-k k-green"><i class="fa fa-bolt"/><b data-count="0" t-att-data-count="state.kpis.active" t-esc="state.kpis.active"/><span>Active</span></div>
                <div class="oaad-k k-amber"><i class="fa fa-hourglass-half"/><b data-count="0" t-att-data-count="state.kpis.pending_approval" t-esc="state.kpis.pending_approval"/><span>Pending approval</span></div>
                <div class="oaad-k k-indigo oaad-clickable" t-on-click="openEmployeeAssets" title="Assigned to an employee">
                    <i class="fa fa-user"/><b data-count="0" t-att-data-count="state.kpis.employee_assets" t-esc="state.kpis.employee_assets"/><span>Employee assets</span><i class="fa fa-angle-right go"/></div>
                <div class="oaad-k k-sky oaad-clickable" t-on-click="openCommonAssets" title="Assigned to a location / department, no employee">
                    <i class="fa fa-building-o"/><b data-count="0" t-att-data-count="state.kpis.common_assets" t-esc="state.kpis.common_assets"/><span>Common assets</span><i class="fa fa-angle-right go"/></div>
                <div class="oaad-k k-slate"><i class="fa fa-archive"/><b data-count="0" t-att-data-count="state.kpis.unassigned" t-esc="state.kpis.unassigned"/><span>Unassigned</span></div>
                <div class="oaad-k k-violet"><i class="fa fa-exchange"/><b data-count="0" t-att-data-count="state.kpis.under_transfer" t-esc="state.kpis.under_transfer"/><span>Under transfer</span></div>
                <div class="oaad-k k-teal"><i class="fa fa-check-square-o"/><b data-count="0" t-att-data-count="state.kpis.verification_due" t-esc="state.kpis.verification_due"/><span>Verification due</span></div>
                <div class="oaad-k k-rose"><i class="fa fa-sign-out"/><b data-count="0" t-att-data-count="state.kpis.removals_open" t-esc="state.kpis.removals_open"/><span>Removals open</span></div>
                <div class="oaad-k k-gray"><i class="fa fa-trash-o"/><b data-count="0" t-att-data-count="state.kpis.removed" t-esc="state.kpis.removed"/><span>Removed</span></div>
            </div>

            <!-- Value story -->
            <div class="oaad-value" t-if="state.insights.value and state.insights.value.cost">
                <div class="oaad-value-t">
                    <span>Paid</span><b t-esc="state.insights.value.cost_txt"/>
                </div>
                <div class="oaad-value-bar">
                    <i class="kept" t-att-style="'width:' + state.insights.value.kept_pct + '%'"><em>Book value <t t-esc="state.insights.value.book_txt"/></em></i>
                    <i class="lost" t-att-title="'Depreciated ' + state.insights.value.lost_txt"/>
                </div>
                <div class="oaad-value-t r">
                    <span>Still worth</span><b><t t-esc="state.insights.value.kept_pct"/>%</b><small class="oaad-lost">−<t t-esc="state.insights.value.lost_txt"/> depreciated</small>
                </div>
            </div>

            <!-- Needs attention -->
            <div class="oaad-panel oaad-attn" t-if="state.insights.cards.length">
                <div class="oaad-ph">
                    <h3><i class="fa fa-bell-o"/> Needs attention</h3>
                    <span t-if="state.insights.attention"><b t-esc="state.insights.attention"/> assets to look at · click a card for the list, an asset to open it</span>
                    <span t-else="">nothing urgent 🎉</span>
                </div>
                <div class="oaad-ins-grid">
                    <t t-foreach="state.insights.cards" t-as="c" t-key="c.key">
                        <div t-att-class="'oaad-ins oaad-clickable t-' + c.tone" t-on-click="() => this.openInsight(c.key)">
                            <div class="oaad-ins-h">
                                <span class="ico"><i t-att-class="'fa ' + c.icon"/></span>
                                <b data-count="0" t-att-data-count="c.count" t-esc="c.count"/>
                                <span class="lbl" t-esc="c.label"/>
                            </div>
                            <div class="story" t-if="c.story" t-esc="c.story"/>
                            <ul t-if="c.top.length">
                                <li t-foreach="c.top" t-as="a" t-key="a.id" t-on-click.stop="() => this.openAsset(a.id)">
                                    <span class="n" t-esc="a.name"/><span class="note" t-esc="a.note"/>
                                </li>
                            </ul>
                            <div t-else="" class="clear"><i class="fa fa-check-circle"/> all clear</div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Distribution -->
            <div class="oaad-grid oaad-grid-dist">
                <div class="oaad-panel">
                    <div class="oaad-ph"><h3>By status</h3></div>
                    <div class="oaad-chart-box oaad-donut" t-att-class="hasData('by_state') ? '' : 'oaad-empty'">
                        <canvas t-ref="stateChart"/>
                        <div class="oaad-donut-c" t-if="hasData('by_state')"><b t-esc="state.kpis.total_assets"/><span>assets</span></div>
                        <div t-if="!hasData('by_state')" class="oaad-empty-msg">No data for this filter</div>
                    </div>
                </div>
                <div class="oaad-panel">
                    <div class="oaad-ph"><h3>By department</h3></div>
                    <div class="oaad-chart-box" t-att-class="hasData('by_department') ? '' : 'oaad-empty'">
                        <canvas t-ref="deptChart"/>
                        <div t-if="!hasData('by_department')" class="oaad-empty-msg">No data for this filter</div>
                    </div>
                </div>
                <div class="oaad-panel" t-if="state.charts.by_location">
                    <div class="oaad-ph"><h3>By location</h3></div>
                    <div class="oaad-chart-box" t-att-class="hasData('by_location') ? '' : 'oaad-empty'">
                        <canvas t-ref="locationChart"/>
                        <div t-if="!hasData('by_location')" class="oaad-empty-msg">No data for this filter</div>
                    </div>
                </div>
            </div>

            <div class="oaad-grid oaad-grid-2">
                <div class="oaad-panel">
                    <div class="oaad-ph"><h3>Additions per month</h3><span>by acquisition date · last 12 months</span></div>
                    <div class="oaad-chart-box"><canvas t-ref="trendChart"/></div>
                </div>
                <div class="oaad-panel">
                    <div class="oaad-ph">
                        <h3>Who holds the most</h3>
                        <a href="#" class="oaad-viewall" t-on-click.prevent="openAllEmployees">View all
                            <t t-if="state.employees.total_employees">(<t t-esc="state.employees.total_employees"/>)</t> <i class="fa fa-angle-right"/></a>
                    </div>
                    <ul class="oaad-board">
                        <li t-foreach="state.employees.rows" t-as="emp" t-key="emp.id"
                            class="oaad-clickable" t-on-click="() => this.openEmployeeRow(emp.id)">
                            <span class="oaad-av" t-att-style="'background:' + avatarColour(emp_index)" t-esc="initials(emp.name)"/>
                            <div class="oaad-board-m">
                                <div><span class="n" t-esc="emp.name"/><span class="m" t-esc="medal(emp_index)"/></div>
                                <div class="oaad-bar"><i t-att-style="'width:' + pctOf(emp.count, leaderMax) + '%;background:' + avatarColour(emp_index)"/></div>
                            </div>
                            <b t-esc="emp.count"/>
                        </li>
                        <li t-if="state.employees.common" class="oaad-clickable"
                            t-on-click="() => this.openEmployeeRow('common')">
                            <span class="oaad-av" style="background:#f59e0b"><i class="fa fa-building-o"/></span>
                            <div class="oaad-board-m">
                                <div><span class="n">Common assets</span></div>
                                <div class="oaad-bar"><i t-att-style="'width:' + pctOf(state.employees.common, leaderMax) + '%;background:#f59e0b'"/></div>
                            </div>
                            <b t-esc="state.employees.common"/>
                        </li>
                        <li t-if="!state.employees.rows.length and !state.employees.common" class="oaad-empty-msg">
                            No assigned assets for this filter
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Age -->
            <div class="oaad-grid oaad-grid-2">
                <div class="oaad-panel">
                    <div class="oaad-ph"><h3>Assets by age</h3><span>click a bar to open</span></div>
                    <div class="oaad-chart-box"><canvas t-ref="ageChart"/></div>
                </div>
                <div class="oaad-panel">
                    <div class="oaad-ph"><h3>Age breakdown</h3><span>value at stake per band</span></div>
                    <div class="oaad-age">
                        <t t-foreach="state.age_profile" t-as="bucket" t-key="bucket.id">
                            <div class="oaad-age-row oaad-clickable" t-att-class="bucket.count ? '' : 'zero'" t-on-click="() => this.openBucket(bucket_index)">
                                <span class="band" t-esc="bucket.name"/>
                                <div class="oaad-bar"><i t-att-style="'width:' + pctOf(bucket.count, ageMax) + '%'"/></div>
                                <b t-esc="bucket.count"/>
                                <span class="val" t-esc="money(bucket.total_value)"/>
                                <div class="cats" t-if="bucket.breakdown.length">
                                    <t t-foreach="bucket.breakdown" t-as="b" t-key="b.name">
                                        <span class="chip"><t t-esc="b.name"/> <small t-esc="b.count"/></span>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Risk -->
            <div class="oaad-panel">
                <div class="oaad-ph"><h3>Data quality &amp; risk</h3><span>gaps and things about to expire · click to fix</span></div>
                <div class="oaad-risks">
                    <t t-foreach="state.risk" t-as="r" t-key="r.key">
                        <div t-att-class="'oaad-risk oaad-clickable' + (r.count ? ' bad' : ' good')" t-on-click="() => this.openRisk(r.key)">
                            <span class="ico"><i t-att-class="riskIcon(r.key)"/><em t-if="r.count"/></span>
                            <div class="t">
                                <b t-esc="r.count"/>
                                <span t-esc="r.label"/>
                                <div class="oaad-bar" t-if="r.count"><i t-att-style="'width:' + riskPct(r) + '%'"/></div>
                                <small t-if="r.count"><t t-esc="riskPct(r)"/>% of register</small>
                                <small t-else="" class="ok"><i class="fa fa-check"/> all clear</small>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>

    </div>
</t>

</templates>
