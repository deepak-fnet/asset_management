<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- ══════════════════════════════════════════════════════════════════
             The reorganised navigation.

             Only actions verified to exist in asset_management are referenced
             here. Anything from a module whose XML IDs cannot be confirmed is
             wired by hooks.py, which reports rather than raises if it cannot
             find them.
             ══════════════════════════════════════════════════════════════════ -->

        <!-- ── 1. All Asset Dashboard (single entry point) ────────────────── -->
        <menuitem id="asset_management.menu_asset_root"
                  name="Asset Management"
                  web_icon="asset_management,static/description/icon.png"
                  sequence="10"/>

        <menuitem id="menu_ws_all_asset_dashboard"
                  name="All Asset Dashboard"
                  parent="asset_management.menu_asset_root"
                  action="action_all_asset_dashboard"
                  sequence="1"/>

        <!-- ── 1b. All Asset - general (non-IT) assets + their own
             lifecycle screens. General Assets/Physical Verification used to
             sit under "Assets" (now "IT Assets" below) - moved out to their
             own top section since they are not IT assets at all; grouping
             them under "IT Assets" was misleading. Wired by hooks.py
             (general_asset is not a hard dependency). -->
        <menuitem id="menu_ws_all_asset"
                  name="All Asset"
                  parent="asset_management.menu_asset_root"
                  sequence="2"/>

        <!-- ── 2. Lifecycle Process ─────────────────────────────────────────
             Its own top-level app (no parent), with its own icon, rather
             than a child of "Asset Management" - so it shows as a separate
             entry in the app switcher instead of a sub-menu someone has to
             drill into Asset Management first to find. -->
        <menuitem id="menu_ws_lifecycle"
                  name="Lifecycle Process"
                  web_icon="asset_workspace,static/description/lifecycle_icon.png"
                  sequence="11"/>

        <menuitem id="menu_ws_lifecycle_join"
                  name="Joining Process"
                  parent="menu_ws_lifecycle"
                  action="asset_management.action_asset_joining_process"
                  sequence="10"/>

        <menuitem id="menu_ws_lifecycle_assign"
                  name="Assign / Replace Process"
                  parent="menu_ws_lifecycle"
                  action="asset_management.action_asset_assign_process"
                  sequence="20"/>

        <menuitem id="menu_ws_lifecycle_exit"
                  name="Exit Process"
                  parent="menu_ws_lifecycle"
                  action="asset_management.action_asset_exit_process"
                  sequence="30"/>

        <!-- Asset movement and disposal, from general_asset.
             These are NOT declared here as static menuitems: general_asset is
             not a dependency of this module, so referencing its actions
             directly would make asset_workspace fail to install wherever it
             is absent. hooks.py wires them at install time instead, and
             silently skips them when the module is not there.

             They were previously missing entirely, which is why Asset
             Transfer never appeared: this module hides
             asset_management.menu_lifecycle_root, and general_asset hangs
             its own menus underneath it - so hiding the parent hid the
             children too. -->

        <!-- ── 3. Helpdesk ────────────────────────────────────────────────
             Its own top-level app (no parent), with its own icon, same
             treatment as Lifecycle Process above - a separate entry in the
             app switcher instead of a section someone has to open Asset
             Management first to find.

             "Helpdesk" (asset_helpdesk.action_asset_helpdesk, the ticket
             list) is wired by hooks.py, since asset_helpdesk is NOT a hard
             dependency of this module. "Repair Management" is declared
             statically below instead - its action
             (asset_management.action_repair_management) lives in
             asset_management, which IS a dependency, so there is no need
             to resolve it at runtime. -->
        <menuitem id="menu_ws_helpdesk"
                  name="Helpdesk"
                  web_icon="asset_workspace,static/description/helpdesk_icon.png"
                  sequence="21"/>

        <menuitem id="menu_ws_helpdesk_repair_management"
                  name="Repair Management"
                  parent="menu_ws_helpdesk"
                  action="asset_management.action_repair_management"
                  sequence="20"/>

        <!-- Helpdesk's own Configuration - Team/Categories/Ticket Types are
             helpdesk-specific setup, so they live under this app now rather
             than the main Asset Management > Configuration menu. Their
             children are wired by hooks.py (asset_helpdesk is not a hard
             dependency). -->
        <menuitem id="menu_ws_helpdesk_config"
                  name="Configuration"
                  parent="menu_ws_helpdesk"
                  sequence="30"
                  groups="asset_management.group_asset_manager"/>

        <!-- ── 4. IT Assets (was "Assets") - agent-reported assets only,
             plus the per-platform Dashboard (asset_hub_dashboard) as its
             landing page. General/non-IT assets live under "All Asset"
             above instead - see the note there. ─────────────────────── -->
        <menuitem id="menu_ws_assets"
                  name="IT Assets"
                  parent="asset_management.menu_asset_root"
                  sequence="30"/>

        <menuitem id="menu_ws_assets_dashboard"
                  name="Dashboard"
                  parent="menu_ws_assets"
                  action="action_asset_hub_dashboard"
                  sequence="5"/>

        <menuitem id="menu_ws_assets_windows"
                  name="Windows Assets"
                  parent="menu_ws_assets"
                  action="asset_management.action_asset_asset"
                  sequence="10"/>

        <menuitem id="menu_ws_assets_linux"
                  name="Linux Assets"
                  parent="menu_ws_assets"
                  action="asset_management.action_ubuntu_asset"
                  sequence="20"/>

        <menuitem id="menu_ws_assets_mac"
                  name="macOS Assets"
                  parent="menu_ws_assets"
                  action="asset_management.action_mac_asset"
                  sequence="30"/>

        <menuitem id="menu_ws_assets_cctv"
                  name="CCTV"
                  parent="menu_ws_assets"
                  action="asset_management.action_asset_camera"
                  sequence="40"/>

        <menuitem id="menu_ws_assets_network"
                  name="Network Devices"
                  parent="menu_ws_assets"
                  action="asset_management.action_asset_network_device"
                  sequence="50"/>

        <menuitem id="menu_asset_network_device_unmanaged"
              name="Unmanaged Endpoints"
              action="asset_management.action_asset_network_device_unmanaged"
              sequence="50"
              parent="menu_ws_assets"/>

    <menuitem id="menu_asset_peripheral"
              name="Peripherals"
              parent="menu_ws_assets"
              action="asset_management.action_asset_peripheral"
              sequence="60"/>

        <!-- ── 4b. IoT Integration - iot_integration is not a hard
             dependency of this module, so both children are wired by
             hooks.py at runtime rather than referenced statically here. -->
        <menuitem id="menu_ws_iot"
                  name="IoT Integration"
                  parent="asset_management.menu_asset_root"
                  sequence="35"/>

        <!-- ── 5. Asset Request ──────────────────────────────────────────── -->
        <menuitem id="menu_ws_request"
                  name="Asset Request"
                  parent="asset_management.menu_asset_root"
                  sequence="40"/>

        <menuitem id="menu_ws_request_list"
                  name="Asset Requests"
                  parent="menu_ws_request"
                  action="asset_management.action_asset_request"
                  sequence="10"/>

        <!--    <menuitem id="menu_ws_request_po"-->
        <!--              name="Purchase Orders"-->
        <!--              parent="menu_ws_request"-->
        <!--              action="asset_management.action_asset_purchase_order"-->
        <!--              sequence="20"/>-->

        <menuitem id="menu_ws_request_assetlist"
                  name="Asset List"
                  parent="menu_ws_request"
                  action="asset_management.action_asset_list"
                  sequence="30"/>

        <!-- ── 5b. Purchase app: "Asset Requests" child menu ──────────────
             Only APPROVED asset.request records belong on the buyer's radar
             here - draft/submitted ones are still being worked out by the
             requester and cancelled/done ones are no longer actionable
             procurement. action_asset_request (used under Asset Request
             above) shows every state, so a dedicated filtered action is used
             instead of reusing it with a menu-level domain override, which
             act_window menuitems do not support. -->
        <record id="action_asset_request_approved" model="ir.actions.act_window">
            <field name="name">Asset Requests</field>
            <field name="res_model">asset.request</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '=', 'approved')]</field>
            <field name="context">{}</field>
        </record>

        <menuitem id="menu_purchase_asset_requests"
                  name="Asset Requests"
                  parent="purchase.menu_purchase_root"
                  action="action_asset_request_approved"
                  sequence="15"/>

        <!-- ── 6. Security — left exactly as-is, provided by asset_patch_vuln
                    and asset_security_console. No changes here on purpose. ── -->

        <!-- ── 7. Agent Telemetry ────────────────────────────────────────── -->
        <menuitem id="menu_ws_telemetry"
                  name="Agent Telemetry"
                  parent="asset_management.menu_asset_root"
                  sequence="60"/>

        <!-- ── 8. Configuration (children wired by hooks.py) ─────────────── -->
        <menuitem id="menu_ws_config"
                  name="Configuration"
                  parent="asset_management.menu_asset_root"
                  sequence="90"
                  groups="asset_management.group_asset_manager"/>
        <menuitem
                id="menu_product_asset_menu"
                name="Asset Products"
                action="asset_helpdesk.action_product_asset"
                parent="menu_ws_config"/>

        <menuitem id="menu_asset_location"
                  name="Locations"
                  parent="menu_ws_config"
                  action="asset_management.action_asset_location"/>

        <menuitem id="menu_asset_button_access"
                  name="Button Access Control"
                  parent="menu_ws_config"
                  action="asset_management.action_asset_button_access"
                  sequence="80"/>

    </data>
</odoo>
