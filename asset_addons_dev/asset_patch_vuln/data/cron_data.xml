<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Daily compliance snapshot. Without this the compliance trend
             chart has nothing to plot. Enabled by default — it only reads
             and writes one small row per day. -->
        <record id="cron_patch_compliance_snapshot" model="ir.cron">
            <field name="name">Patch: Daily Compliance Snapshot</field>
            <field name="model_id" ref="model_asset_patch_compliance_snapshot"/>
            <field name="state">code</field>
            <field name="code">model.cron_capture_snapshot()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
<!--            <field name="numbercall">-1</field>-->
            <field name="active" eval="True"/>
        </record>

        <!-- CVE sync from NVD. DISABLED by default because it makes
             outbound internet calls — enable once you have confirmed the
             server can reach services.nvd.nist.gov. -->
        <record id="cron_cve_sync" model="ir.cron">
            <field name="name">Vulnerability: Sync CVE Database (NVD)</field>
            <field name="model_id" ref="model_asset_cve"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_nvd()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
<!--            <field name="numbercall">-1</field>-->
            <field name="active" eval="False"/>
        </record>

        <!-- Nightly correlation scan. DISABLED by default — pointless until
             the CVE database has been populated at least once. -->
        <record id="cron_vulnerability_scan" model="ir.cron">
            <field name="name">Vulnerability: Nightly Scan</field>
            <field name="model_id" ref="model_asset_vulnerability_engine"/>
            <field name="state">code</field>
            <field name="code">model.cron_nightly_scan()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
<!--            <field name="numbercall">-1</field>-->
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
