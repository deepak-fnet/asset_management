<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_app_update_list" model="ir.ui.view">
        <field name="name">asset.app.update.list</field>
        <field name="model">asset.app.update</field>
        <field name="arch" type="xml">
            <list create="false"
                  decoration-warning="status == 'available'"
                  decoration-info="status in ('queued','updating')"
                  decoration-success="status == 'updated'"
                  decoration-danger="status == 'failed'"
                  decoration-muted="status == 'blocked'">
                <field name="asset_id"/>
                <field name="app_name"/>
                <field name="installed_version"/>
                <field name="available_version"/>
                <field name="source"/>
                <field name="status" widget="badge"/>
                <field name="detected_date" optional="hide"/>
                <field name="action_by" optional="hide"/>
                <field name="error_message" optional="hide"/>
                <button name="action_queue_update" type="object"
                        string="Update" icon="fa-arrow-circle-up"
                        invisible="status not in ('available','failed')"
                        groups="asset_management.group_asset_manager"/>
                <button name="action_block" type="object"
                        string="Block" icon="fa-ban"
                        invisible="status in ('blocked','updating')"
                        groups="asset_management.group_asset_manager"/>
                <button name="action_unblock" type="object"
                        string="Unblock" icon="fa-check"
                        invisible="status != 'blocked'"
                        groups="asset_management.group_asset_manager"/>
            </list>
        </field>
    </record>

    <record id="view_app_update_form" model="ir.ui.view">
        <field name="name">asset.app.update.form</field>
        <field name="model">asset.app.update</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_queue_update" type="object"
                            string="Queue Update" class="btn-primary"
                            invisible="status not in ('available','failed')"
                            groups="asset_management.group_asset_manager"/>
                    <button name="action_block" type="object" string="Block"
                            invisible="status in ('blocked','updating')"
                            groups="asset_management.group_asset_manager"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="available,queued,updating,updated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="app_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="1"/>
                            <field name="package_id" readonly="1"/>
                            <field name="source" readonly="1"/>
                        </group>
                        <group>
                            <field name="installed_version" readonly="1"/>
                            <field name="available_version" readonly="1"/>
                            <field name="detected_date" readonly="1"/>
                            <field name="first_detected_date" readonly="1"/>
                            <field name="action_by" readonly="1"/>
                            <field name="action_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_app_update_search" model="ir.ui.view">
        <field name="name">asset.app.update.search</field>
        <field name="model">asset.app.update</field>
        <field name="arch" type="xml">
            <search>
                <field name="app_name"/>
                <field name="asset_id"/>
                <filter name="f_available" string="Update Available"
                        domain="[('status','=','available')]"/>
                <filter name="f_queued" string="Queued / Updating"
                        domain="[('status','in',('queued','updating'))]"/>
                <filter name="f_failed" string="Failed"
                        domain="[('status','=','failed')]"/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter name="g_asset" string="Asset"-->
<!--                            context="{'group_by':'asset_id'}"/>-->
<!--                    <filter name="g_app" string="Application"-->
<!--                            context="{'group_by':'app_name'}"/>-->
<!--                    <filter name="g_status" string="Status"-->
<!--                            context="{'group_by':'status'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <record id="action_app_update" model="ir.actions.act_window">
        <field name="name">Application Updates</field>
        <field name="res_model">asset.app.update</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_app_update_search"/>
        <field name="context">{'search_default_f_available': 1, 'search_default_g_asset': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No application updates detected</p>
            <p>
                This list is populated by the agent running
                <code>winget upgrade</code> (Windows), <code>apt list --upgradable</code>
                (Linux) or <code>brew outdated</code> (macOS).
                If it stays empty, the agent snippet has not been deployed yet.
            </p>
        </field>
    </record>

</odoo>
