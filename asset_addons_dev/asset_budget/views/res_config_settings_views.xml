<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_asset_budget" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.asset.budget</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="Budget" name="asset_budget">
                    <setting string="Over Budget" help="When a request's RFQ / order is over its category + department budget on Submit for Approval">
                        <field name="budget_exceed_mode" widget="radio"/>
                    </setting>
                    <setting string="Budget Approver" help="Signs off last when an order is over budget"
                             invisible="budget_exceed_mode == 'block'">
                        <field name="budget_approver_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
