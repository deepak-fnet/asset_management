<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rules normally fire the moment telemetry arrives. This sweep
             exists so a newly created or edited rule does not appear broken
             for up to 15 minutes while waiting for the next report. -->
        <record id="cron_evaluate_telemetry_alerts" model="ir.cron">
            <field name="name">Telemetry: Evaluate Alert Rules</field>
            <field name="model_id" ref="model_asset_telemetry_alert_engine"/>
            <field name="state">code</field>
            <field name="code">model.cron_evaluate_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
<!--            <field name="numbercall">-1</field>-->
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
