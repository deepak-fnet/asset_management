<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_telemetry_alert_log_list" model="ir.ui.view">
        <field name="name">asset.telemetry.alert.log.list</field>
        <field name="model">asset.telemetry.alert.log</field>
        <field name="arch" type="xml">
            <list create="false"
                  decoration-danger="severity == 'critical' and state == 'active'"
                  decoration-warning="severity == 'warning' and state == 'active'"
                  decoration-success="state == 'recovered'"
                  decoration-muted="state == 'muted'">
                <field name="asset_id"/>
                <field name="rule_id"/>
                <field name="json_path" optional="show"/>
                <field name="observed_value"/>
                <field name="threshold_value" optional="show"/>
                <field name="severity" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="occurrence_count" string="Seen"/>
                <field name="mail_sent_count" string="Mails"/>
                <field name="first_seen"/>
                <field name="last_seen" optional="hide"/>
                <field name="recovered_at" optional="hide"/>
                <button name="action_mute" type="object" string="Mute"
                        icon="fa-bell-slash" invisible="state != 'active'"/>
                <button name="action_unmute" type="object" string="Unmute"
                        icon="fa-bell" invisible="state != 'muted'"/>
            </list>
        </field>
    </record>

    <record id="view_telemetry_alert_log_form" model="ir.ui.view">
        <field name="name">asset.telemetry.alert.log.form</field>
        <field name="model">asset.telemetry.alert.log</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_open_asset" type="object"
                            string="Open Asset" class="btn-primary"/>
                    <button name="action_mute" type="object" string="Mute"
                            invisible="state != 'active'"/>
                    <button name="action_unmute" type="object" string="Unmute"
                            invisible="state != 'muted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,recovered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="1"/>
                            <field name="rule_id" readonly="1"/>
                            <field name="json_path" readonly="1"/>
                            <field name="severity" widget="badge" readonly="1"/>
                        </group>
                        <group>
                            <field name="observed_value" readonly="1"/>
                            <field name="threshold_value" readonly="1"/>
                            <field name="occurrence_count" readonly="1"/>
                            <field name="mail_sent_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Timeline">
                        <group>
                            <field name="first_seen" readonly="1"/>
                            <field name="last_seen" readonly="1"/>
                        </group>
                        <group>
                            <field name="recovered_at" readonly="1"/>
                            <field name="last_mail_sent" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telemetry_alert_log_search" model="ir.ui.view">
        <field name="name">asset.telemetry.alert.log.search</field>
        <field name="model">asset.telemetry.alert.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <field name="rule_id"/>
                <filter name="f_active" string="Active"
                        domain="[('state','=','active')]"/>
                <filter name="f_recovered" string="Recovered"
                        domain="[('state','=','recovered')]"/>
                <filter name="f_muted" string="Muted"
                        domain="[('state','=','muted')]"/>
                <separator/>
                <filter name="f_critical" string="Critical"
                        domain="[('severity','=','critical')]"/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter name="g_asset" string="Asset"-->
<!--                            context="{'group_by':'asset_id'}"/>-->
<!--                    <filter name="g_rule" string="Rule"-->
<!--                            context="{'group_by':'rule_id'}"/>-->
<!--                    <filter name="g_state" string="State"-->
<!--                            context="{'group_by':'state'}"/>-->
<!--                    <filter name="g_sev" string="Severity"-->
<!--                            context="{'group_by':'severity'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <record id="action_telemetry_alert_log" model="ir.actions.act_window">
        <field name="name">Telemetry Alerts</field>
        <field name="res_model">asset.telemetry.alert.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_telemetry_alert_log_search"/>
        <field name="context">{'search_default_f_active': 1}</field>
    </record>

    <!-- Evaluate-now button on the asset's telemetry tab -->
    <record id="view_asset_form_alert_button" model="ir.ui.view">
        <field name="name">asset.asset.form.alert.button</field>
        <field name="model">asset.asset</field>
        <field name="inherit_id" ref="asset_telemetry.view_asset_form_telemetry"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='agent_telemetry']//group[2]" position="inside">
                <button name="action_evaluate_alerts_now" type="object"
                        string="Evaluate Alert Rules Now" class="btn-link"
                        groups="asset_management.group_asset_manager"/>
            </xpath>
        </field>
    </record>

</odoo>
