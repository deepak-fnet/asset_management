<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 1) Daily reminder to Accounts for pending expense payments -->
        <record id="ir_cron_expense_payment_reminder" model="ir.cron">
            <field name="name">Expense: Daily Payment Reminder to Accounts</field>
            <field name="model_id" ref="hr_expense.model_hr_expense"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_payment_reminder_to_accounts()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 2) Daily reminder to employees for pending advance settlement -->
        <record id="ir_cron_advance_settlement_reminder" model="ir.cron">
            <field name="name">Advance Payment: Daily Settlement Reminder to Employees</field>
            <field name="model_id" ref="model_advance_payment"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_settlement_reminder_to_employees()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 3) Daily reminder to Accounts for advance/expense mismatches -->
        <record id="ir_cron_settlement_summary_billing" model="ir.cron">
            <field name="name">Settlement Summary to Billing</field>
            <field name="model_id" ref="model_advance_payment_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_settlement_summary_to_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_finance_reminder" model="ir.cron">
            <field name="name">Finance Reminder - Approved Advances</field>
            <field name="model_id" ref="model_advance_payment"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_finance_approval_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>