<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard View -->
    <record id="view_hr_expense_dashboard" model="ir.ui.view">
        <field name="name">hr.expense.dashboard.view</field>
        <field name="model">hr.expense.dashboard</field>
        <field name="arch" type="xml">
            <form string="Expense Dashboard" create="false" edit="false">
                <sheet>
                    <div class="o_expense_dashboard">
                        <!-- Dashboard will be rendered by JavaScript -->
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_hr_expense_dashboard" model="ir.actions.client">
        <field name="name">Expense Dashboard</field>
        <field name="tag">hr_expense_dashboard</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_hr_expense_dashboard"
              name="Expenses Dashboard"
              parent="hr_expense.menu_hr_expense_root"
              action="action_hr_expense_dashboard"
              sequence="1"/>

    <record id="hr_expense.hr_expense_actions_my_all" model="ir.actions.act_window">
    <field name="context">{}</field>
</record>

<menuitem id="hr_expense.menu_hr_expense_my_expenses_all"
          sequence="2"
          parent="hr_expense.menu_hr_expense_root"
          action="hr_expense.hr_expense_actions_my_all"
          name="My Expenses"/>

<record id="hr_expense.menu_hr_expense_my_expenses" model="ir.ui.menu">
    <field name="active" eval="False"/>
</record>
</odoo>