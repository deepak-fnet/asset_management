<odoo>

    <record id="advance_payment_rule_manager" model="ir.rule">
    <field name="name">Advance Payment - Manager</field>
    <field name="model_id" ref="model_advance_payment"/>
    <field name="domain_force">
        [
            '&amp;',
                ('company_id', 'in', user.company_ids.ids),
                '&amp;',
                    ('is_created_by_user', '=', True),
                    '|',
                        ('user_id', '=', user.id),
                        ('employee_id', 'child_of', user.employee_id.id)
        ]
    </field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
</record>
    <record id="advance_payment_rule_billing" model="ir.rule">
    <field name="name">Advance Payment - Billing Full Access</field>
    <field name="model_id" ref="model_advance_payment"/>
    <field name="domain_force">
        [
            ('company_id', 'in', user.company_ids.ids)
        ]
    </field>
    <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
</record>
</odoo>