<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════
         Standalone List view for Compliance Alerts
    ══════════════════════════════════════════════════════ -->
    <record id="view_account_move_compliance_list" model="ir.ui.view">
        <field name="name">account.move.compliance.list</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Compliance Alerts"
                  create="false"
                  decoration-danger="compliance_days_overdue &gt;= 180"
                  decoration-warning="compliance_days_overdue &gt;= 45 and compliance_days_overdue &lt; 180">
                <field name="name" string="Bill Number"/>
                <field name="partner_id" string="Vendor"/>
                <field name="invoice_date" string="Bill Date"/>
                <field name="compliance_days_overdue_str" string="Days Since Bill"/>
                <field name="compliance_days_overdue" column_invisible="1"/>
                <field name="amount_residual" string="Amount Pending"/>
                <field name="payment_state" string="Payment Status"
                       widget="badge"
                       decoration-danger="payment_state == 'not_paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-success="payment_state in ('paid','in_payment')"/>
                <field name="is_msme_partner" string="MSME" widget="boolean"/>
                <field name="compliance_acknowledged" string="180d Ack." widget="boolean" optional="show"/>
                <field name="msme_acknowledged" string="45d Ack." widget="boolean" optional="show"/>
                <field name="is_compliance_alert" column_invisible="1"/>
                <field name="is_msme_alert" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_account_move_compliance_search" model="ir.ui.view">
        <field name="name">account.move.compliance.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Compliance Alerts">
                <field name="name" string="Bill Number"/>
                <field name="partner_id" string="Vendor"/>
                <filter string="Not Acknowledged" name="not_acked"
                        domain="[('compliance_acknowledged','=',False),('msme_acknowledged','=',False)]"/>
                <filter string="MSME Vendor" name="msme_vendor"
                        domain="[('is_msme_partner','=',True)]"/>
                <separator/>
                    <filter string="Vendor" name="gb_vendor" context="{'group_by':'partner_id'}"/>
                    <filter string="Bill Month" name="gb_month" context="{'group_by':'invoice_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         ACTION 1 — MSME 45-Day Alerts
         view_id forces compliance list as the list view.
         No view_ids — avoids duplicate constraint on upgrade.
    ══════════════════════════════════════════════════════ -->
    <record id="action_msme_45_compliance_alerts" model="ir.actions.act_window">
        <field name="name">MSME 45-Day Alerts</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_move_compliance_list"/>
        <field name="search_view_id" ref="view_account_move_compliance_search"/>
        <field name="domain">[
            ('move_type','=','in_invoice'),
            ('state','=','posted'),
            ('payment_state','in',['not_paid','partial']),
            ('is_msme_alert','=',True)
        ]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No MSME 45-day alerts at this time.</p>
            <p>Bills from MSME vendors pending payment beyond 45 days will appear here.</p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         ACTION 2 — 180-Day General Alerts
    ══════════════════════════════════════════════════════ -->
    <record id="action_180_day_compliance_alerts" model="ir.actions.act_window">
        <field name="name">180-Day General Alerts</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_move_compliance_list"/>
        <field name="search_view_id" ref="view_account_move_compliance_search"/>
        <field name="domain">[
            ('move_type','=','in_invoice'),
            ('state','=','posted'),
            ('payment_state','in',['not_paid','partial']),
            ('is_compliance_alert','=',True)
        ]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No 180-day alerts at this time.</p>
            <p>Vendor bills pending payment beyond 180 days. Section 43B(h) IT Act obligations apply.</p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         ACTION 3 — All Compliance Alerts
    ══════════════════════════════════════════════════════ -->
    <record id="action_all_compliance_alerts" model="ir.actions.act_window">
        <field name="name">Payment Compliance Alerts</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_move_compliance_list"/>
        <field name="search_view_id" ref="view_account_move_compliance_search"/>
        <field name="domain">[
            ('move_type','=','in_invoice'),
            ('state','=','posted'),
            ('payment_state','in',['not_paid','partial']),
            '|',
            ('is_msme_alert','=',True),
            ('is_compliance_alert','=',True)
        ]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         MENUS under Accounting > Vendors
    ══════════════════════════════════════════════════════ -->
    <menuitem id="menu_compliance_alerts_root"
              name="Compliance Alerts"
              parent="account.menu_finance_payables"
              sequence="98"/>

    <menuitem id="menu_msme_45_alerts"
              name="MSME 45-Day Alerts"
              action="action_msme_45_compliance_alerts"
              parent="menu_compliance_alerts_root"
              sequence="1"/>

    <menuitem id="menu_180_day_alerts"
              name="180-Day General Alerts"
              action="action_180_day_compliance_alerts"
              parent="menu_compliance_alerts_root"
              sequence="2"/>

    <menuitem id="menu_all_compliance_alerts"
              name="All Compliance Alerts"
              action="action_all_compliance_alerts"
              parent="menu_compliance_alerts_root"
              sequence="3"/>

</odoo>
