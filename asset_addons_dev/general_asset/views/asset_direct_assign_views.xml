<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_direct_assign_wizard_form" model="ir.ui.view">
        <field name="name">asset.direct.assign.wizard.form</field>
        <field name="model">asset.direct.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Asset">
                <field name="asset_id" invisible="1"/>
                <group>
                    <field name="assign_type" widget="radio" options="{'horizontal': true}"/>
                    <field name="employee_id" required="assign_type == 'employee'" readonly="assign_type == 'common'" options="{'no_create': True}"/>
                    <field name="department_id" required="assign_type == 'employee'" options="{'no_create': True}"/>
                    <field name="location_id" required="assign_type == 'employee'" options="{'no_create': True}"/>
                </group>
                <div class="text-muted" invisible="assign_type != 'common'">
                    A common asset needs a department or a location.
                </div>
                <footer>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_asset_general_form_direct_assign" model="ir.ui.view">
        <field name="name">asset.asset.general.form.direct.assign</field>
        <field name="model">asset.asset</field>
        <field name="inherit_id" ref="general_asset.view_asset_general_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_open_direct_assign" type="object" string="Assign"
                        class="btn-primary" invisible="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
