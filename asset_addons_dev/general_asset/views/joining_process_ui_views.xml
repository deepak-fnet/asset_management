<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asset Assign Process: Odoo's own form, with an animated status bar. -->
    <record id="view_asset_joining_process_form_ui" model="ir.ui.view">
        <field name="name">asset.joining.process.form.ui</field>
        <field name="model">asset.joining.process</field>
        <field name="inherit_id" ref="asset_management.view_asset_joining_process_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="jp-form" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
