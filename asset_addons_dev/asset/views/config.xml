        <field name="view_mode">list,form</field>
    </record>

    <!--    To Location-->
    <record id="view_to_location_form" model="ir.ui.view">
        <field name="name">to.location.form</field>
        <field name="model">to.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="4">
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_to_location_list" model="ir.ui.view">
        <field name="name">to.location.list</field>
        <field name="model">to.location</field>
        <field name="arch" type="xml">
