            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_plant_master" model="ir.actions.act_window">
        <field name="name">plant</field>
        <field name="res_model">plant.master</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--    From Location-->
    <record id="view_from_location_form" model="ir.ui.view">
        <field name="name">from.location.form</field>
        <field name="model">from.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="4">
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_from_location_list" model="ir.ui.view">
        <field name="name">from.location.list</field>
        <field name="model">from.location</field>
        <field name="arch" type="xml">
