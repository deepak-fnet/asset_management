<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_physical_location_form" model="ir.ui.view">
        <field name="name">physical.location.form</field>
        <field name="model">physical.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="4">
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_physical_location_list" model="ir.ui.view">
        <field name="name">physical.location.list</field>
        <field name="model">physical.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_physical_location" model="ir.actions.act_window">
        <field name="name">Physical Location</field>
        <field name="res_model">physical.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_plant_master_form" model="ir.ui.view">
