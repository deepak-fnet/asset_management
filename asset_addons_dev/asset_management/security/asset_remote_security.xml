<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Access rights for the two new models, reusing the module's
             existing Asset User / Manager groups. -->
        <record id="access_asset_remote_session_user"
                model="ir.model.access">
            <field name="name">asset.remote.session user</field>
            <field name="model_id" ref="model_asset_remote_session"/>
            <field name="group_id" ref="group_asset_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <record id="access_asset_remote_session_manager"
                model="ir.model.access">
            <field name="name">asset.remote.session manager</field>
            <field name="model_id" ref="model_asset_remote_session"/>
            <field name="group_id" ref="group_asset_manager"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
        <record id="access_asset_remote_history_user"
                model="ir.model.access">
            <field name="name">asset.remote.history user</field>
            <field name="model_id" ref="model_asset_remote_history"/>
            <field name="group_id" ref="group_asset_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <record id="access_asset_remote_history_manager"
                model="ir.model.access">
            <field name="name">asset.remote.history manager</field>
            <field name="model_id" ref="model_asset_remote_history"/>
            <field name="group_id" ref="group_asset_manager"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- A user sees the sessions they administer; managers see all. -->
        <record id="rule_asset_remote_own" model="ir.rule">
            <field name="name">Asset remote sessions: own</field>
            <field name="model_id" ref="model_asset_remote_session"/>
            <field name="domain_force">[('admin_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_asset_user'))]"/>
        </record>
        <record id="rule_asset_remote_all" model="ir.rule">
            <field name="name">Asset remote sessions: all</field>
            <field name="model_id" ref="model_asset_remote_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_asset_manager'))]"/>
        </record>
    </data>
</odoo>
