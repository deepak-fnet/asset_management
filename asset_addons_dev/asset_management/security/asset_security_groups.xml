<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ==========================================================
             ODOO 19: module category + res.groups.privilege
             In Odoo 19 res.groups.category_id was replaced by
             privilege_id, a Many2one to the new res.groups.privilege
             model. The privilege in turn points at the ir.module.category.
             Groups must be attached to a privilege to be grouped
             correctly in the user form's access-rights tab.
             ========================================================== -->

        <record id="module_category_asset_management" model="ir.module.category">
            <field name="name">Asset Management</field>
            <field name="description">Manage assets, agents, monitoring and lifecycle.</field>
            <field name="sequence">10</field>
        </record>

        <record id="res_groups_privilege_asset_management" model="res.groups.privilege">
            <field name="name">Asset Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_asset_management"/>
        </record>

        <record id="res_groups_privilege_asset_department" model="res.groups.privilege">
            <field name="name">Asset Department Access</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="module_category_asset_management"/>
        </record>

        <!-- ==========================================================
             GROUPS
             ========================================================== -->

        <!-- Asset User: Base internal user -->
        <record id="group_asset_user" model="res.groups">
            <field name="name">Asset User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_asset_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_asset_user_it" model="res.groups">
            <field name="name">IT User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_asset_department"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_asset_user_hr" model="res.groups">
            <field name="name">HR</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_asset_department"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Asset Manager: Inherits Asset User -->
        <record id="group_asset_manager" model="res.groups">
    <field name="name">Asset Manager</field>
    <field name="sequence">20</field>
    <field name="privilege_id" ref="res_groups_privilege_asset_management"/>
    <field name="implied_ids" eval="[
        (4, ref('group_asset_user')),
        (4, ref('group_asset_user_it')),
        (4, ref('group_asset_user_hr'))
    ]"/>
</record>
        <!-- Asset Admin: Inherits Asset Manager -->
        <record id="group_asset_admin" model="res.groups">
            <field name="name">Asset Admin</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_asset_management"/>
            <field name="implied_ids" eval="[(4, ref('group_asset_manager'))]"/>
        </record>

        <!-- Department-flavoured groups: kept under a separate privilege so
             they remain independently selectable, as they were in v17. -->

    </data>
</odoo>
