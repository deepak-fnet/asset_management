<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         SPARE REQUEST
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_spare_request_list" model="ir.ui.view">
        <field name="name">spare.request.list</field>
        <field name="model">spare.request</field>
        <field name="arch" type="xml">
            <list string="Spare Requests"
                  decoration-info="state == 'submitted'"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="request_date"/>
                <field name="requester_id"/>
                <field name="employee_id" optional="show"/>
                <field name="asset_id" optional="show"/>
                <field name="repair_id" optional="hide"/>
                <field name="line_count" string="Lines"/>
                <field name="vendor_id" optional="show"/>
                <field name="purchase_order_id" optional="show"/>
                <field name="total_estimated" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ['submitted','approved']"
                       decoration-warning="state == 'po_created'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_spare_request_form" model="ir.ui.view">
        <field name="name">spare.request.form</field>
        <field name="model">spare.request</field>
        <field name="arch" type="xml">
            <form string="Spare Request">
                <header>
                    <button name="action_check_availability" type="object"
                            string="Check Availability" icon="fa-search"
                            invisible="state in ['done','cancelled','rejected']"/>
                    <button name="action_submit" type="object"
                            string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="asset_management.group_asset_manager"/>
                    <button name="action_reject" type="object"
                            string="Reject" class="btn-secondary"
                            invisible="state != 'submitted'"
                            groups="asset_management.group_asset_manager"/>
                    <button name="action_create_po" type="object"
                            string="Create Purchase Order" class="btn-primary"
                            invisible="state != 'approved'"
                            groups="asset_management.group_asset_manager"/>
                    <button name="action_check_receipt" type="object"
                            string="Check Receipt" class="btn-primary"
                            invisible="state != 'po_created'"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ['rejected','cancelled']"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ['done','cancelled']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,po_created,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_po" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not purchase_order_id">
                            <span class="o_stat_text">Purchase Order</span>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Done" bg_color="text-bg-success"
                            invisible="state != 'done'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                            invisible="state != 'rejected'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Request">
                            <field name="requester_id"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="request_date"/>
                            <field name="required_by"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Context">
                            <field name="asset_id"/>
                            <field name="repair_id"/>
                            <field name="vendor_id"
                                   required="state == 'approved'"/>
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="po_state" readonly="1"
                                   invisible="not purchase_order_id"/>
                            <field name="received_date" readonly="1"
                                   invisible="not received_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert"
                         invisible="not line_ids">
                        <field name="availability_note" readonly="1" nolabel="1"/>
                    </div>

                    <notebook>
                        <page string="Requested Products" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" decoration-danger="is_short">
                                    <field name="product_id"
                                           options="{'no_create': True}"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="available_qty" string="On Hand"/>
                                    <field name="is_short" string="Short"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_estimated"/>
                            </group>
                        </page>
                        <page string="Reason" name="reason">
                            <field name="reason" placeholder="Why are these spares needed?"/>
                        </page>
                        <page string="Approval" name="approval">
                            <group>
                                <field name="approver_id" readonly="1"/>
                                <field name="approval_date" readonly="1"/>
                                <field name="rejection_reason" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_spare_request_search" model="ir.ui.view">
        <field name="name">spare.request.search</field>
        <field name="model">spare.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="asset_id"/>
                <field name="vendor_id"/>
                <field name="purchase_order_id"/>
                <filter name="f_mine" string="My Requests"
                        domain="[('requester_id','=',uid)]"/>
                <filter name="f_to_approve" string="To Approve"
                        domain="[('state','=','submitted')]"/>
                <filter name="f_open" string="Open"
                        domain="[('state','in',['draft','submitted','approved','po_created'])]"/>
                <separator/>
                <!--                <filter name="f_urgent" string="Urgent" domain="[('priority','=','1')]"/>-->
                <!--                <group expand="0" string="Group By">-->
                <!--                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>-->
                <!--                    <filter name="g_requester" string="Requester" context="{'group_by':'requester_id'}"/>-->
                <!--                    <filter name="g_vendor" string="Vendor" context="{'group_by':'vendor_id'}"/>-->
                <!--                    <filter name="g_month" string="Request Month" context="{'group_by':'request_date:month'}"/>-->
                <!--                </group>-->
            </search>
        </field>
    </record>

    <record id="action_spare_request" model="ir.actions.act_window">
        <field name="name">Spare Requests</field>
        <field name="res_model">spare.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_spare_request_search"/>
        <field name="context">{'search_default_f_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Raise a spare part request</p>
            <p>Request spare products, get them approved, and turn them into a
                purchase order. The request closes on its own once the goods are
                received.
            </p>
        </field>
    </record>

    <record id="action_spare_request_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">spare.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','submitted')]</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         SPARE PRODUCTS
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_spare_product_list" model="ir.ui.view">
        <field name="name">product.template.spare.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Spare Products" decoration-danger="is_low_stock">
                <field name="name"/>
                <field name="default_code" string="Internal Ref"/>
                <field name="spare_category"/>
                <field name="qty_available" string="On Hand"/>
                <field name="min_stock_alert"/>
                <field name="is_low_stock" string="Low"/>
                <field name="standard_price"/>
                <field name="list_price" optional="hide"/>
                <field name="uom_id" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_spare_product_form" model="ir.ui.view">
        <field name="name">product.template.spare.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_spare"/>
                <field name="spare_category" invisible="not is_spare"/>
                <field name="min_stock_alert" invisible="not is_spare"/>
            </xpath>
        </field>
    </record>

    <record id="view_spare_product_search" model="ir.ui.view">
        <field name="name">product.template.spare.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="default_code"/>
                <!--                <filter name="f_low" string="Low Stock" domain="[('is_low_stock','=',True)]"/>-->
                <!--                <group expand="0" string="Group By">-->
                <!--                    <filter name="g_cat" string="Spare Category"-->
                <!--                            context="{'group_by':'spare_category'}"/>-->
                <!--                </group>-->
            </search>
        </field>
    </record>

    <record id="action_spare_product" model="ir.actions.act_window">
        <field name="name">Spare Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_spare','=',True)]</field>
        <field name="context">{'default_is_spare': True, 'default_type': 'consu'}</field>
        <field name="search_view_id" ref="view_spare_product_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your spare parts</p>
            <p>Products flagged as spare parts appear here, and are the only ones
                selectable in spare requests and repair spare lines.
            </p>
        </field>
    </record>

    <record id="action_spare_product_list_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_spare_product_list"/>
        <field name="act_window_id" ref="action_spare_product"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         REPAIR ORDER: availability + request buttons
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_repair_management_form_spare" model="ir.ui.view">
        <field name="name">repair.management.form.spare</field>
        <field name="model">repair.management</field>
        <field name="inherit_id" ref="asset_management.view_repair_management_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='spare_part_ids']" position="before">
                <div class="mb-2">
                    <button name="action_check_spare_availability" type="object"
                            string="Check Availability" icon="fa-search"
                            class="btn-secondary"/>
                    <button name="action_request_spares" type="object"
                            string="Request Spares" icon="fa-shopping-cart"
                            class="btn-primary ms-2"/>
                    <button name="action_confirm_use_spare" type="object" string="Confirm Use"
                            class="btn-success" invisible="spare_confirmed"
                            confirm="This removes the quantities from stock. Continue?"/>
                    <field name="spare_confirmed" invisible="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='spare_part_ids']" position="attributes">
                <attribute name="readonly">spare_confirmed</attribute>
            </xpath>
            <xpath expr="//field[@name='spare_part_ids']/list/field[@name='quantity']"
                   position="after">
                <field name="available_qty" string="On Hand" readonly="1"/>
                <field name="is_short" string="Short" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         SEQUENCE + CRON
         ══════════════════════════════════════════════════════════════════ -->
    <record id="seq_spare_request" model="ir.sequence">
        <field name="name">Spare Request</field>
        <field name="code">spare.request</field>
        <field name="prefix">SPR-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cron_spare_request_receipt" model="ir.cron">
        <field name="name">Spare: close requests on receipt</field>
        <field name="model_id" ref="model_spare_request"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_receipts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         MENUS
         ══════════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_spare_root" name="Spares"
              parent="asset_management.menu_asset_root" sequence="45"/>

    <menuitem id="menu_spare_request" name="Spare Requests"
              parent="menu_spare_root" action="action_spare_request" sequence="10"/>

    <menuitem id="menu_spare_request_approve" name="To Approve"
              parent="menu_spare_root" action="action_spare_request_to_approve"
              sequence="20" groups="asset_management.group_asset_manager"/>

    <menuitem id="menu_spare_product" name="Spare Products"
              parent="menu_spare_root" action="action_spare_product" sequence="30"/>

</odoo>