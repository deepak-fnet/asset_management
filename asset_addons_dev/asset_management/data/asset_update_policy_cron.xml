<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- =====================================================
             Auto-approve Windows updates per policy.
             Runs hourly. Each policy enforces its own maintenance
             window, so an hourly tick is safe — outside the window
             it simply does nothing.
             ===================================================== -->
        <record id="ir_cron_run_update_policies" model="ir.cron">
            <field name="name">Asset: Run Windows Update Policies</field>
            <field name="model_id" ref="model_asset_update_policy"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_update_policies()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <!-- Deliberately INACTIVE on install. Create and review at least
                 one policy, use Preview to confirm targeting, then enable
                 this cron manually. -->
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
