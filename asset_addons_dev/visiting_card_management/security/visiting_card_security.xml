<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="visiting_card_rule_own" model="ir.rule">
        <field name="name">Visiting Card: salesperson sees own cards only</field>
        <field name="model_id" ref="model_visiting_card"/>
        <field name="domain_force">[('scanned_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="visiting_card_rule_manager_all" model="ir.rule">
        <field name="name">Visiting Card: sales manager sees all cards</field>
        <field name="model_id" ref="model_visiting_card"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
</odoo>
