<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_visiting_card" model="ir.ui.view">
        <field name="name">crm.lead.form.visiting.card</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_visiting_card" type="object" class="oe_stat_button" icon="fa-id-card"
                        invisible="not visiting_card_id">
                    <field name="visiting_card_id" widget="statinfo" string="Visiting Card"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
