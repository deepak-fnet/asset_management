<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="purchase_order_form_inh_approval">
        <field name="name">purchase.order.form.inh.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Approvers + status, shown right under the vendor. -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="approver_ids" widget="many2many_tags"
                       options="{'no_create': True}"
                       readonly="1"/>
                <field name="approval_status" invisible="not approver_ids"/>
                <field name="approval_progress" invisible="not approver_ids"
                       string="Progress"/>
            </xpath>

            <!-- Approval buttons in the HEADER. Each one acts only on the
                 current user's own pending line (see action_approve_order),
                 so an approver can never action someone else's approval.
                 can_approve is False unless this user has a pending line,
                 which keeps the buttons hidden for everyone else.

                 Submit gates on approval_config_id (set at create() from the
                 default flow, independent of any submission), NOT
                 approver_ids: approver_ids is now a pure computed rollup of
                 approval_line_ids.approver_id, and approval_line_ids only
                 get created BY submitting - gating Submit's own visibility
                 on approver_ids made it permanently empty/hidden before the
                 first submission, so nothing could ever trigger it. -->
            <button name="button_confirm" position="before">
                <button name="action_approve_order" type="object"
                        string="Approve" class="btn-success"
                        invisible="not can_approve"/>
                <button name="action_reject_order" type="object"
                        string="Reject" class="btn-danger"
                        invisible="not can_approve"/>
                <button name="action_submit_for_approval" type="object"
                        string="Submit for Approval" class="btn-primary"
                        invisible="not approval_config_id or approval_status not in ('draft', 'rejected')"/>
                <button name="action_reset_approval" type="object"
                        string="Reset Approval" class="btn-secondary"
                        invisible="1"
                        confirm="This clears every approval line on this order. Continue?"/>
            </button>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="can_approve" invisible="1"/>
                <field name="approval_config_id" readonly="1"
                       invisible="not approval_config_id"/>
            </xpath>

            <!-- NOTE: this module deliberately does NOT override the visibility of
                 the core `button_confirm`. Odoo does not merge two `invisible`
                 expressions on the same attribute — the view applied last wins
                 outright — so overriding it here silently undid the visibility
                 rules set by other modules (notably purchase_extended, which
                 hides button_confirm[1] and conditions button_confirm[2]),
                 producing two visible "Confirm Order" buttons.

                 Visibility is therefore owned by whichever module manages that
                 button. Enforcement here is done in Python instead
                 (button_confirm override + the state constrain in
                 models/purchase_order.py), which cannot be bypassed and does
                 not conflict with any other view. -->

            <!-- Approvals tab is now a read-only history: who must approve,
                 where each stands, and when they acted. The Approve/Reject
                 buttons live in the header instead. -->
            <xpath expr="//notebook" position="inside">
                <page string="Approvals" name="approvals" invisible="not approver_ids">
                    <field name="approval_line_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="approver_id"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'approved'"
                                   decoration-danger="status == 'rejected'"
                                   decoration-warning="status == 'pending'"/>
                            <field name="comment"/>
                            <field name="action_date"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record model="ir.ui.view" id="purchase_order_form_inh_terms">
        <field name="name">purchase.order.form.inh.terms</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <!-- Higher than the default 16: both this view and
             purchase_requisition's insert "position=after partner_ref" -
             whichever applies LAST ends up closest to that anchor. Forcing
             this one to apply last is what actually lands terms_template_id
             before requisition_id ("Purchase Agreement") rather than after
             it - verified empirically, not assumed (see the earlier
             partner_id/purchase_requisition surprise in vendor_management). -->
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <!-- Header field, positioned right after Vendor Reference -
                 requisition_id ("Purchase Agreement", from the optional
                 purchase_requisition module) is itself inserted right after
                 partner_ref, so anchoring here the same way lands this field
                 immediately before it when that module is installed,
                 without requiring it as a hard dependency (partner_ref is
                 guaranteed present in core's own base view either way).
                 Labeled "Payment Terms" (see terms_template_id's string in
                 the model) - picking one prefills the Terms Conditions lines
                 below with one row per term type in the template. -->
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="terms_template_id" options="{'no_create': True}" string="Terms &amp; conditions"
                       readonly="approval_status not in (False, 'draft', 'rejected')"/>
            </xpath>

            <!-- Terms & Conditions tab: rows prefilled by the header Payment
                 Terms field above; adjust/add rows one term at a time.
                 Locked once submitted for approval, same as the line items -
                 changing terms after sign-off would silently invalidate
                 what was approved. -->
            <xpath expr="//notebook" position="inside">
                <page string="Terms Conditions" name="terms_conditions">
                    <field name="terms_condition_line_ids"
                           readonly="approval_status not in (False, 'draft', 'rejected')">
                        <list editable="bottom">
                            <field name="term_id"/>
                            <field name="value_id" options="{'create_edit': True}"
                                   domain="[('term_id', '=', term_id)]"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
