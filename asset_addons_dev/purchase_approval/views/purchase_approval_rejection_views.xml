<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_approval_rejection_list" model="ir.ui.view">
        <field name="name">purchase.approval.rejection.list</field>
        <field name="model">purchase.approval.rejection</field>
        <field name="arch" type="xml">
            <list create="false" delete="false"
                  decoration-warning="state == 'open'" decoration-muted="state == 'resubmitted'">
                <field name="cycle"/>
                <field name="order_id"/>
                <field name="rejected_by"/>
                <field name="rejected_on"/>
                <field name="reason"/>
                <field name="change_count" string="Changes"/>
                <field name="resubmitted_on" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'open'" decoration-success="state == 'resubmitted'"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_approval_rejection_form" model="ir.ui.view">
        <field name="name">purchase.approval.rejection.form</field>
        <field name="model">purchase.approval.rejection</field>
        <field name="arch" type="xml">
            <form create="false" delete="false" edit="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2>Rejection #<field name="cycle" class="d-inline"/> - <field name="order_id" class="d-inline"/></h2>
                    </div>
                    <group>
                        <group string="Rejected">
                            <field name="rejected_by"/>
                            <field name="rejected_on"/>
                        </group>
                        <group string="Resubmitted">
                            <field name="resubmitted_by"/>
                            <field name="resubmitted_on"/>
                            <field name="change_count"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Changes made before resubmitting" invisible="state != 'resubmitted'">
                        <field name="change_summary" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">purchase.approval.reject.wizard.form</field>
        <field name="model">purchase.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Purchase Order">
                <field name="order_id" invisible="1"/>
                <p class="text-muted">
                    The reason is sent to the purchase user and kept in the order's rejection history.
                </p>
                <field name="reason" placeholder="Why is this rejected? What needs to change?"/>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Reject" class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="purchase_order_form_inh_rejections" model="ir.ui.view">
        <field name="name">purchase.order.form.inh.rejections</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_rejections" class="oe_stat_button"
                        icon="fa-ban" invisible="not rejection_count">
                    <field name="rejection_count" widget="statinfo" string="Rejections"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
