<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_approval_event_list" model="ir.ui.view">
        <field name="name">purchase.approval.event.list</field>
        <field name="model">purchase.approval.event</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-warning="state == 'open'">
                <field name="date"/>
                <field name="order_id"/>
                <field name="kind" widget="badge"/>
                <field name="number" string="#"/>
                <field name="user_id" string="By"/>
                <field name="level_name"/>
                <field name="text"/>
                <field name="reply"/>
                <field name="has_copy" string="Copy" widget="boolean" optional="show"/>
                <field name="state" widget="badge" decoration-warning="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_approval_event_form" model="ir.ui.view">
        <field name="name">purchase.approval.event.form</field>
        <field name="model">purchase.approval.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header><field name="state" widget="statusbar"/></header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="kind"/>
                            <field name="number"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="date"/>
                            <field name="level_name" invisible="not level_name"/>
                        </group>
                    </group>
                    <group string="Message"><field name="text" nolabel="1" colspan="2"/></group>
                    <group string="Reply" invisible="not reply">
                        <field name="reply" nolabel="1" colspan="2"/>
                        <field name="replied_by"/>
                        <field name="replied_on"/>
                    </group>
                    <field name="has_copy" invisible="1"/>
                    <div invisible="not has_copy">
                        <h4 class="mt-3">Order copy
                            <small class="text-muted" invisible="kind != 'revision'"> - as the approver saw it</small>
                            <small class="text-muted" invisible="kind != 'resubmit'"> - as resubmitted</small>
                        </h4>
                        <group>
                            <group>
                                <field name="copy_multi_vendor" invisible="1"/>
                                <field name="copy_partner_id" invisible="copy_multi_vendor"/>
                                <field name="copy_payment_term_id" invisible="not copy_payment_term_id"/>
                            </group>
                            <group>
                                <field name="copy_date_order"/>
                                <field name="copy_date_planned"/>
                                <field name="copy_currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Products" name="copy_products">
                                <field name="copy_line_ids">
                                    <list decoration-bf="display_type">
                                        <field name="display_type" column_invisible="1"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="product_id"/>
                                        <field name="name"/>
                                        <field name="vendor_id" optional="show"/>
                                        <field name="product_qty"/>
                                        <field name="uom_name"/>
                                        <field name="price_unit"/>
                                        <field name="discount" optional="hide"/>
                                        <field name="taxes"/>
                                        <field name="price_subtotal"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer">
                                    <field name="copy_amount_untaxed"/>
                                    <field name="copy_amount_tax"/>
                                    <field name="copy_amount_total" class="fw-bold"/>
                                </group>
                            </page>
                            <page string="Terms" name="copy_terms">
                                <field name="copy_term_ids">
                                    <list><field name="name"/><field name="value"/></list>
                                </field>
                                <field name="copy_notes"/>
                            </page>
                        </notebook>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_approval_action_wizard_form" model="ir.ui.view">
        <field name="name">purchase.approval.action.wizard.form</field>
        <field name="model">purchase.approval.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Approval">
                <field name="order_id" invisible="1"/>
                <field name="kind" invisible="1"/>
                <p class="text-muted"><field name="hint" readonly="1"/></p>
                <field name="text" placeholder="Write here…"/>
                <footer>
                    <button name="action_confirm" type="object" string="Send" icon="fa-paper-plane"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_purchase_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">purchase.approval.reject.wizard.form</field>
        <field name="model">purchase.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Purchase Order">
                <field name="order_id" invisible="1"/>
                <p class="text-muted">
                    Rejection is final: the order stays Rejected and cannot be submitted again.
                    To send it back for changes, use Request Revision instead.
                </p>
                <field name="reason" placeholder="Why is this rejected?"/>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Reject" class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_purchase_approval_reply_wizard_form" model="ir.ui.view">
        <field name="name">purchase.approval.reply.wizard.form</field>
        <field name="model">purchase.approval.reply.wizard</field>
        <field name="arch" type="xml">
            <form string="Reply to Query">
                <field name="order_id" invisible="1"/>
                <field name="query_id" invisible="1"/>
                <div class="alert alert-warning">
                    <b><field name="query_by" readonly="1" class="d-inline"/> asks:</b>
                    <field name="query_text" readonly="1"/>
                </div>
                <field name="text" placeholder="Your answer…"/>
                <footer>
                    <button name="action_confirm" type="object" string="Send Reply" icon="fa-reply" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
