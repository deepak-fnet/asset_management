<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.ui.view" id="purchase_approval_role_view_list">
        <field name="name">purchase.approval.role.list</field>
        <field name="model">purchase.approval.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="purchase_approval_role_view_form">
        <field name="name">purchase.approval.role.form</field>
        <field name="model">purchase.approval.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Level - 1"/></h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_purchase_approval_role">
        <field name="name">Approval Roles</field>
        <field name="res_model">purchase.approval.role</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define an approval role
            </p>
            <p>
                A role (e.g. "Level - 1") is a named group of approvers that
                can be mapped to an amount band on an Approval configuration
                line.
            </p>
        </field>
    </record>

    <menuitem id="menu_purchase_approval_role"
              name="Approval Roles"
              parent="purchase.menu_purchase_config"
              action="action_purchase_approval_role"
              groups="purchase.group_purchase_manager"
              sequence="89"/>

</odoo>
