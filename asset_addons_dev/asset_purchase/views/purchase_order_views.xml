<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="purchase_order_form_asset" model="ir.ui.view">
        <field name="name">purchase.order.form.asset</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <div name="button_box" position="inside">
                <button name="action_view_assets" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="asset_count == 0">
                    <field string="Assets" name="asset_count" widget="statinfo"/>
                </button>
            </div>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="is_fixed_asset" optional="show"/>
            </xpath>

            <!-- Once a receipt has been generated (incoming_picking_count
                 > 0), the lines are locked - editing qty/product after
                 physical receiving has started would silently desync what
                 was ordered from what was actually received/billed. Amend
                 via a new PO/backorder instead of rewriting this one.
                 Combined with the base view's own condition (state ==
                 'cancel' or locked), not replacing it. -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">state == 'cancel' or locked or incoming_picking_count &gt; 0</attribute>
            </xpath>

        </field>
    </record>

</odoo>
