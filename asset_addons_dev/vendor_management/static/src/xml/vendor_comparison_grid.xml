<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="vendor_management.VendorComparisonGrid">
        <div class="o_vendor_comparison_grid">
            <div class="o_vcg_inner">
                <!-- Header: back arrow, title, quotation + state -->
                <div class="o_vcg_header">
                    <button type="button" class="o_vcg_back" t-on-click="goBack" title="Back">
                        <i class="fa fa-arrow-left"/>
                    </button>
                    <div>
                        <h1 class="o_vcg_title">Vendor Comparison</h1>
                        <div class="o_vcg_subtitle">
                            <span>Quotation: <t t-esc="state.poName"/></span>
                            <span t-if="state.poState" class="o_vcg_badge" t-esc="state.poState"/>
                            <span t-if="state.confirmed" class="o_vcg_badge o_vcg_badge_ok">
                                <i class="fa fa-check"/> Selection confirmed
                            </span>
                        </div>
                    </div>
                    <button t-if="state.canConfirm and state.vendors.length" type="button"
                            class="btn btn-primary o_vcg_confirm" t-on-click="confirmSelection">
                        <i class="fa fa-check me-1"/> Confirm
                    </button>
                </div>

                <div t-if="state.loading" class="text-muted">Loading...</div>

                <t t-else="">
                    <div t-if="!state.vendors.length" class="o_vcg_card o_vcg_empty">
                        No vendor bids yet for this RFQ.
                    </div>

                    <t t-else="">
                        <div t-if="state.locked" class="o_vcg_card o_vcg_locked_note">
                            <i class="fa fa-lock"/>
                            <span t-esc="state.lockedReason"/>
                        </div>
                        <!-- One-click picks -->
                        <div t-if="!state.locked and state.vendors.length &gt; 1" class="o_vcg_card o_vcg_smart">
                            <span class="o_vcg_select_label"><i class="fa fa-magic"/> Quick pick</span>
                            <button type="button" class="btn btn-sm btn-outline-primary" t-att-disabled="state.busy" t-on-click="pickLowest">
                                <i class="fa fa-arrow-down"/> Lowest price for every product
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" t-att-disabled="state.busy" t-on-click="pickFastest">
                                <i class="fa fa-bolt"/> Fastest delivery for every product
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" t-att-disabled="state.busy or !selectedCount" t-on-click="clearAll">
                                <i class="fa fa-eraser"/> Clear selection
                            </button>
                        </div>

                        <!-- Product x vendor grid -->
                        <div class="o_vcg_card o_vcg_table_wrap">
                            <table class="o_vcg_table">
                                <colgroup>
                                    <col class="o_vcg_col_product"/>
                                    <col class="o_vcg_col_qty"/>
                                    <t t-foreach="state.vendors" t-as="vendor" t-key="vendor.id">
                                        <col class="o_vcg_col_vendor"/>
                                    </t>
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Qty</th>
                                        <t t-foreach="state.vendors" t-as="vendor" t-key="vendor.id">
                                            <th>
                                                <label class="o_vcg_vendor_option"
                                                       title="Award this vendor every product they quoted">
                                                    <input type="checkbox" class="form-check-input"
                                                           t-att-disabled="state.locked"
                                                           t-att-checked="isVendorAwardedAll(vendor.id)"
                                                           t-on-change="() => this.toggleVendorAll(vendor.id)"/>
                                                    <span class="o_vcg_vendor_text">
                                                        <span class="o_vcg_vendor_name" t-esc="vendor.name"/>
                                                        <span t-if="vendor.subtitle" class="o_vcg_vendor_sub" t-esc="vendor.subtitle"/>
                                                    </span>
                                                </label>
                                            </th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.products" t-as="product" t-key="product.line_id">
                                        <tr>
                                            <td>
                                                <div class="o_vcg_product">
                                                    <img class="o_vcg_product_img"
                                                         t-att-src="productImageUrl(product)"
                                                         t-att-alt="product.product_name"/>
                                                    <span class="o_vcg_product_name" t-esc="product.product_name"/>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="o_vcg_qty" t-esc="product.qty"/>
                                                <div class="o_vcg_uom">(<t t-esc="product.uom"/>)</div>
                                            </td>
                                            <t t-foreach="state.vendors" t-as="vendor" t-key="vendor.id">
                                                <td>
                                                    <t t-set="cell" t-value="product.cellsByVendor[vendor.id]"/>
                                                    <label t-if="cell" class="o_vcg_cell"
                                                           t-att-class="cell.is_winning ? 'o_vcg_cell_winning' : ''">
                                                        <input type="checkbox" class="form-check-input"
                                                           t-att-disabled="state.locked"
                                                               t-att-checked="cell.is_winning"
                                                               t-on-change="() => this.toggleCell(cell)"/>
                                                        <span class="o_vcg_price" t-esc="formatAmount(cell.price)"/>
                                                        <span t-if="isLowestPrice(product, cell)" class="o_vcg_tag_lowest">Lowest</span>
                                                    </label>
                                                    <div t-if="cell" class="o_vcg_cell_meta">
                                                        <span t-if="priceDiffLabel(product, cell)" class="o_vcg_diff" t-esc="priceDiffLabel(product, cell)"/>
                                                        <span t-if="cell.delivery_date" t-att-class="isFastest(product, cell) ? 'o_vcg_fast' : ''">
                                                            <i class="fa fa-truck"/> <t t-esc="cell.delivery_date"/>
                                                            <t t-if="isFastest(product, cell)"> · fastest</t>
                                                        </span>
                                                        <span t-if="cell.notes" class="o_vcg_line_note" t-att-title="cell.notes">
                                                            <i class="fa fa-comment-o"/> note
                                                        </span>
                                                    </div>
                                                    <span t-else="" class="o_vcg_not_quoted">Not quoted</span>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2" class="o_vcg_total_label">Total</td>
                                        <t t-foreach="state.vendors" t-as="vendor" t-key="vendor.id">
                                            <td>
                                                <div class="o_vcg_total"
                                                     t-att-class="isLowestTotal(vendor.id) ? 'o_vcg_total_lowest' : ''">
                                                    <span t-esc="formatAmount(vendorTotal(vendor.id))"/>
                                                    <span t-if="isLowestTotal(vendor.id)" class="o_vcg_tag_lowest">Lowest</span>
                                                </div>
                                            </td>
                                        </t>
                                    </tr>
                                    <!-- Not only price: each vendor's terms -->
                                    <tr>
                                        <td colspan="2" class="o_vcg_total_label">Payment Terms</td>
                                        <t t-foreach="state.vendors" t-as="vendor" t-key="vendor.id">
                                            <td>
                                                <span t-if="vendor.payment_term" t-esc="vendor.payment_term"/>
                                                <span t-else="" class="o_vcg_not_quoted">Not given</span>
                                            </td>
                                        </t>
                                    </tr>
                                    <tr>
                                        <td colspan="2" class="o_vcg_total_label">Delivery Date</td>
                                        <t t-foreach="state.vendors" t-as="vendor" t-key="vendor.id">
                                            <td>
                                                <span t-if="vendor.delivery_date" t-esc="vendor.delivery_date"/>
                                                <span t-else="" class="o_vcg_not_quoted">Not given</span>
                                            </td>
                                        </t>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- What the order costs with the current selection -->
                        <div class="o_vcg_card o_vcg_summary">
                            <div class="o_vcg_summary_progress">
                                <div class="o_vcg_summary_label">
                                    Awarded <b t-esc="selectedCount"/> of <t t-esc="state.products.length"/> products
                                    <t t-if="selectedVendorCount"> · <b t-esc="selectedVendorCount"/> purchase order<t t-if="selectedVendorCount &gt; 1">s</t> will be created</t>
                                </div>
                                <div class="o_vcg_bar"><div class="o_vcg_bar_fill" t-att-style="'width:' + selectedPct + '%'"/></div>
                            </div>
                            <div class="o_vcg_summary_figs">
                                <div>
                                    <span class="o_vcg_summary_label">Selected total</span>
                                    <span class="o_vcg_summary_amount" t-esc="formatAmount(selectedTotal)"/>
                                </div>
                                <div t-if="state.vendors.length &gt; 1">
                                    <span class="o_vcg_summary_label">All lowest prices</span>
                                    <span class="o_vcg_summary_sub" t-esc="formatAmount(lowestPossibleTotal)"/>
                                </div>
                                <div t-if="allSelected and state.vendors.length &gt; 1">
                                    <t t-if="selectedTotal - lowestPossibleTotal &gt; 0.005">
                                        <span class="o_vcg_summary_label">Above lowest</span>
                                        <span class="o_vcg_summary_sub o_vcg_diff" t-esc="'+' + formatAmount(selectedTotal - lowestPossibleTotal)"/>
                                    </t>
                                    <t t-else="">
                                        <span class="o_vcg_summary_label">Saved vs highest bids</span>
                                        <span class="o_vcg_summary_sub o_vcg_fast" t-esc="formatAmount(highestPossibleTotal - selectedTotal)"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
        </div>
    </t>

</templates>
