<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherit_vendor_mgmt" model="ir.ui.view">
        <field name="name">account.move.form.inherit.vendor.mgmt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_vendor_bill_submit" type="object" string="Submit"
                        invisible="not vendor_bill_awaiting_submit" class="btn-primary"
                        groups="vendor_management.group_purchase_role_user,vendor_management.group_vendor_manager,vendor_management.group_vendor_md"/>
                <button name="action_vendor_bill_stores_approve" type="object" string="Stores Approve"
                        invisible="not vendor_bill_awaiting_stores" class="btn-primary"
                        groups="vendor_management.group_purchase_role_stores,vendor_management.group_vendor_manager,vendor_management.group_vendor_md"/>
                <button name="action_open_rating_wizard" type="object" string="Rate Vendor"
                        invisible="move_type != 'in_invoice' or state != 'posted' or is_rated" class="btn-info"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_rated" invisible="1"/>
                <field name="vendor_bill_ids" invisible="1"/>
                <field name="vendor_bill_stores_approved" invisible="1"/>
                <field name="vendor_bill_awaiting_submit" invisible="1"/>
                <field name="vendor_bill_awaiting_stores" invisible="1"/>
                <field name="can_finance_post" invisible="1"/>
            </xpath>
            <!-- "Confirm" (index 2 - index 1 is "Post", for move_type='entry'
                 journal entries, irrelevant here) is core's own post button;
                 fully clickable the instant a draft exists otherwise, well
                 before Stores/Finance have done anything, and by anyone with
                 generic accounting rights, not just Purchase Finance. This
                 button IS "Purchase Finance confirms the bill" in this
                 workflow - no separate custom step. "string" isn't an
                 allowed inheritance selector (Odoo 19), hence positional. -->
            <xpath expr="(//button[@name='action_post'])[2]" position="attributes">
                <attribute name="invisible">hide_post_button or move_type == 'entry' or display_inactive_currency_warning or (vendor_bill_ids and (not vendor_bill_stores_approved or not can_finance_post))</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_in_invoice_bill_tree_inherit_vendor_mgmt" model="ir.ui.view">
        <field name="name">account.out.invoice.tree.inherit.vendor.mgmt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='amount_total_in_currency_signed']" position="attributes">
                <attribute name="sum"></attribute>
            </xpath>
        </field>
    </record>
</odoo>
