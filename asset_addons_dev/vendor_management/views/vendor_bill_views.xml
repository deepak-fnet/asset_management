<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_vendor_bill_list" model="ir.ui.view">
        <field name="name">vendor.bill.list</field>
        <field name="model">vendor.bill</field>
        <field name="arch" type="xml">
            <list string="Vendor Bills" create="false">
                <field name="order_id"/>
                <field name="vendor_id"/>
                <field name="qty_ordered"/>
                <field name="qty_received"/>
                <field name="move_id"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('to_receive', 'uploaded')"
                       decoration-warning="state in ('submitted', 'stores_approved')"
                       decoration-success="state == 'finance_confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_bill_form" model="ir.ui.view">
        <field name="name">vendor.bill.form</field>
        <field name="model">vendor.bill</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_upload_bill" type="object" string="Upload Bill"
                            class="btn-primary" invisible="qty_received &lt;= 0 or state != 'to_receive'"
                            groups="vendor_management.group_purchase_role_user,vendor_management.group_vendor_manager,vendor_management.group_vendor_md"/>
                    <button name="action_submit_bill" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'uploaded'"
                            groups="vendor_management.group_purchase_role_user,vendor_management.group_vendor_manager,vendor_management.group_vendor_md"/>
                    <button name="action_stores_approve" type="object" string="Stores Approve"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="vendor_management.group_purchase_role_stores,vendor_management.group_vendor_manager,vendor_management.group_vendor_md"/>
                    <button name="action_finance_confirm" type="object" string="Finance Confirm"
                            class="btn-primary" invisible="state != 'stores_approved'"
                            groups="vendor_management.group_purchase_role_finance,vendor_management.group_vendor_manager,vendor_management.group_vendor_md"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="to_receive,uploaded,submitted,stores_approved,finance_confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_upload_bill" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="not move_id">
                            <div class="o_field_statinfo">
                                <span class="o_stat_text">Vendor Bill</span>
                                <field name="move_state" widget="badge"/>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="vendor_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="qty_ordered" readonly="1"/>
                            <field name="qty_received" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_bill" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">vendor.bill</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
