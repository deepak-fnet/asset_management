<odoo>
    <template id="portal_vendor_documents">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="row mb-4">
                    <div class="col-12">
                        <h2 class="fw-bold">Your Documents</h2>
                        <hr/>
                    </div>
                </div>

                <t t-if="docs">
                    <div class="row">
                        <t t-foreach="docs" t-as="doc">
                            <div class="col-md-6 col-lg-4 mb-3">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-body d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="bg-light rounded p-3 me-3">
                                                    <i class="fa fa-file-pdf-o fa-2x text-danger" title="PDF Document Icon"/>
                                                </div>
                                                <h6 class="card-title mb-0 fw-bold text-dark">
                                                    <t t-esc="doc.doc_type_id.name"/>
                                                </h6>
                                            </div>
                                            <p class="card-text small text-muted mb-4">
                                                <strong>Expiry:</strong> <t t-esc="doc.expiry_date or 'No Expiry'"/>
                                            </p>
                                        </div>
                                        <div class="d-grid gap-2">
                                            <a t-attf-href="/web/content/vendor.document/#{doc.id}/attachment/#{doc.filename}?download=true"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="fa fa-download me-1" title="Download Icon"/> Download
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <t t-if="not docs">
                    <div class="text-center py-5">
                        <i class="fa fa-folder-open-o fa-4x text-muted mb-3" title="Empty Folder Icon"/>
                        <p class="lead text-muted">No documents uploaded yet.</p>
                        <a href="/my/vendor/request/new" class="btn btn-primary">
                            <i class="fa fa-upload me-1" title="Upload Icon"/> Upload First Document
                        </a>
                    </div>
                </t>

            </div>
        </t>
    </template>
</odoo>
