<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_vendor_document_request_list" model="ir.ui.view">
        <field name="name">vendor.document.request.list</field>
        <field name="model">vendor.document.request</field>
        <field name="arch" type="xml">
            <list string="Document Requests" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-primary="state == 'in_progress'" decoration-success="state == 'completed'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="doc_type_id"/>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                <field name="create_date" string="Requested On"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-primary="state == 'in_progress'" decoration-success="state == 'completed'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_document_request_form" model="ir.ui.view">
        <field name="name">vendor.document.request.form</field>
        <field name="model">vendor.document.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start Processing" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_complete" type="object" string="Mark Completed" class="btn-success" invisible="state != 'in_progress'"/>
                    <button name="action_reject" type="object" string="Reject Request" class="btn-danger" invisible="state in ('completed','rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Request Reference"/>
                        <h1>
                            <field name="name" placeholder="e.g. DOC/REQ/001"/>
                        </h1>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="vendor_section_card">
                                <div class="vendor_section_title">
                                    <i class="fa fa-file-text-o" title="Request Details Icon"/> Request Details
                                </div>
                                <group>
                                    <field name="vendor_id" options="{'no_create': True}"/>
                                    <field name="doc_type_id" options="{'no_create': True}"/>
                                    <field name="assigned_user_id" widget="many2one_avatar_user"/>
                                </group>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="vendor_section_card">
                                <div class="vendor_section_title">
                                    <i class="fa fa-align-left" title="Description Icon"/> Description
                                </div>
                                <field name="description" placeholder="Specify document requirements..."/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_document_requests" model="ir.actions.act_window">
        <field name="name">Vendor Requests</field>
        <field name="res_model">vendor.document.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
