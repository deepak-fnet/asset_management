<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Payment Terms: Advance % -->
    <record id="view_payment_term_form_inherit_advance" model="ir.ui.view">
        <field name="name">account.payment.term.form.inherit.advance</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <label for="advance_percent"/>
                <div class="o_row">
                    <field name="advance_percent" class="oe_inline"/>
                    <span>% of the purchase order, payable in advance after confirmation</span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Purchase order: Request Advance + Advances smart button -->
    <record id="purchase_order_form_inherit_advance" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.advance</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_request_advance" type="object" string="Request Advance"
                        class="btn-primary" invisible="not can_request_advance"/>
                <field name="can_request_advance" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_advances" class="oe_stat_button"
                        icon="fa-money" invisible="not advance_count">
                    <field name="advance_count" widget="statinfo" string="Advances"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="advance_percent" invisible="not advance_percent" string="Advance %"/>
                <field name="advance_requested" invisible="not advance_count"/>
                <field name="advance_paid" invisible="not advance_count"/>
            </xpath>
        </field>
    </record>

    <!-- Payment: Finance Confirm / Reject for advance requests -->
    <record id="view_account_payment_form_inherit_advance" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_post']" position="attributes">
                <attribute name="invisible">state != 'draft' or (purchase_advance_id and (advance_state != 'requested' or not can_advance_finance))</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">not id or not (state == 'draft' or (state == 'in_process' and is_sent)) or (purchase_advance_id and advance_state == 'requested')</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_advance_reject" type="object" string="Reject" class="btn-danger"
                        invisible="not purchase_advance_id or advance_state != 'requested' or state != 'draft' or not can_advance_finance"/>
                <field name="can_advance_finance" invisible="1"/>
            </xpath>
            <xpath expr="//header" position="after">
                <div class="alert alert-warning mb-0" role="status"
                     invisible="not purchase_advance_id or advance_state != 'requested'">
                    Advance requested by <field name="advance_requested_by" readonly="1" class="d-inline"/>
                    - waiting for <strong>Finance</strong> to confirm.
                </div>
            </xpath>
            <xpath expr="//field[@name='memo']" position="after">
                <field name="purchase_advance_id" invisible="not purchase_advance_id"/>
                <field name="advance_state" invisible="not purchase_advance_id" widget="badge"
                       decoration-warning="advance_state == 'requested'"
                       decoration-success="advance_state == 'approved'"
                       decoration-danger="advance_state == 'rejected'"/>
            </xpath>
        </field>
    </record>

    <!-- Wizards -->
    <record id="view_purchase_advance_request_wizard_form" model="ir.ui.view">
        <field name="name">purchase.advance.request.wizard.form</field>
        <field name="model">purchase.advance.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Advance">
                <field name="order_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <p class="text-muted">
                    A draft payment is created and Purchase Finance is emailed to confirm it.
                </p>
                <group>
                    <group>
                        <field name="amount_total"/>
                        <field name="advance_percent" string="Advance %"/>
                        <field name="advance_requested"/>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="date"/>
                        <field name="memo"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm_request" type="object" string="Request" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_purchase_advance_reject_wizard_form" model="ir.ui.view">
        <field name="name">purchase.advance.reject.wizard.form</field>
        <field name="model">purchase.advance.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Advance">
                <field name="payment_id" invisible="1"/>
                <p class="text-muted">The requester is emailed this reason.</p>
                <field name="reason" placeholder="Why is this advance rejected?"/>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Reject" class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
