<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cron_update_vendor_compliance_status" model="ir.cron">
        <field name="name">Update Vendor Compliance Status</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.search([('is_vendor', '=', True)])._compute_compliance_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
