<odoo>
    <record id="cron_document_expiry_reminder" model="ir.cron">
        <field name="name">Vendor Document Expiry Reminder</field>
        <field name="model_id" ref="vendor_management.model_vendor_document"/>
        <field name="state">code</field>
        <field name="code">model.action_send_expiry_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
