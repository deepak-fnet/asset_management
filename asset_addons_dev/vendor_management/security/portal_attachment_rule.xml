<odoo>
    <record id="portal_vendor_attachment_rule" model="ir.rule">
        <field name="name">Portal Vendor Attachment Access</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            ['|', '|',
                '&amp;', ('res_model', '=', 'vendor.document'), ('res_id', 'in', user.partner_id.document_ids.ids),
                '&amp;', ('res_model', '=', 'res.partner'), ('res_id', '=', user.partner_id.id),
                '&amp;', ('res_model', '=', 'vendor.quote'), ('res_id', 'in', user.partner_id.quote_ids.ids)
            ]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="portal_vendor_quote_rule" model="ir.rule">
        <field name="name">Portal Vendor Quote Access</field>
        <field name="model_id" ref="vendor_management.model_vendor_quote"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('vendor_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="portal_vendor_quote_line_rule" model="ir.rule">
        <field name="name">Portal Vendor Quote Line Access</field>
        <field name="model_id" ref="vendor_management.model_vendor_quote_line"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('quote_id.vendor_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="portal_vendor_purchase_order_rule" model="ir.rule">
        <field name="name">Portal Vendor Purchase Order Access</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            ['|',
                ('partner_id', '=', user.partner_id.id),
                ('vendor_ids', 'in', [user.partner_id.id])
            ]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>