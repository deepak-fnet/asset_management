<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="group_vendor_user" model="res.groups">
        <field name="name">Vendor User</field>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('account.group_account_invoice')),
            (4, ref('stock.group_stock_user')),
            (4, ref('sales_team.group_sale_salesman')),
            (4, ref('website.group_website_designer'))
        ]"/>
    </record>

    <record id="group_vendor_manager" model="res.groups">
        <field name="name">Vendor Manager</field>
        <field name="implied_ids" eval="[
            (4, ref('vendor_management.group_vendor_user')),
            (4, ref('purchase.group_purchase_manager')),
            (4, ref('account.group_account_manager')),
            (4, ref('stock.group_stock_manager')),
            (4, ref('sales_team.group_sale_manager'))
        ]"/>
    </record>

    <record id="group_vendor_md" model="res.groups">
        <field name="name">Vendor MD</field>
        <field name="implied_ids" eval="[
            (4, ref('vendor_management.group_vendor_manager'))
        ]"/>
    </record>

    <!-- Functional purchase-process roles (independent of the Vendor
         User/Manager/MD ladder above): these gate the RFQ -> comparison ->
         confirm -> receive -> bill workflow buttons. Named group_purchase_role_*
         (not group_purchase_user) to avoid a near-duplicate of core's own
         purchase.group_purchase_user string in groups= attributes. -->
    <record id="group_purchase_role_user" model="res.groups">
        <field name="name">Purchase User</field>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('account.group_account_invoice'))
        ]"/>
    </record>

    <record id="group_purchase_role_stores" model="res.groups">
        <field name="name">Purchase Stores</field>
        <field name="implied_ids" eval="[
            (4, ref('purchase.group_purchase_user')),
            (4, ref('stock.group_stock_user'))
        ]"/>
    </record>

    <record id="group_purchase_role_finance" model="res.groups">
        <field name="name">Purchase Finance</field>
        <field name="implied_ids" eval="[
            (4, ref('purchase.group_purchase_user')),
            (4, ref('account.group_account_invoice'))
        ]"/>
    </record>

</odoo>
