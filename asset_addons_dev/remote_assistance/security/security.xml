<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_remote_assistance"
                model="ir.module.category">
            <field name="name">Remote Assistance</field>
            <field name="sequence">20</field>
        </record>

        <!-- Odoo 19: group categories are expressed through
             res.groups.privilege, which in turn points at the
             ir.module.category. res.groups.category_id no longer exists. -->
        <record id="privilege_remote_assistance"
                model="res.groups.privilege">
            <field name="name">Remote Assistance</field>
            <field name="sequence">20</field>
            <field name="category_id"
                   ref="module_category_remote_assistance"/>
        </record>

        <record id="group_remote_assistance_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_remote_assistance"/>
            <field name="comment">Can create and run remote assistance
                sessions.</field>
        </record>

        <record id="group_remote_assistance_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_remote_assistance"/>
            <field name="implied_ids"
                   eval="[(4, ref('group_remote_assistance_user'))]"/>
            <!-- Odoo 19: res.groups.users was renamed to user_ids. -->
            <field name="user_ids"
                   eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- A user only sees the sessions for which they are the admin;
             managers see everything.
             Note: ir.rule.groups keeps its name in Odoo 19. -->
        <record id="rule_remote_session_own" model="ir.rule">
            <field name="name">Remote sessions: own only</field>
            <field name="model_id" ref="model_remote_assistance_session"/>
            <field name="domain_force">[('admin_user_id', '=', user.id)]</field>
            <field name="groups"
                   eval="[(4, ref('group_remote_assistance_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_remote_session_all" model="ir.rule">
            <field name="name">Remote sessions: all</field>
            <field name="model_id" ref="model_remote_assistance_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('group_remote_assistance_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
