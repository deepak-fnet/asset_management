<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_remote_invitation" model="mail.template">
            <field name="name">Remote Assistance: Invitation</field>
            <field name="model_id" ref="model_remote_assistance_session"/>
            <field name="subject">Remote assistance request from {{ object.company_id.name }}</field>
            <field name="email_from">{{ (object.admin_user_id.email or object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.customer_email }}</field>
            <field name="body_html" type="html">
<div style="margin:0;padding:0;background:#f2f4f8;font-family:Arial,Helvetica,sans-serif;">
  <div style="max-width:560px;margin:0 auto;padding:24px;">
    <div style="background:#ffffff;border:1px solid #e3e7ef;border-radius:14px;padding:28px;">
      <p style="font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#2563eb;margin:0 0 10px;">Remote Assistance</p>
      <p style="font-size:16px;color:#111827;margin:0 0 18px;line-height:1.5;">
        <strong t-out="object.company_id.name or 'The administrator'">FutureNet Technology</strong>
        has requested permission to remotely assist your computer.
      </p>
      <table style="width:100%;border-collapse:collapse;margin:0 0 8px;">
        <tr>
          <td style="padding:10px 12px;background:#f7f9fc;border-radius:8px;color:#6b7280;font-size:12px;text-transform:uppercase;">Reason</td>
        </tr>
        <tr><td style="padding:6px 12px 14px;color:#111827;" t-out="object.reason or ''">Check settings and troubleshoot.</td></tr>
        <tr>
          <td style="padding:10px 12px;background:#f7f9fc;border-radius:8px;color:#6b7280;font-size:12px;text-transform:uppercase;">Requested Duration</td>
        </tr>
        <tr><td style="padding:6px 12px 4px;color:#111827;"><t t-out="object.duration_minutes or 30"/> Minutes</td></tr>
      </table>
      <div style="margin:24px 0 8px;">
        <a t-att-href="'%s/remote/invite/%s/accept' % (object._base_url(), object.session_token)"
           style="display:inline-block;background:#16a34a;color:#ffffff;text-decoration:none;padding:13px 26px;border-radius:10px;font-weight:bold;margin-right:8px;">Accept</a>
        <a t-att-href="'%s/remote/invite/%s/reject' % (object._base_url(), object.session_token)"
           style="display:inline-block;background:#e5e7eb;color:#111827;text-decoration:none;padding:13px 26px;border-radius:10px;font-weight:bold;">Reject</a>
      </div>
      <p style="font-size:12px;color:#8a94a6;line-height:1.5;margin-top:18px;">
        If you accept, you will download and run a small one-time program so the
        administrator can view your screen. You can stop the session at any
        time, and nothing is left installed on your computer afterwards.
      </p>
      <p style="font-size:12px;color:#b6bdca;margin-top:10px;">
        If the buttons do not work, open this link:
        <a t-att-href="'%s/remote/invite/%s' % (object._base_url(), object.session_token)"
           t-out="'%s/remote/invite/%s' % (object._base_url(), object.session_token)"
           style="color:#2563eb;">link</a>
      </p>
    </div>
  </div>
</div>
            </field>
        </record>
    </data>
</odoo>
