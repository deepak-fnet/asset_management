<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="asset_fleet.Asset360.bar">
  <div class="win-bar"><i class="d r"/><i class="d y"/><i class="d g"/><span class="t"><i t-attf-class="fa #{icon}"/> <t t-esc="title"/></span><small t-if="meta" t-esc="meta"/></div>
</t>

<t t-name="asset_fleet.Asset360">
<div class="o_action a360">
  <t t-if="state.loading and !state.data"><div class="a360-loading"><div class="a360-spin"/><span>booting asset 360<b class="blink">_</b></span></div></t>
  <t t-elif="state.data and state.data.error"><div class="a360-loading" t-esc="state.data.error"/></t>
  <t t-elif="state.data">
  <t t-set="d" t-value="state.data"/>
  <t t-set="s" t-value="screen"/>
  <t t-set="x" t-value="d.details"/>
  <t t-set="fx" t-value="d.fixed"/>
  <div class="a360-shell">
    <!-- =========================== EXPLORER =========================== -->
    <aside class="a360-nav">
      <div class="nav-head"><i class="fa fa-terminal"/> asset-360</div>
      <div class="nav-file"><i class="fa fa-laptop"/> <span t-esc="d.asset.code or d.asset.serial"/></div>
      <t t-foreach="sections" t-as="sec" t-key="sec[0]">
        <a t-attf-class="nav-item #{state.section === sec[0] ? 'on' : ''}" t-on-click="() => this.jump(sec[0])"><i t-attf-class="fa #{sec[2]}"/><span t-esc="sec[1]"/></a>
      </t>
      <div class="nav-foot">
        <span t-attf-class="st #{d.device.online ? 'on' : ''}"><i class="dot"/><t t-esc="d.device.online ? 'online' : 'offline'"/></span>
        <small>auto-refresh 60s</small>
      </div>
    </aside>

    <div class="o_content a360-scroll" t-ref="scroll">
    <div class="a360-wrap">

    <!-- ============================= HERO ============================= -->
    <section class="a360-hero" data-sec="overview">
      <div class="laptop">
        <div class="lid">
          <div class="cam"/>
          <div class="screen">
            <div class="topbar"><span>Activities</span><span t-esc="localDate(s.day || '')"/><span><i class="fa fa-wifi"/> <i class="fa fa-battery-three-quarters"/> <t t-esc="round(d.live.battery)"/>%</span></div>
            <div class="desk">
              <div class="who">
                <img t-if="d.employee" t-att-src="d.employee.image" class="av" t-on-click="openEmployee" alt=""/>
                <div t-else="" class="av empty"><i class="fa fa-user"/></div>
                <b t-esc="d.employee ? d.employee.name : 'Unassigned'"/>
                <small t-esc="d.device.hostname or d.asset.serial"/>
              </div>
              <div class="term">
                <div><span class="p">$</span> status</div>
                <div t-attf-class="#{d.device.online ? 'ok' : 'warn'}">● <t t-esc="d.device.online ? 'online' : 'offline'"/> · seen <t t-esc="ago(d.device.last_seen)"/></div>
                <div><span class="p">$</span> whereami</div>
                <div class="ok" t-esc="(d.location.city or 'unknown') + (d.location.accuracy ? ' ±' + d.location.accuracy + 'm' : '')"/>
                <div><span class="p">$</span> uptime-today</div>
                <div class="ok"><t t-esc="fmtMin(s.active)"/> active / <t t-esc="fmtMin(s.on)"/> on</div>
                <div><span class="p">$</span><b class="blink">_</b></div>
              </div>
            </div>
            <div class="dock"><t t-foreach="(s.apps or []).slice(0, 7)" t-as="a" t-key="a_index"><img t-if="a.icon" t-att-src="a.icon" t-att-title="a.name" alt=""/><span t-else="" class="noicon sm" t-esc="initials(a.name)" t-att-title="a.name"/></t></div>
          </div>
        </div>
        <div class="base"><div class="notch"/></div>
      </div>
      <div class="hero-info">
        <div class="kicker"><t t-esc="d.asset.code"/> · <t t-esc="d.asset.category"/></div>
        <h1 t-esc="d.asset.name"/>
        <div class="sub">
          <t t-if="d.employee"><i class="fa fa-user"/> <a t-on-click="openEmployee" t-esc="d.employee.name"/><t t-if="d.employee.job"> · <t t-esc="d.employee.job"/></t></t>
          <t t-else=""><i class="fa fa-user-times"/> Not assigned</t>
          <t t-if="d.asset.department"> · <t t-esc="d.asset.department"/></t>
        </div>
        <div class="sub" t-if="d.asset.site"><i class="fa fa-building"/> <t t-esc="d.asset.site"/></div>
        <div class="contact" t-if="d.employee">
          <a t-if="d.employee.email" t-att-href="'mailto:' + d.employee.email"><i class="fa fa-envelope"/> <t t-esc="d.employee.email"/></a>
          <a t-if="d.employee.phone" t-att-href="'tel:' + d.employee.phone"><i class="fa fa-phone"/> <t t-esc="d.employee.phone"/></a>
        </div>
        <div class="greet"><i class="fa fa-bolt"/> <t t-esc="greeting"/></div>
        <div class="chips">
          <span><i class="fa fa-linux"/> <t t-esc="d.device.os or '—'"/></span>
          <span t-if="d.device.processor"><i class="fa fa-microchip"/> <t t-esc="d.device.processor"/></span>
          <span t-if="d.device.ram"><i class="fa fa-server"/> <t t-esc="d.device.ram"/> GB</span>
          <span t-if="d.device.storage"><i class="fa fa-hdd-o"/> <t t-esc="d.device.storage"/> GB</span>
          <span t-if="d.device.ip"><i class="fa fa-sitemap"/> <t t-esc="d.device.ip"/></span>
          <span><i class="fa fa-barcode"/> <t t-esc="d.asset.serial"/></span>
          <span t-if="d.asset.state"><i class="fa fa-flag"/> <t t-esc="d.asset.state"/></span>
        </div>
        <div class="btns">
          <button class="btn" t-on-click="openAsset"><i class="fa fa-cube"/> Fixed asset</button>
          <button class="btn" t-if="d.asset.it_id != d.asset.id" t-on-click="openIt"><i class="fa fa-laptop"/> IT asset</button>
          <button class="btn" t-if="fx.po_id" t-on-click="openPo"><i class="fa fa-shopping-cart"/> PO</button>
          <button class="btn" t-if="fx.bill_id" t-on-click="openBill"><i class="fa fa-file-text-o"/> Bill</button>
          <button class="btn" t-on-click="() => this.load()" title="Refresh"><i t-attf-class="fa fa-refresh #{state.loading ? 'fa-spin' : ''}"/></button>
        </div>
      </div>
    </section>

    <!-- KPI strip -->
    <section class="a360-kpis">
      <div class="kpi c-violet"><span>active today</span><b t-esc="fmtMin(s.active)"/><small t-if="trend" t-attf-class="#{trend.up ? 'up' : 'down'}"><t t-esc="trend.txt"/></small><small t-else="">goal <t t-esc="(s.target or 480) / 60"/>h</small></div>
      <div class="kpi c-cyan"><span>last 7 days</span><b t-esc="fmtMin(s.week_total)"/><small>avg <t t-esc="fmtMin(s.week_avg)"/>/day</small></div>
      <div class="kpi c-green"><span>focus</span><b t-esc="productivity + '%'"/><small>active while on</small></div>
      <div class="kpi c-orange"><span>streak</span><b><t t-esc="streak"/>d</b><small>4h+ days in a row</small></div>
      <div class="kpi c-yellow"><span>workday</span><b t-esc="fmtMin(workday)"/><small><t t-esc="localTime(s.first_on)"/> → <t t-esc="localTime(s.last_on)"/></small></div>
      <div class="kpi c-pink"><span>worth today</span><b t-esc="money(d.finance.value)"/><small><t t-esc="d.finance.dep_pct"/>% depreciated</small></div>
    </section>

    <!-- =========================== SCREEN TIME =========================== -->
    <div class="a360-row" data-sec="screen">
      <section class="win c8">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-clock-o'"/><t t-set="title" t-value="'screen-time.day'"/><t t-set="meta" t-value="s.has_data ? localDate(s.day) : 'no data'"/></t>
        <div class="win-body" t-if="s.has_data">
          <div class="daynav">
            <button class="btn" t-att-disabled="!canPrev" t-on-click="() => this.shiftDay(-1)"><i class="fa fa-chevron-left"/></button>
            <b t-esc="localDate(s.day)"/>
            <button class="btn" t-att-disabled="!canNext" t-on-click="() => this.shiftDay(1)"><i class="fa fa-chevron-right"/></button>
          </div>
          <div class="today">
            <t t-set="rg" t-value="ring(s.active, s.target)"/>
            <div class="ring">
              <svg viewBox="0 0 128 128">
                <defs><linearGradient id="a360g" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#a371f7"/><stop offset="100%" stop-color="#39d0d8"/></linearGradient></defs>
                <circle cx="64" cy="64" r="54" class="track"/>
                <circle cx="64" cy="64" r="54" class="fill" stroke="url(#a360g)" t-att-stroke-dasharray="rg.dash" transform="rotate(-90 64 64)"/>
              </svg>
              <div class="lbl"><b t-esc="fmtMin(s.active)"/><small><t t-esc="rg.pct"/>% of <t t-esc="s.target / 60"/>h</small></div>
            </div>
            <div class="stats">
              <div><span>on</span><b t-esc="fmtMin(s.on)"/></div>
              <div><span>active</span><b class="g" t-esc="fmtMin(s.active)"/></div>
              <div><span>idle</span><b class="y" t-esc="fmtMin(s.idle)"/></div>
              <div><span>locked</span><b class="m" t-esc="fmtMin(s.locked)"/></div>
              <div><span>first on</span><b t-esc="localTime(s.first_on)"/></div>
              <div><span>last on</span><b t-esc="localTime(s.last_on)"/></div>
            </div>
          </div>
          <div class="hourly">
            <div class="cap">// active minutes per hour</div>
            <div class="bars">
              <t t-foreach="s.hourly" t-as="v" t-key="v_index">
                <div class="h" t-att-title="pad2(v_index) + ':00 · ' + v + ' min'"><div t-attf-class="b #{hourCls(v)}" t-att-style="hourBar(v)"/><span t-esc="hourLabel(v_index)"/></div>
              </t>
            </div>
          </div>
          <div class="timeline">
            <div class="bar"><t t-foreach="s.segments" t-as="seg" t-key="seg_index"><div t-attf-class="seg #{seg.state}" t-att-style="segStyle(seg)" t-att-title="seg.state + ' ' + seg.from + '–' + seg.to + ' (' + seg.dur + ')'"/></t></div>
            <div class="hours"><t t-foreach="[0,3,6,9,12,15,18,21,24]" t-as="h" t-key="h"><span t-attf-style="left:#{h / 24 * 100}%" t-esc="pad2(h)"/></t></div>
            <div class="legend"><i class="lg active"/>active <i class="lg idle"/>idle <i class="lg locked"/>locked <i class="lg off"/>off</div>
          </div>
        </div>
        <div class="win-body empty" t-else="">No screen time yet — starts once the agent is updated and the user logs in again.</div>
      </section>
      <section class="win c4">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-list'"/><t t-set="title" t-value="'sessions.log'"/><t t-set="meta" t-value="(s.segments or []).length + ' periods'"/></t>
        <div class="win-body">
          <ul class="sessions">
            <t t-foreach="s.segments or []" t-as="seg" t-key="seg_index"><li t-attf-class="#{seg.state}"><span class="dot"/><b><t t-esc="seg.from"/>–<t t-esc="seg.to"/></b><span class="st" t-esc="seg.state"/><span class="du" t-esc="seg.dur"/></li></t>
            <li t-if="!(s.segments and s.segments.length)" class="muted">no periods</li>
          </ul>
        </div>
      </section>
    </div>

    <div class="a360-row" data-sec="apps" t-if="s.has_data">
      <section class="win c5">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-th-large'"/><t t-set="title" t-value="'apps.usage'"/><t t-set="meta" t-value="s.apps.length + ' apps · tap one'"/></t>
        <div class="win-body">
          <div class="applist">
            <t t-foreach="s.apps" t-as="a" t-key="a_index">
              <div t-attf-class="app #{state.app === a.name ? 'sel' : ''}" t-on-click="() => this.pickApp(a.name)">
                <span class="rank" t-esc="a_index + 1"/>
                <img t-if="a.icon" t-att-src="a.icon" alt=""/><span t-else="" class="noicon" t-esc="initials(a.name)"/>
                <div class="nm"><span t-esc="a.name"/><div class="track"><div class="fill" t-att-style="pctFill(a.share)"/></div></div>
                <div class="tm"><b t-esc="fmtMin(a.minutes)"/><small t-esc="a.share + '%'"/></div>
              </div>
            </t>
          </div>
          <div class="appweek" t-if="appDays">
            <div class="cap">// <t t-esc="state.app"/> · 7 days</div>
            <div class="bars"><t t-foreach="appDays" t-as="m" t-key="m_index"><div class="col"><small t-esc="fmtMin(m)"/><div class="b" t-att-style="appBar(m)"/><span t-esc="s.week[m_index].label"/></div></t></div>
          </div>
        </div>
      </section>
      <section class="win c7">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-calendar'"/><t t-set="title" t-value="'week.chart'"/><t t-set="meta" t-value="'avg ' + fmtMin(s.week_avg) + '/day'"/></t>
        <div class="win-body">
          <div class="weekbars">
            <t t-foreach="s.week" t-as="w" t-key="w.date">
              <div t-attf-class="col #{w.date === s.day ? 'sel' : ''}" t-on-click="() => this.pickDay(w.date)">
                <b t-esc="fmtMin(w.active)"/>
                <div class="stack"><div class="b locked" t-att-style="barStyle(w, 'locked')"/><div class="b idle" t-att-style="barStyle(w, 'idle')"/><div class="b active" t-att-style="barStyle(w, 'active')"/></div>
                <span t-esc="w.label"/><small t-esc="w.day"/>
              </div>
            </t>
          </div>
          <div class="heat">
            <div class="cap">// when they work</div>
            <div class="hd"><span/><t t-foreach="hours24" t-as="h" t-key="h"><span t-esc="hourLabel(h)"/></t></div>
            <t t-foreach="s.heat" t-as="row" t-key="row_index"><div class="rw"><span t-esc="heatDays[row_index]"/><t t-foreach="row" t-as="v" t-key="v_index"><i t-att-style="heatStyle(v)" t-att-title="heatDays[row_index] + ' ' + pad2(v_index) + ':00 · ' + v + ' min'"/></t></div></t>
          </div>
        </div>
      </section>
    </div>

    <!-- ============================= DEVICE ============================= -->
    <div class="a360-row" data-sec="device">
      <section class="win c5">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-tachometer'"/><t t-set="title" t-value="'system.monitor'"/><t t-set="meta" t-value="d.device.uptime ? 'up ' + d.device.uptime : ''"/></t>
        <div class="win-body">
          <div class="gauges">
            <t t-foreach="[['CPU', d.live.cpu], ['RAM', d.live.ram], ['DISK', d.live.disk], ['BATT', d.live.battery]]" t-as="gg" t-key="gg[0]">
              <t t-set="gv" t-value="gauge(gg[1])"/>
              <div class="gauge">
                <svg viewBox="0 0 80 80"><circle cx="40" cy="40" r="34" class="track" t-att-stroke-dasharray="gv.base" transform="rotate(135 40 40)"/><circle cx="40" cy="40" r="34" class="fill" t-att-stroke="gg[0] === 'BATT' ? '#3fb950' : gv.color" t-att-stroke-dasharray="gv.dash" transform="rotate(135 40 40)"/></svg>
                <b><t t-esc="round(gg[1])"/>%</b><span t-esc="gg[0]"/>
              </div>
            </t>
          </div>
          <div class="net"><span><i class="fa fa-arrow-up"/> <t t-esc="d.live.up"/> Mbps</span><span><i class="fa fa-arrow-down"/> <t t-esc="d.live.down"/> Mbps</span><span t-if="d.live.battery_health"><i class="fa fa-heart"/> battery health <t t-esc="d.live.battery_health"/>%</span></div>
        </div>
      </section>
      <section class="win c7">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-microchip'"/><t t-set="title" t-value="'hardware.json'"/><t t-set="meta" t-value="''"/></t>
        <div class="win-body two">
          <table class="kv"><t t-foreach="x.specs" t-as="sp" t-key="sp_index"><tr><th t-esc="sp[0]"/><td t-esc="sp[1]"/></tr></t></table>
          <div class="vols">
            <t t-foreach="x.storage" t-as="v" t-key="v_index">
              <div class="vol"><div class="vh"><b><i class="fa fa-hdd-o"/> <t t-esc="v.name"/></b><span><t t-esc="v.used"/>/<t t-esc="v.total"/> GB</span></div>
                <div class="track"><div t-attf-class="fill #{storCls(v.pct)}" t-att-style="pctFill(v.pct)"/></div><small><t t-esc="v.free"/> GB free · <t t-esc="v.pct"/>%</small></div>
            </t>
            <div t-if="!x.storage.length" class="muted">no volumes reported</div>
          </div>
        </div>
      </section>
    </div>

    <!-- ========================= SOFTWARE & UPDATES ========================= -->
    <div class="a360-row" data-sec="software">
      <section class="win c6">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-download'"/><t t-set="title" t-value="'updates.pending'"/><t t-set="meta" t-value="d.health.os_pending + ' os · ' + d.health.app_pending + ' apps'"/></t>
        <div class="win-body two">
          <div><div class="cap">// os packages</div><ul class="mini"><t t-foreach="x.os_patches" t-as="u" t-key="u_index"><li><i class="fa fa-cube"/><b t-esc="u.name"/><small><t t-esc="u.from"/> → <t t-esc="u.to"/></small></li></t><li t-if="!x.os_patches.length" class="muted">up to date</li></ul></div>
          <div><div class="cap">// applications</div><ul class="mini"><t t-foreach="x.app_updates" t-as="u" t-key="u_index"><li><i class="fa fa-arrow-circle-up"/><b t-esc="u.name"/><small><t t-esc="u.from"/> → <t t-esc="u.to"/></small></li></t><li t-if="!x.app_updates.length" class="muted">up to date</li></ul></div>
        </div>
      </section>
      <section class="win c6">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-cubes'"/><t t-set="title" t-value="'software.installed'"/><t t-set="meta" t-value="x.installed_total + ' packages'"/></t>
        <div class="win-body">
          <div class="cap">// recently installed</div>
          <ul class="mini"><t t-foreach="x.recent_installs" t-as="a" t-key="a_index"><li><span class="noicon sm" t-esc="initials(a.name)"/><b t-esc="a.name"/><small><t t-esc="a.version"/><t t-if="a.date"> · <t t-esc="localDate(a.date)"/></t></small></li></t></ul>
        </div>
      </section>
    </div>

    <!-- ============================= OS UPGRADE ============================= -->
    <div class="a360-row" data-sec="osupgrade">
      <section class="win c12">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-level-up'"/><t t-set="title" t-value="'os-upgrade'"/><t t-set="meta" t-value="d.osu.checked ? 'checked ' + d.osu.checked : ''"/></t>
        <div class="win-body">
          <div class="osu-path">
            <div class="node now"><small>installed</small><b t-esc="d.osu.current or '—'"/><span t-esc="d.osu.codename"/></div>
            <div t-attf-class="arrow #{d.osu.available ? 'on' : ''}"><i class="fa fa-long-arrow-right"/><small t-esc="d.osu.available ? 'upgrade available' : 'up to date'"/></div>
            <div t-attf-class="node next #{d.osu.available ? '' : 'dim'}"><small>available</small><b t-esc="d.osu.available_version or '—'"/><span t-esc="d.osu.available_codename"/></div>
            <div class="node" t-if="d.osu.win11"><small>windows 11</small><b t-esc="d.osu.win11"/></div>
          </div>
          <table class="grid" t-if="d.osu.requests.length">
            <thead><tr><th>Request</th><th>From → To</th><th>Scheduled</th><th>Started</th><th>Completed</th><th>Status</th></tr></thead>
            <tbody>
              <t t-foreach="d.osu.requests" t-as="r" t-key="r.id">
                <tr><td><b t-esc="r.name"/></td><td><t t-esc="r.from"/> → <t t-esc="r.to"/></td><td t-esc="r.scheduled"/><td t-esc="r.started"/><td t-esc="r.completed"/><td><span t-attf-class="pill #{osuCls(r.state_key)}" t-esc="r.state"/></td></tr>
                <tr t-if="r.error" class="err"><td colspan="6"><pre t-esc="r.error"/></td></tr>
              </t>
            </tbody>
          </table>
          <div t-else="" class="muted">no upgrade requests</div>
        </div>
      </section>
    </div>

    <!-- ============================= SECURITY ============================= -->
    <div class="a360-row" data-sec="security">
      <section class="win c5">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-shield'"/><t t-set="title" t-value="'security.posture'"/><t t-set="meta" t-value="d.health.policy"/></t>
        <div class="win-body">
          <div t-attf-class="av-state #{d.health.antivirus.running ? 'ok' : 'bad'}"><i t-attf-class="fa #{d.health.antivirus.running ? 'fa-shield' : 'fa-exclamation-triangle'}"/> <t t-esc="d.health.antivirus.running ? (d.health.antivirus.product or 'antivirus running') : 'no antivirus running'"/></div>
          <div class="vuln"><div class="v crit"><b t-esc="d.health.vuln.critical"/><span>critical</span></div><div class="v high"><b t-esc="d.health.vuln.high"/><span>high</span></div><div class="v med"><b t-esc="d.health.vuln.medium"/><span>medium</span></div><div class="v low"><b t-esc="d.health.vuln.low"/><span>low</span></div></div>
          <ul class="mini" t-if="x.cves.length"><t t-foreach="x.cves" t-as="c" t-key="c_index"><li><span t-attf-class="sev #{sevCls(c.severity)}" t-esc="c.score"/><b t-esc="c.cve"/><small t-esc="c.software"/></li></t></ul>
          <div class="locks" t-if="d.health.restrictions.screenshot !== undefined">
            <span t-attf-class="lock #{d.health.restrictions.screenshot ? 'on' : ''}"><i class="fa fa-camera"/> screenshots</span>
            <span t-attf-class="lock #{d.health.restrictions.record ? 'on' : ''}"><i class="fa fa-video-camera"/> recording</span>
            <span t-attf-class="lock #{d.health.restrictions.usb and d.health.restrictions.usb !== 'allow' ? 'on' : ''}"><i class="fa fa-usb"/> usb:<t t-esc="d.health.restrictions.usb"/></span>
            <span t-attf-class="lock #{d.health.restrictions.websites ? 'on' : ''}"><i class="fa fa-globe"/> <t t-esc="d.health.restrictions.websites or 0"/> sites</span>
            <span t-attf-class="lock #{d.health.restrictions.extensions ? 'on' : ''}"><i class="fa fa-puzzle-piece"/> <t t-esc="d.health.restrictions.extensions"/> ext</span>
          </div>
        </div>
      </section>
      <section class="win c7">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-bell'"/><t t-set="title" t-value="'security.events'"/><t t-set="meta" t-value="''"/></t>
        <div class="win-body"><ul class="feed"><t t-foreach="x.security" t-as="f" t-key="f_index"><li><span class="dot sec"/><div><small><t t-esc="localDate(f.date)"/> · <t t-esc="f.type"/> · <t t-esc="f.action"/></small><p t-esc="f.text"/></div></li></t><li t-if="!x.security.length" class="muted">no events</li></ul></div>
      </section>
    </div>

    <!-- ============================= LOCATION ============================= -->
    <div class="a360-row" data-sec="location">
      <section class="win c7">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-map-marker'"/><t t-set="title" t-value="'gps.map'"/><t t-set="meta" t-value="d.location.source + (d.location.accuracy ? ' ±' + d.location.accuracy + 'm' : '')"/></t>
        <div class="win-body">
          <iframe t-if="mapUrl" t-att-src="mapUrl" loading="lazy" title="map"/>
          <div t-else="" class="nomap">no location yet</div>
          <div class="addr" t-if="d.location.address"><i class="fa fa-map-pin"/> <t t-esc="d.location.address"/></div>
        </div>
      </section>
      <section class="win c5">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-history'"/><t t-set="title" t-value="'places.log'"/><t t-set="meta" t-value="ago(d.location.updated)"/></t>
        <div class="win-body"><ul class="places"><t t-foreach="d.location.history" t-as="h" t-key="h_index"><li><span class="when" t-esc="localDate(h.date) + ' ' + localTime(h.date)"/><b t-esc="h.city or '—'"/><small t-esc="h.source"/></li></t><li t-if="!d.location.history.length" class="muted">no history</li></ul></div>
      </section>
    </div>

    <!-- ============================= PROCUREMENT ============================= -->
    <div class="a360-row" data-sec="procurement">
      <section class="win c6">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-shopping-cart'"/><t t-set="title" t-value="'procurement'"/><t t-set="meta" t-value="''"/></t>
        <div class="win-body">
          <div class="money"><div><span>purchase cost</span><b t-esc="money(d.finance.cost)"/></div><div><span>worth today</span><b t-esc="money(d.finance.value)"/></div></div>
          <table class="kv"><t t-foreach="fx.procurement" t-as="i" t-key="i_index"><tr><th t-esc="i.label"/><td t-esc="i.value"/></tr></t></table>
          <div t-if="!fx.procurement.length" class="muted">no procurement details</div>
        </div>
      </section>
      <section class="win c6" data-sec="warranty">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-certificate'"/><t t-set="title" t-value="'warranty+amc'"/><t t-set="meta" t-value="d.finance.warranty_days === false ? '' : d.finance.warranty_days + ' days left'"/></t>
        <div class="win-body">
          <div class="a360-prog"><div class="pl"><span>warranty</span><b t-esc="d.finance.warranty_days === false ? 'not recorded' : (d.finance.warranty_days &gt;= 0 ? d.finance.warranty_days + ' days left' : 'expired')"/></div>
            <div class="track"><div t-attf-class="fill #{d.finance.warranty_days !== false and d.finance.warranty_days &lt; 60 ? 'warn' : ''}" t-att-style="pctFill(warrantyPct())"/></div></div>
          <table class="kv"><t t-foreach="fx.warranty.concat(fx.amc)" t-as="i" t-key="i_index"><tr><th t-esc="i.label"/><td t-esc="i.value"/></tr></t></table>
          <div t-if="fx.claims.length" class="cap">// claims</div>
          <ul class="mini"><t t-foreach="fx.claims" t-as="c" t-key="c_index"><li><i class="fa fa-file-o"/><b t-esc="c.name"/><small t-esc="c.state"/></li></t></ul>
        </div>
      </section>
    </div>

    <!-- ============================= DEPRECIATION ============================= -->
    <div class="a360-row" data-sec="depreciation">
      <section class="win c6">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-line-chart'"/><t t-set="title" t-value="'depreciation'"/><t t-set="meta" t-value="d.finance.dep_pct + '% depreciated'"/></t>
        <div class="win-body">
          <div class="a360-prog"><div class="track"><div class="fill dep" t-att-style="pctFill(d.finance.dep_pct)"/></div></div>
          <table class="kv"><t t-foreach="fx.depreciation" t-as="i" t-key="i_index"><tr><th t-esc="i.label"/><td t-esc="i.value"/></tr></t></table>
          <table class="grid" t-if="fx.schedule.length">
            <thead><tr><th>FY</th><th>Days</th><th>Depreciation</th><th>Accumulated</th><th>Remaining</th></tr></thead>
            <tbody><t t-foreach="fx.schedule" t-as="l" t-key="l_index"><tr><td t-esc="l.year"/><td t-esc="l.days"/><td t-esc="money(l.amount)"/><td t-esc="money(l.acc)"/><td t-esc="money(l.rem)"/></tr></t></tbody>
          </table>
        </div>
      </section>
      <section class="win c6">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-book'"/><t t-set="title" t-value="'accounting.board'"/><t t-set="meta" t-value="''"/></t>
        <div class="win-body">
          <table class="kv"><t t-foreach="fx.accounting" t-as="i" t-key="i_index"><tr><th t-esc="i.label"/><td t-esc="i.value"/></tr></t></table>
          <table class="grid" t-if="fx.board.length">
            <thead><tr><th>Date</th><th>Depreciation</th><th>Cumulative</th><th>Entry</th><th/></tr></thead>
            <tbody><t t-foreach="fx.board" t-as="l" t-key="l_index"><tr><td t-esc="localDate(l.date)"/><td t-esc="money(l.amount)"/><td t-esc="money(l.cum)"/><td t-esc="l.entry"/><td><span t-attf-class="pill #{l.posted ? 'ok' : 'muted'}" t-esc="l.posted ? 'posted' : 'draft'"/></td></tr></t></tbody>
          </table>
          <div t-if="!fx.accounting.length and !fx.board.length" class="muted">no accounting asset</div>
        </div>
      </section>
    </div>

    <!-- ============================= SERVICE & HISTORY ============================= -->
    <div class="a360-row" data-sec="service">
      <section class="win c4">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-wrench'"/><t t-set="title" t-value="'service'"/><t t-set="meta" t-value="''"/></t>
        <div class="win-body">
          <div class="money"><div><span>repairs done</span><b t-esc="d.finance.repairs_done"/></div><div><span>open</span><b t-esc="d.finance.repairs_open"/></div><div><span>maintenance</span><b t-esc="money(d.finance.maintenance_cost)"/></div></div>
          <ul class="mini"><t t-foreach="fx.repairs" t-as="r" t-key="r_index"><li><i class="fa fa-wrench"/><b t-esc="r.name"/><small t-esc="r.state"/></li></t></ul>
          <div class="cap" t-if="fx.licenses.length">// licenses</div>
          <ul class="mini"><t t-foreach="fx.licenses" t-as="l" t-key="l_index"><li><i class="fa fa-key"/><b t-esc="l.name"/></li></t></ul>
        </div>
      </section>
      <section class="win c4">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-users'"/><t t-set="title" t-value="'assignments'"/><t t-set="meta" t-value="''"/></t>
        <div class="win-body"><ul class="assign"><t t-foreach="x.assignments" t-as="h" t-key="h_index"><li><span class="av" t-esc="initials(h.employee)"/><div><b t-esc="h.employee or '—'"/><small><t t-esc="h.action"/> · <t t-esc="localDate(h.date)"/></small></div></li></t><li t-if="!x.assignments.length" class="muted">no assignment history</li></ul></div>
      </section>
      <section class="win c4">
        <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-code-fork'"/><t t-set="title" t-value="'git log'"/><t t-set="meta" t-value="''"/></t>
        <div class="win-body"><ul class="feed"><t t-foreach="d.feed" t-as="f" t-key="f_index"><li><span class="dot"/><div><small><t t-esc="ago(f.date)"/> · <t t-esc="f.author"/></small><p t-esc="f.text"/></div></li></t><li t-if="!d.feed.length" class="muted">nothing yet</li></ul></div>
      </section>
    </div>

    <!-- ============================= ALL DETAILS ============================= -->
    <div class="a360-row" data-sec="all">
      <t t-foreach="d.all" t-as="form" t-key="form_index">
        <section class="win c12">
          <t t-call="asset_fleet.Asset360.bar"><t t-set="icon" t-value="'fa-list-alt'"/><t t-set="title" t-value="form.title"/><t t-set="meta" t-value="form.sections.length + ' tabs'"/></t>
          <div class="win-body">
            <t t-foreach="form.sections" t-as="sec" t-key="sec_index">
              <t t-set="k" t-value="form_index + '-' + sec_index"/>
              <div t-attf-class="fold #{isOpen(k, sec_index) ? 'open' : ''}">
                <a class="fold-h" t-on-click="() => this.toggle(k)"><i t-attf-class="fa #{isOpen(k, sec_index) ? 'fa-chevron-down' : 'fa-chevron-right'}"/> <t t-esc="sec.title"/> <small t-esc="sec.items.length"/></a>
                <div class="fold-b" t-if="isOpen(k, sec_index)">
                  <div class="kvgrid"><t t-foreach="sec.items" t-as="i" t-key="i_index"><div><span t-esc="i.label"/><b t-esc="i.value"/></div></t></div>
                </div>
              </div>
            </t>
          </div>
        </section>
      </t>
    </div>

    <div class="a360-foot">asset-360 · <t t-esc="d.asset.name"/> · refreshed <t t-esc="ago(d.device.last_seen)"/></div>
    </div>
    </div>
  </div>
  </t>
</div>
</t>
</templates>
