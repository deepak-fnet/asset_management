<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- IT asset form = agent data only. Purchase, depreciation, warranty / AMC,
         assignment (+ history), maintenance and audit log live on the fixed
         asset; a live read-only card shows them here (nothing is copied). -->
    <record id="view_asset_it_form_fixed_source" model="ir.ui.view">
        <field name="name">asset.asset.it.form.fixed.source</field>
        <field name="model">asset.asset</field>
        <field name="inherit_id" ref="asset_management.view_asset_asset_form"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <!-- lifecycle runs on the fixed asset -->
            <xpath expr="//header/button[@name='action_assign']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_maintenance']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_scrap']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_reset_to_draft']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('alert')][.//strong[contains(., 'Joining Process')]]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']/button[@name='action_view_assign_processes']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']/button[@name='action_open_exit_process']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']/button[@name='action_view_warranty_claims']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']/button[@name='action_view_repairs']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="fixed_asset_id" invisible="1"/>
                <button name="action_open_fixed_asset" type="object" class="oe_stat_button" icon="fa-building-o"
                        invisible="not fixed_asset_id">
                    <div class="o_stat_info"><span class="o_stat_text">Fixed Asset</span></div>
                </button>
            </xpath>

            <!-- business cards -> one live summary from the fixed asset -->
            <xpath expr="//div[hasclass('specs_grid')]" position="before">
                <field name="fixed_asset_card" nolabel="1" readonly="1" class="w-100 d-block"/>
            </xpath>
            <xpath expr="//div[hasclass('spec_card')][.//span[normalize-space()='Employee Assignment']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('spec_card')][.//span[normalize-space()='Procurement Information']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[div[hasclass('spec_card')][.//span[normalize-space()='Warranty &amp; Maintenance']]]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('spec_card')][.//span[normalize-space()='Warranty &amp; AMC Information']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('spec_card')][.//span[normalize-space()='Maintenance Summary']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('spec_item')][field[@name='location_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('spec_item')][field[@name='maintenance_equipment_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('spec_item')][field[@name='condition']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('spec_item')][field[@name='state']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- history / audit pages live on the fixed asset -->
            <xpath expr="//page[.//field[@name='repair_management_ids']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[.//field[@name='assignment_history_ids']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[.//field[@name='audit_log_ids']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- fixed asset: Update copied everything onto the IT asset - not any more.
         Still offered for network devices (it back-links their assignment). -->
    <record id="view_asset_general_form_no_it_update" model="ir.ui.view">
        <field name="name">asset.asset.general.form.no.it.update</field>
        <field name="model">asset.asset</field>
        <field name="inherit_id" ref="general_asset.view_asset_general_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_update']" position="attributes">
                <attribute name="invisible">not is_submit or not network_asset_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
