<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- IT asset form: assignment, procurement, warranty and maintenance come from the linked fixed asset -->
    <record id="view_asset_it_form_fixed_source" model="ir.ui.view">
        <field name="name">asset.asset.it.form.fixed.source</field>
        <field name="model">asset.asset</field>
        <field name="inherit_id" ref="asset_management.view_asset_asset_form"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="fixed_asset_id" invisible="1"/>
                <div class="alert alert-info d-flex align-items-center gap-2 mb-0 py-2" role="status" invisible="not fixed_asset_id">
                    <i class="fa fa-link"/>
                    <span>Employee assignment, procurement, warranty, AMC and maintenance come from the fixed asset</span>
                    <field name="fixed_asset_id" readonly="1" class="fw-bold" options="{'no_create': True}"/>
                    <span class="text-muted">- edit them there.</span>
                </div>
            </xpath>
            <xpath expr="//field[@name='assigned_employee_id']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='assignment_date']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='acquisition_type']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='purchase_date']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='in_service_date']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='purchase_cost']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='procurement_vendor_id']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_ref']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='warranty_template_id']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='warranty_period_months']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='warranty_start_date']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='warranty_end_date']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='next_maintenance_date']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='vendor_id']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='amc_expiry_date']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='amc_status']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='last_maintenance_date']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='maintenance_type']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='maintenance_status']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='condition']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="attributes">
                <attribute name="readonly">fixed_asset_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
