<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================= Telemetry policies ======================== -->
    <record id="view_asset_agent_policy_list" model="ir.ui.view">
        <field name="name">asset.fleet.policy.list</field>
        <field name="model">asset.fleet.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_default"/>
                <field name="enabled"/>
                <field name="block_screenshot" optional="show"/>
                <field name="block_screen_record" optional="show"/>
                <field name="usb_storage" optional="show"/>
                <field name="remove_admin_rights" optional="hide"/>
                <field name="screen_lock_minutes" optional="hide"/>
                <field name="interval"/>
                <field name="revision"/>
                <field name="asset_count" string="Assets"/>
            </list>
        </field>
    </record>

    <record id="view_asset_agent_policy_form" model="ir.ui.view">
        <field name="name">asset.fleet.policy.form</field>
        <field name="model">asset.fleet.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-desktop">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Servers - every 5 min"/></h1></div>
                    <group>
                        <group>
                            <field name="is_default"/>
                            <field name="enabled"/>
                            <field name="description"/>
                        </group>
                        <group string="Schedule">
                            <field name="interval"/>
                            <field name="snapshot_every"/>
                            <field name="revision"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Telemetry Commands" name="commands">
                            <group>
                                <field name="track_screen_time" widget="boolean_toggle"/>
                                <field name="track_location" widget="boolean_toggle"/>
                            </group>
                            <field name="command_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="key"/>
                                    <field name="command"/>
                                    <field name="platform"/>
                                    <field name="interval"/>
                                    <field name="timeout"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <div class="text-muted">Agent Telemetry stores only these commands' output, under
                                <code>custom.&lt;key&gt;</code>; Telemetry Alert rules can use it.</div>
                        </page>
                        <page string="Restrictions" name="restrictions">
                            <group>
                                <group string="Screen Capture">
                                    <field name="block_screenshot" widget="boolean_toggle"/>
                                    <field name="block_screen_record" widget="boolean_toggle"/>
                                    <field name="auto_block_capture_extensions" widget="boolean_toggle"
                                           invisible="not block_screenshot and not block_screen_record"/>
                                </group>
                                <group string="Device">
                                    <field name="usb_storage" widget="radio" options="{'horizontal': true}"/>
                                    <field name="screen_lock_minutes"/>
                                    <field name="remove_admin_rights" widget="boolean_toggle"/>
                                    <field name="admin_allowed_users" invisible="not remove_admin_rights"
                                           placeholder="itadmin, support"/>
                                </group>
                            </group>
                            <group>
                                <group string="Blocked Websites (all browsers)">
                                    <field name="blocked_websites" nolabel="1" colspan="2"
                                           placeholder="facebook.com&#10;instagram.com&#10;youtube.com&#10;reddit.com/r/all"/>
                                </group>
                                <group string="Blocked Applications">
                                    <field name="blocked_apps" nolabel="1" colspan="2"
                                           placeholder="anydesk&#10;teamviewer&#10;rustdesk&#10;qbittorrent&#10;transmission-gtk"/>
                                </group>
                            </group>
                            <group string="Extra Browser Extensions to Block (optional)">
                                <field name="blocked_extensions" nolabel="1" colspan="2"
                                       placeholder="Only for extensions the automatic check does not catch - one ID per line&#10;Chrome / Edge / Brave: 32-letter ID from chrome://extensions&#10;Firefox: add-on ID from about:support"/>
                            </group>
                            <div class="text-muted">
                                Applied by the agent within a minute on every asset with this policy and undone when
                                switched off. <b>Block Screenshots</b> also stops browser extensions / Firefox
                                screenshots; <b>Block Screen Recording</b> stops extensions and web pages capturing or
                                sharing the screen (Meet, Zoom web, Teams web included). Linux (GNOME) agents.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_asset_agent_policy" model="ir.actions.act_window">
        <field name="name">Telemetry Policies</field>
        <field name="res_model">asset.fleet.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================ Install link ========================== -->
    <record id="view_asset_agent_token_list" model="ir.ui.view">
        <field name="name">asset.fleet.enrollment.token.list</field>
        <field name="model">asset.fleet.enrollment.token</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="server_url"/>
                <field name="relay_url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_asset_agent_token_form" model="ir.ui.view">
        <field name="name">asset.fleet.enrollment.token.form</field>
        <field name="model">asset.fleet.enrollment.token</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_regenerate" type="object" string="Regenerate Token"
                            confirm="The install command with the old token stops working (installed agents keep running). Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Chennai Office"/></h1></div>
                    <group string="Endpoints">
                        <field name="server_url" placeholder="http://192.168.1.10:8069"/>
                        <field name="relay_url" placeholder="ws://192.168.1.10:8766"/>
                        <field name="token" password="True"/>
                        <field name="active"/>
                    </group>
                    <separator string="Install the agent"/>
                    <p class="text-muted">Run on the machine. It installs the asset agent (data, software,
                        storage, updates, remote terminal, screen sharing) pointed at the Odoo URL above;
                        an older .deb install is replaced.</p>
                    <field name="install_linux" widget="CopyClipboardText" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_agent_token" model="ir.actions.act_window">
        <field name="name">Agent Install</field>
        <field name="res_model">asset.fleet.enrollment.token</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- policy on the asset's Agent Telemetry page -->
    <record id="view_asset_form_telemetry_policy" model="ir.ui.view">
        <field name="name">asset.asset.form.telemetry.policy</field>
        <field name="model">asset.asset</field>
        <field name="inherit_id" ref="asset_telemetry.view_asset_form_telemetry"/>
        <field name="arch" type="xml">
            <field name="agent_telemetry_at" position="before">
                <field name="telemetry_policy_id" placeholder="Default policy"/>
            </field>
            <xpath expr="//page[@name='agent_telemetry']" position="inside">
                <separator string="Policy on this Machine"/>
                <field name="policy_enforcement" nolabel="1" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- ============================== Menus =============================== -->
    <menuitem id="menu_telemetry_policies" name="Telemetry Policies" parent="asset_workspace.menu_ws_telemetry"
              action="action_asset_agent_policy" sequence="40" groups="base.group_system"/>
    <menuitem id="menu_agent_install" name="Agent Install" parent="asset_workspace.menu_ws_telemetry"
              action="action_asset_agent_token" sequence="50" groups="base.group_system"/>
</odoo>
