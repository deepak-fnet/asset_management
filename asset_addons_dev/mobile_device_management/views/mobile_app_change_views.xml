<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_app_change_list" model="ir.ui.view">
        <field name="name">mobile.app.change.list</field>
        <field name="model">mobile.app.change</field>
        <field name="arch" type="xml">
            <list string="App Changes" decoration-danger="is_blocklisted"
                  decoration-success="change_type == 'installed'"
                  decoration-muted="change_type == 'removed'">
                <field name="detected_on"/>
                <field name="device_id"/>
                <field name="employee_id" optional="show"/>
                <field name="change_type" widget="badge"/>
                <field name="app_name"/>
                <field name="package_name"/>
                <field name="old_version" optional="show"/>
                <field name="new_version" optional="show"/>
                <field name="is_blocklisted"/>
                <field name="platform" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_app_change_search" model="ir.ui.view">
        <field name="name">mobile.app.change.search</field>
        <field name="model">mobile.app.change</field>
        <field name="arch" type="xml">
            <search>
                <field name="app_name"/>
                <field name="package_name"/>
                <field name="device_id"/>
                <filter name="f_installed" string="Installed" domain="[('change_type','=','installed')]"/>
                <filter name="f_removed" string="Removed" domain="[('change_type','=','removed')]"/>
                <filter name="f_updated" string="Updated" domain="[('change_type','=','updated')]"/>
                <separator/>
                <filter name="f_blocked" string="Blocklisted" domain="[('is_blocklisted','=',True)]"/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter name="g_type" string="Change Type" context="{'group_by':'change_type'}"/>-->
<!--                    <filter name="g_device" string="Device" context="{'group_by':'device_id'}"/>-->
<!--                    <filter name="g_day" string="Day" context="{'group_by':'detected_on:day'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <record id="action_mobile_app_change" model="ir.actions.act_window">
        <field name="name">Software Changes</field>
        <field name="res_model">mobile.app.change</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mobile_app_change_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No app changes detected yet</p>
            <p>Changes are detected by comparing each inventory report against the
               previous one, so the first report from a device establishes the
               baseline and produces no entries.</p>
        </field>
    </record>
</odoo>
