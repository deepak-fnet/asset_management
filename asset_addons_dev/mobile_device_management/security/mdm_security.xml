<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Odoo 19: groups attach to a res.groups.privilege, which carries
             the ir.module.category. category_id on res.groups is gone. -->
        <record id="module_category_mdm" model="ir.module.category">
            <field name="name">Mobile Device Management</field>
            <field name="description">Enrol and monitor phones and tablets.</field>
            <field name="sequence">15</field>
        </record>

        <record id="res_groups_privilege_mdm" model="res.groups.privilege">
            <field name="name">Mobile Device Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_mdm"/>
        </record>

        <record id="group_mdm_user" model="res.groups">
            <field name="name">MDM User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_mdm"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_mdm_manager" model="res.groups">
            <field name="name">MDM Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_mdm"/>
            <field name="implied_ids" eval="[(4, ref('group_mdm_user'))]"/>
        </record>

        <!-- A plain MDM User sees only devices assigned to them. Location and
             app inventory are personal data; the default should not be that
             every internal user can read the whole fleet's whereabouts. -->
        <record id="rule_mobile_device_own" model="ir.rule">
            <field name="name">Mobile devices: own only</field>
            <field name="model_id" ref="model_mobile_device"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mdm_user'))]"/>
        </record>

        <record id="rule_mobile_device_all" model="ir.rule">
            <field name="name">Mobile devices: managers see all</field>
            <field name="model_id" ref="model_mobile_device"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mdm_manager'))]"/>
        </record>

        <record id="rule_mobile_location_own" model="ir.rule">
            <field name="name">Locations: own only</field>
            <field name="model_id" ref="model_mobile_location"/>
            <field name="domain_force">[('device_id.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mdm_user'))]"/>
        </record>

        <record id="rule_mobile_location_all" model="ir.rule">
            <field name="name">Locations: managers see all</field>
            <field name="model_id" ref="model_mobile_location"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mdm_manager'))]"/>
        </record>
    </data>
</odoo>
