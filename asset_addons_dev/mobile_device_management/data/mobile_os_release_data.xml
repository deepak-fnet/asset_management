<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Seed OS release catalogue.

         This is the reference the server compares reported device versions
         against, because neither Android nor iOS lets an ordinary app ask
         "is there an update?".

         KEEP THIS UPDATED. When a new major version ships, add a row, set
         is_latest on it and unset it on the previous one. Untick is_supported
         when a version stops receiving security patches. Everything is
         editable under Mobile Devices > Configuration > OS Releases.

         noupdate="1" so your edits survive a module upgrade.
    -->
    <data noupdate="1">

        <record id="os_android_16" model="mobile.os.release">
            <field name="name">16</field>
            <field name="platform">android</field>
            <field name="sequence">160</field>
            <field name="released_on">2025-09-01</field>
            <field name="is_latest" eval="True"/>
            <field name="is_supported" eval="True"/>
        </record>

        <record id="os_android_15" model="mobile.os.release">
