<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Odoo 17 removed ir.cron.numbercall and doall. Do not add them. -->
        <record id="cron_refresh_update_state" model="ir.cron">
            <field name="name">MDM: Re-evaluate OS update state</field>
            <field name="model_id" ref="model_mobile_device"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_update_state()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_expire_enrolment_tokens" model="ir.cron">
            <field name="name">MDM: Expire enrolment tokens</field>
            <field name="model_id" ref="model_mobile_enrollment"/>
            <field name="state">code</field>
            <field name="code">model.cron_expire_tokens()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_purge_locations" model="ir.cron">
            <field name="name">MDM: Purge old location history</field>
            <field name="model_id" ref="model_mobile_location"/>
            <field name="state">code</field>
            <field name="code">model.cron_purge_old_locations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_purge_metrics" model="ir.cron">
            <field name="name">MDM: Purge old metric samples</field>
            <field name="model_id" ref="model_mobile_metric"/>
            <field name="state">code</field>
            <field name="code">model.cron_purge_old_metrics()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
