<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_setup_check_form" model="ir.ui.view">
        <field name="name">asset.security.setup.check.form</field>
        <field name="model">asset.security.setup.check</field>
        <field name="arch" type="xml">
            <form string="Setup &amp; Health Check">
                <div invisible="report_html" class="text-center" style="padding:30px;">
                    <h3>Security Setup &amp; Health Check</h3>
                    <p class="text-muted">
                        Checks every prerequisite for patch and vulnerability
                        management and reports exactly what is missing.
                    </p>
                    <button name="action_run_check" type="object"
                            string="Run Health Check" class="btn-primary btn-lg"/>
                </div>

                <div invisible="not report_html">
                    <field name="report_html" nolabel="1" readonly="1"/>
                </div>

                <footer>
                    <button name="action_run_check" type="object"
                            string="Re-run Check" class="btn-primary"
                            invisible="not report_html"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_setup_check" model="ir.actions.act_window">
        <field name="name">Setup &amp; Health Check</field>
        <field name="res_model">asset.security.setup.check</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
