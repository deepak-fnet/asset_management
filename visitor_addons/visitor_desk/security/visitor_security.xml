<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_visitor_desk" model="ir.module.category">
        <field name="name">Visitor Desk</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_visitor_desk" model="res.groups.privilege">
        <field name="name">Visitor Desk</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_visitor_desk"/>
    </record>

    <record id="group_visitor_security" model="res.groups">
        <field name="name">Security Guard</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_visitor_desk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_visitor_reception" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_visitor_desk"/>
        <field name="implied_ids" eval="[(4, ref('group_visitor_security'))]"/>
    </record>

    <record id="group_visitor_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_visitor_desk"/>
        <field name="implied_ids" eval="[(4, ref('group_visitor_reception'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="visitor_visit_company_rule" model="ir.rule">
        <field name="name">Visits: multi-company</field>
        <field name="model_id" ref="model_visitor_visit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
