<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_np" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.np.validation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Confirmed sales orders are frozen: no line added, edited or removed. -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">state in ['sale', 'cancel'] or locked</attribute>
            </xpath>
            <!--
                Selling beyond the stock on hand is allowed, but it is signalled
                here and on each line; the delivery is what actually blocks.
            -->
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="np_shortage_warning" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not np_shortage_warning">
                    <span class="fa fa-warning me-1"/>
                    <b>Not enough stock for this order.</b>
                    <field name="np_shortage_warning" nolabel="1" readonly="1"
                           class="mb-0"/>
                    <div class="text-muted">
                        The order can be confirmed, but the delivery cannot be
                        validated until the stock is available.
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_list_np" model="ir.ui.view">
        <field name="name">sale.order.line.list.inherit.np.validation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                   position="after">
                <field name="np_has_shortage" column_invisible="1"/>
                <field name="np_shortage_qty" string="Missing"
                       optional="show" decoration-danger="np_has_shortage"/>
            </xpath>
        </field>
    </record>
</odoo>
