<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- people see their own notifications; administrators see everything for tracking -->
    <record id="rule_notification_mine" model="ir.rule">
        <field name="name">Notifications: mine or sent by me</field>
        <field name="model_id" ref="model_smart_notification"/>
        <field name="domain_force">['|', ('line_ids.user_id', '=', user.id), ('sender_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_notification_line_mine" model="ir.rule">
        <field name="name">Notification recipients: mine or sent by me</field>
        <field name="model_id" ref="model_smart_notification_line"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('notification_id.sender_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_notification_all" model="ir.rule">
        <field name="name">Notifications: all (administrators)</field>
        <field name="model_id" ref="model_smart_notification"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_notification_line_all" model="ir.rule">
        <field name="name">Notification recipients: all (administrators)</field>
        <field name="model_id" ref="model_smart_notification_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
